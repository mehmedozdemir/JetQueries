<Application x:Class="JetQueries.Wpf.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- 1) UiKit colour tokens (ThemeManager swaps this one). 2) UiKit control styles. 3) JetQueries additions. -->
                <ResourceDictionary Source="pack://application:,,,/UiKit.Wpf;component/Themes/Dark.xaml" />
                <ResourceDictionary Source="pack://application:,,,/UiKit.Wpf;component/Themes/Controls.xaml" />
                <ResourceDictionary Source="pack://application:,,,/JetQueries;component/Styles/JetQueries.xaml" />
                <ResourceDictionary Source="pack://application:,,,/JetQueries;component/Assets/Logo.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
