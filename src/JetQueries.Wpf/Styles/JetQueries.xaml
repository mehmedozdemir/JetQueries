<!--
    JetQueries additions on top of UiKit. Only UiKit tokens are used (DESIGN.md §2): no colour is written here.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                    xmlns:c="clr-namespace:UiKit.Controls;assembly=UiKit.Wpf"
                    xmlns:v="clr-namespace:JetQueries.Wpf.Views"
                    xmlns:e="clr-namespace:JetQueries.Wpf.Editor">

    <FontFamily x:Key="Font.Code">Cascadia Mono, Consolas</FontFamily>
    <sys:Double x:Key="FontSize.Code">13</sys:Double>

    <!-- Where Run, Cancel and Save are (Settings): in each query tab by default. -->
    <Visibility x:Key="QueryButtons.Tab">Visible</Visibility>
    <Visibility x:Key="QueryButtons.Toolbar">Collapsed</Visibility>

    <!-- Tighter than UiKit's defaults: more room for data. -->
    <Thickness x:Key="Space.Page.Compact">8,6,8,0</Thickness>
    <Style x:Key="Toolbar.Compact" TargetType="Border" BasedOn="{StaticResource Toolbar}">
        <Setter Property="Padding" Value="10,5" />
    </Style>
    <Style x:Key="Btn.Toolbar.Compact" TargetType="ButtonBase" BasedOn="{StaticResource Btn.Toolbar}">
        <Setter Property="Height" Value="30" />
        <Setter Property="Padding" Value="8,0" />
    </Style>
    <!-- A small turning arrow while something loads (quieter than a progress bar in a tree row); turned by
         Views/Spinner, which stops when hidden or unloaded (a storyboard trigger keeps running on removed rows) -->
    <Style x:Key="Spinner" TargetType="TextBlock" BasedOn="{StaticResource Text.Icon}">
        <Setter Property="Text" Value="&#xE72C;" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
    </Style>

    <!-- Small labelled buttons of the result footer and toolbar: an icon and a short word -->
    <Style x:Key="Btn.Footer" TargetType="ButtonBase" BasedOn="{StaticResource Btn.Toolbar}">
        <Setter Property="Height" Value="26" />
        <Setter Property="Padding" Value="6,0" />
        <Setter Property="FontSize" Value="{DynamicResource FontSize.Small}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
    </Style>
    <!-- Minimize / maximize / close of a window that draws its own caption: square, flat, close turns red -->
    <Style x:Key="Btn.Caption" TargetType="Button" BasedOn="{StaticResource Btn.Icon}">
        <Setter Property="Width" Value="44" />
        <Setter Property="Height" Value="34" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="c:Ui.CornerRadius" Value="6" />
        <Setter Property="Focusable" Value="False" />
    </Style>
    <Style x:Key="Btn.Caption.Close" TargetType="Button" BasedOn="{StaticResource Btn.Caption}">
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#FFC42B1C" />
                <Setter Property="Foreground" Value="White" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Btn.Icon.Compact" TargetType="ButtonBase" BasedOn="{StaticResource Btn.Icon}">
        <Setter Property="Width" Value="30" />
        <Setter Property="Height" Value="30" />
    </Style>
    <Style TargetType="TabItem" BasedOn="{StaticResource {x:Type TabItem}}">
        <Setter Property="Padding" Value="10,6" />
    </Style>
    <Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
        <Setter Property="Padding" Value="2,2,8,2" />
    </Style>

    <!-- Windows of the application. -->
    <Style x:Key="Window.App" TargetType="Window">
        <Setter Property="Background" Value="{DynamicResource Brush.Window}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
        <Setter Property="FontFamily" Value="{DynamicResource Font.UI}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSize.Body}" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
    </Style>

    <!-- The SQL editor takes its colours from UiKit's syntax tokens. -->
    <Style TargetType="e:SqlEditor">
        <Setter Property="FontFamily" Value="{DynamicResource Font.Code}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSize.Code}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Syntax.Identifier}" />
        <Setter Property="KeywordBrush" Value="{DynamicResource Brush.Syntax.Keyword}" />
        <Setter Property="StringBrush" Value="{DynamicResource Brush.Syntax.String}" />
        <Setter Property="NumberBrush" Value="{DynamicResource Brush.Syntax.Number}" />
        <Setter Property="CommentBrush" Value="{DynamicResource Brush.Syntax.Comment}" />
        <Setter Property="FunctionBrush" Value="{DynamicResource Brush.Syntax.Function}" />
        <Setter Property="TypeBrush" Value="{DynamicResource Brush.Syntax.Type}" />
        <Setter Property="OperatorBrush" Value="{DynamicResource Brush.Syntax.Operator}" />
        <Setter Property="ParameterBrush" Value="{DynamicResource Brush.Syntax.Number}" />
        <Setter Property="ErrorBrush" Value="{DynamicResource Brush.Syntax.Error}" />
        <Setter Property="LineNumberBrush" Value="{DynamicResource Brush.TextMuted}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource Brush.Selection}" />
    </Style>

    <!-- Explorer and history rows: secondary text next to a name. -->
    <Style x:Key="Text.Badge" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource FontSize.Section}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="8,0,0,0" />
    </Style>

    <!-- Small close button on a document tab. -->
    <Style x:Key="Btn.TabClose" TargetType="Button" BasedOn="{StaticResource Btn.Icon}">
        <Setter Property="Width" Value="18" />
        <Setter Property="Height" Value="18" />
        <Setter Property="FontSize" Value="8" />
        <Setter Property="Margin" Value="8,0,-4,0" />
        <Setter Property="c:Ui.CornerRadius" Value="9" />
        <Setter Property="c:Ui.Icon" Value="&#xE711;" />
        <Setter Property="Focusable" Value="False" />
    </Style>

    <!-- A field row of a form: label on the left. -->
    <Style x:Key="Text.FieldLabel" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <!-- Password input, drawn like UiKit's TextBox (UiKit has no PasswordBox style). -->
    <Style TargetType="PasswordBox">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
        <Setter Property="Background" Value="{DynamicResource Brush.Input}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderStrong}" />
        <Setter Property="CaretBrush" Value="{DynamicResource Brush.Text}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource Brush.Accent}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="PasswordBox">
                    <Border x:Name="Root" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{StaticResource Radius.Control}">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" Focusable="False"
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                      HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource Brush.TextMuted}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Read-only text that can be selected and copied (messages, errors). -->
    <Style x:Key="TextBox.ReadOnly" TargetType="TextBox" BasedOn="{StaticResource TextBox.Bare}">
        <Setter Property="IsReadOnly" Value="True" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Padding" Value="0,1" />
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <!-- ========== Settings screen building blocks (UiKit tokens only) ========== -->

    <!-- A page in the settings list: icon + name; the selected one gets a soft accent and a bar on its left. -->
    <Style x:Key="Settings.NavItem" TargetType="ListBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
        <Setter Property="Margin" Value="0,0,0,2" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual.Rounded}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Grid>
                        <Border x:Name="Root" CornerRadius="{StaticResource Radius.Control}" Padding="12,9" Background="Transparent">
                            <ContentPresenter />
                        </Border>
                        <Border x:Name="Bar" Width="3" CornerRadius="1.5" Margin="0,10" HorizontalAlignment="Left"
                                Background="{DynamicResource Brush.Accent}" Visibility="Collapsed" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.Hover}" />
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.AccentSoft}" />
                            <Setter TargetName="Bar" Property="Visibility" Value="Visible" />
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- One choice of a few, side by side (keyword case, indentation…): a ListBox bound to SelectedItem. -->
    <Style x:Key="Segment" TargetType="ListBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual.Rounded}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Root" CornerRadius="4" Padding="12,4" MinWidth="40" Background="Transparent">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.Hover}" />
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.Accent}" />
                            <Setter Property="Foreground" Value="{DynamicResource Brush.AccentText}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Segmented" TargetType="ListBox">
        <Setter Property="ItemContainerStyle" Value="{StaticResource Segment}" />
        <Setter Property="DisplayMemberPath" Value="Text" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBox">
                    <Border Background="{DynamicResource Brush.Input}" BorderBrush="{DynamicResource Brush.BorderStrong}" BorderThickness="1"
                            CornerRadius="{StaticResource Radius.Control}" Padding="2" Height="32">
                        <ItemsPresenter />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- On / off for a yes-no setting: a CheckBox drawn as a switch. -->
    <Style x:Key="Switch" TargetType="CheckBox">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual.Rounded}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Border x:Name="Track" Width="40" Height="22" CornerRadius="11" BorderThickness="1"
                            Background="{DynamicResource Brush.Input}" BorderBrush="{DynamicResource Brush.BorderStrong}">
                        <Border x:Name="Thumb" Width="14" Height="14" CornerRadius="7" Margin="4,0" HorizontalAlignment="Left"
                                Background="{DynamicResource Brush.TextSecondary}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource Brush.Accent}" />
                            <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                            <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" />
                            <Setter TargetName="Thumb" Property="Background" Value="{DynamicResource Brush.AccentText}" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsChecked" Value="True" />
                                <Condition Property="IsMouseOver" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource Brush.AccentHover}" />
                        </MultiTrigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A large choice card (theme): icon over a name; the chosen one has an accent border and a check. -->
    <Style x:Key="ChoiceCard" TargetType="ListBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual.Rounded}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Margin" Value="0,0,12,0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Grid>
                        <Border x:Name="Root" Width="150" Height="88" CornerRadius="{StaticResource Radius.Card}" BorderThickness="1.5"
                                BorderBrush="{DynamicResource Brush.BorderStrong}" Background="{DynamicResource Brush.Input}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <Border x:Name="Check" Width="18" Height="18" CornerRadius="9" Background="{DynamicResource Brush.Accent}"
                                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,8,0" Visibility="Collapsed">
                            <TextBlock Text="&#xE73E;" Style="{StaticResource Text.Icon}" FontSize="10" HorizontalAlignment="Center"
                                       Foreground="{DynamicResource Brush.AccentText}" />
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource Brush.TextMuted}" />
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.AccentSoft}" />
                            <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A row of a settings card: name and one line about it on the left, the control on the right. -->
    <Style x:Key="Settings.Row" TargetType="Border">
        <Setter Property="Padding" Value="18,13" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
        <Setter Property="BorderThickness" Value="0,1,0,0" />
    </Style>

    <Style x:Key="Settings.RowTitle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="Settings.RowInfo" TargetType="TextBlock" BasedOn="{StaticResource Text.Caption}">
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0,3,0,0" />
    </Style>

    <Style x:Key="Settings.Group" TargetType="TextBlock" BasedOn="{StaticResource Text.Section}">
        <Setter Property="Margin" Value="2,0,0,8" />
    </Style>

    <!-- A database type to pick in the connection editor: a card that is a button. -->
    <Style x:Key="TypeCard" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual.Rounded}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Margin" Value="0,0,10,10" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root" CornerRadius="{StaticResource Radius.Card}" BorderThickness="1.5" Padding="14,12"
                            BorderBrush="{DynamicResource Brush.BorderStrong}" Background="{DynamicResource Brush.Input}">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.AccentSoft}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.Hover}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A section that opens and closes: a chevron and a label (the connection editor's "Advanced"). -->
    <Style x:Key="Disclosure" TargetType="ToggleButton">
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual.Rounded}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Root" Background="Transparent" CornerRadius="{StaticResource Radius.Control}" Padding="2,4,8,4">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="Chevron" Text="{x:Static c:Icons.ChevronRight}" Style="{StaticResource Text.Icon}" FontSize="10" Width="16"
                                       RenderTransformOrigin="0.5,0.5" Foreground="{TemplateBinding Foreground}">
                                <TextBlock.RenderTransform>
                                    <RotateTransform x:Name="Turn" Angle="0" />
                                </TextBlock.RenderTransform>
                            </TextBlock>
                            <ContentPresenter VerticalAlignment="Center" Margin="2,0,0,0" TextElement.FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Chevron" Property="RenderTransform">
                                <Setter.Value>
                                    <RotateTransform Angle="90" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.Hover}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Two or three views of one thing side by side: RadioButtons in a Segmented.Frame border. -->
    <Style x:Key="Segmented.Frame" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Brush.Input}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderStrong}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Control}" />
        <Setter Property="Padding" Value="2" />
        <Setter Property="Height" Value="32" />
    </Style>

    <Style x:Key="SegmentRadio" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual.Rounded}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Root" CornerRadius="4" Padding="12,4" MinWidth="40" Background="Transparent">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.Hover}" />
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.Accent}" />
                            <Setter Property="Foreground" Value="{DynamicResource Brush.AccentText}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
