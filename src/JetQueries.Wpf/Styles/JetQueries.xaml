<!--
    JetQueries additions on top of UiKit. Only UiKit tokens are used (DESIGN.md §2): no colour is written here.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="clr-namespace:UiKit.Controls;assembly=UiKit.Wpf"
                    xmlns:v="clr-namespace:JetQueries.Wpf.Views"
                    xmlns:e="clr-namespace:JetQueries.Wpf.Editor">

    <FontFamily x:Key="Font.Code">Cascadia Mono, Consolas</FontFamily>

    <!-- Windows of the application. -->
    <Style x:Key="Window.App" TargetType="Window">
        <Setter Property="Background" Value="{DynamicResource Brush.Window}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
        <Setter Property="FontFamily" Value="{StaticResource Font.UI}" />
        <Setter Property="FontSize" Value="{StaticResource FontSize.Body}" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
    </Style>

    <!-- The SQL editor takes its colours from UiKit's syntax tokens. -->
    <Style TargetType="e:SqlEditor">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Syntax.Identifier}" />
        <Setter Property="KeywordBrush" Value="{DynamicResource Brush.Syntax.Keyword}" />
        <Setter Property="StringBrush" Value="{DynamicResource Brush.Syntax.String}" />
        <Setter Property="NumberBrush" Value="{DynamicResource Brush.Syntax.Number}" />
        <Setter Property="CommentBrush" Value="{DynamicResource Brush.Syntax.Comment}" />
        <Setter Property="FunctionBrush" Value="{DynamicResource Brush.Syntax.Function}" />
        <Setter Property="TypeBrush" Value="{DynamicResource Brush.Syntax.Type}" />
        <Setter Property="OperatorBrush" Value="{DynamicResource Brush.Syntax.Operator}" />
        <Setter Property="ParameterBrush" Value="{DynamicResource Brush.Syntax.Number}" />
        <Setter Property="ErrorBrush" Value="{DynamicResource Brush.Syntax.Error}" />
        <Setter Property="LineNumberBrush" Value="{DynamicResource Brush.TextMuted}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource Brush.Selection}" />
    </Style>

    <!-- Explorer and history rows: secondary text next to a name. -->
    <Style x:Key="Text.Badge" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="8,0,0,0" />
    </Style>

    <!-- Small close button on a document tab. -->
    <Style x:Key="Btn.TabClose" TargetType="Button" BasedOn="{StaticResource Btn.Icon}">
        <Setter Property="Width" Value="18" />
        <Setter Property="Height" Value="18" />
        <Setter Property="FontSize" Value="8" />
        <Setter Property="Margin" Value="8,0,-4,0" />
        <Setter Property="c:Ui.CornerRadius" Value="9" />
        <Setter Property="c:Ui.Icon" Value="&#xE711;" />
        <Setter Property="Focusable" Value="False" />
    </Style>

    <!-- A field row of a form: label on the left. -->
    <Style x:Key="Text.FieldLabel" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <!-- Password input, drawn like UiKit's TextBox (UiKit has no PasswordBox style). -->
    <Style TargetType="PasswordBox">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
        <Setter Property="Background" Value="{DynamicResource Brush.Input}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderStrong}" />
        <Setter Property="CaretBrush" Value="{DynamicResource Brush.Text}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource Brush.Accent}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="PasswordBox">
                    <Border x:Name="Root" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{StaticResource Radius.Control}">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" Focusable="False"
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                      HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource Brush.TextMuted}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Read-only text that can be selected and copied (messages, errors). -->
    <Style x:Key="TextBox.ReadOnly" TargetType="TextBox" BasedOn="{StaticResource TextBox.Bare}">
        <Setter Property="IsReadOnly" Value="True" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Padding" Value="0,1" />
        <Setter Property="Background" Value="Transparent" />
    </Style>
</ResourceDictionary>
