<Window x:Class="JetQueries.Wpf.Views.ExecuteRoutineWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:UiKit.Controls;assembly=UiKit.Wpf"
        xmlns:res="clr-namespace:JetQueries.Presentation.Resources;assembly=JetQueries.Presentation"
        xmlns:e="clr-namespace:JetQueries.Wpf.Editor"
        xmlns:v="clr-namespace:JetQueries.Wpf.Views"
        Title="{x:Static res:Strings.ExecuteDialogTitle}" Width="820" Height="640" MinWidth="620" MinHeight="460"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        Style="{StaticResource Window.App}">
    <Window.Resources>
        <Style x:Key="Head" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
            <Setter Property="FontSize" Value="{DynamicResource FontSize.Small}" />
            <Setter Property="Margin" Value="0,0,10,6" />
        </Style>
        <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="Height" Value="30" />
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- Header: mark, routine, kind · connection · database -->
        <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1" Padding="20,14,20,12">
            <DockPanel>
                <v:ProviderMarkView Mark="{Binding Mark}" Size="30" Margin="0,0,12,0" VerticalAlignment="Center" />
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"
                            Visibility="{Binding HasOverloads, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{x:Static res:Strings.ExecuteOverload}" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <ComboBox x:Name="OverloadBox" ItemsSource="{Binding Overloads}" SelectedItem="{Binding SelectedOverload}" Width="260">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Converter={x:Static v:SignatureTextConverter.Instance}}" TextTrimming="CharacterEllipsis"
                                           FontFamily="{DynamicResource Font.Code}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Subtitle}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Text.Caption}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Footer: open the script, or run it -->
        <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0" Padding="20,10"
                Background="{DynamicResource Brush.SurfaceAlt}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="{x:Static res:Strings.ButtonCancel}" IsCancel="True" MinWidth="84" Margin="0,0,8,0" />
                <Button x:Name="OpenScriptButton" Content="{x:Static res:Strings.ExecuteOpenScript}" c:Ui.Icon="{x:Static c:Icons.Code}" MinWidth="110"
                        Margin="0,0,8,0" Click="OnOpenScript" />
                <Button x:Name="RunButton" Style="{StaticResource Btn.Primary}" Content="{x:Static res:Strings.ExecuteRun}" IsDefault="True" MinWidth="96"
                        Click="OnRun" />
            </StackPanel>
        </Border>

        <Grid Margin="20,14,20,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" MinHeight="120" />
            </Grid.RowDefinitions>

            <ProgressBar IsIndeterminate="True" Height="2" Margin="0,0,0,8"
                         Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}" />
            <TextBlock Text="{Binding Error}" Foreground="{DynamicResource Brush.Danger}" TextWrapping="Wrap" Margin="0,0,0,8"
                       Visibility="{Binding Error, Converter={x:Static v:NotNullToVisibilityConverter.Instance}}" />

            <!-- The parameters: name, type, direction, how it is passed, the value -->
            <DockPanel Grid.Row="1" Grid.IsSharedSizeScope="True">
                <Grid DockPanel.Dock="Top">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="Name" MinWidth="150" />
                        <ColumnDefinition Width="Auto" SharedSizeGroup="Type" MinWidth="120" />
                        <ColumnDefinition Width="Auto" SharedSizeGroup="Direction" MinWidth="60" />
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{x:Static res:Strings.ExecuteParamName}" Style="{StaticResource Head}" />
                    <TextBlock Grid.Column="1" Text="{x:Static res:Strings.ExecuteParamType}" Style="{StaticResource Head}" />
                    <TextBlock Grid.Column="2" Text="{x:Static res:Strings.ExecuteParamDirection}" Style="{StaticResource Head}" />
                    <TextBlock Grid.Column="3" Text="{x:Static res:Strings.ExecuteParamMode}" Style="{StaticResource Head}" />
                    <TextBlock Grid.Column="4" Text="{x:Static res:Strings.ExecuteParamValue}" Style="{StaticResource Head}" />
                </Grid>
                <TextBlock DockPanel.Dock="Bottom" Text="{x:Static res:Strings.ExecuteHint}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,6,0,0" />
                <Grid>
                    <TextBlock Text="{x:Static res:Strings.ExecuteNoParameters}" Foreground="{DynamicResource Brush.TextSecondary}" Margin="0,6,0,0"
                               Visibility="{Binding HasNoParameters, Converter={StaticResource BoolToVisibility}}" />
                    <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="280">
                        <ItemsControl x:Name="ParameterRows" ItemsSource="{Binding Parameters}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="Name" />
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="Type" />
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="Direction" />
                                            <ColumnDefinition Width="120" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Name}" FontFamily="{DynamicResource Font.Code}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                        <TextBlock Grid.Column="1" Text="{Binding DataType}" Foreground="{DynamicResource Brush.TextSecondary}" VerticalAlignment="Center"
                                                   Margin="0,0,10,0" />
                                        <Border Grid.Column="2" Style="{StaticResource Chip}" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0,0,10,0">
                                            <TextBlock Text="{Binding Direction}" FontSize="11" />
                                        </Border>
                                        <ComboBox Grid.Column="3" ItemsSource="{Binding Options}" SelectedItem="{Binding SelectedOption}" DisplayMemberPath="Text"
                                                  Margin="0,0,8,0" />
                                        <TextBox Grid.Column="4" Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" FontFamily="{DynamicResource Font.Code}"
                                                 IsEnabled="{Binding CanTakeValue}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </DockPanel>

            <TextBlock Grid.Row="2" Text="{x:Static res:Strings.ExecuteScript}" Style="{StaticResource Head}" Margin="0,12,0,6" />
            <Border Grid.Row="3" Style="{StaticResource Card.Surface}">
                <e:SqlEditor x:Name="ScriptView" IsReadOnly="True" Margin="2,4,2,2" LanguageService="{Binding LanguageService}" Text="{Binding Script, Mode=OneWay}" />
            </Border>
        </Grid>
    </DockPanel>
</Window>
