<UserControl x:Class="JetQueries.Wpf.Views.QueryDocumentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:UiKit.Controls;assembly=UiKit.Wpf"
             xmlns:res="clr-namespace:JetQueries.Presentation.Resources;assembly=JetQueries.Presentation"
             xmlns:vm="clr-namespace:JetQueries.Presentation.ViewModels;assembly=JetQueries.Presentation"
             xmlns:e="clr-namespace:JetQueries.Wpf.Editor"
             xmlns:v="clr-namespace:JetQueries.Wpf.Views">
    <!-- The whole query is framed in its connection's environment colour (development, test, production); an
         unmarked connection has no frame. The tab carries the same colour as a dot. -->
    <Border x:Name="EnvironmentFrame" BorderThickness="2" CornerRadius="12" Padding="6,4,6,6"
            BorderBrush="{Binding Environment, Converter={x:Static v:EnvironmentFrameConverter.Instance}}"
            ToolTip="{Binding EnvironmentFrameTip}" ToolTipService.InitialShowDelay="1200">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="60" />
            <RowDefinition Height="8" />
            <RowDefinition Height="*" MinHeight="60" />
        </Grid.RowDefinitions>

        <!-- Connection of this query and what the last run did -->
        <DockPanel Margin="0,0,0,6">

            <!-- Run, Cancel, Save as icons (Settings can move them to the main toolbar) -->
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Margin="0,0,8,0" Visibility="{DynamicResource QueryButtons.Tab}">
                <Button Style="{StaticResource Btn.Icon.Compact}" c:Ui.Icon="{x:Static c:Icons.Play}" Foreground="{DynamicResource Brush.Success}"
                        Command="{Binding RunCommand}" ToolTip="{x:Static res:Strings.QueryRunShortTip}" />
                <Button Style="{StaticResource Btn.Icon.Compact}" c:Ui.Icon="&#xE8A7;" Foreground="{DynamicResource Brush.Success}"
                        Command="{Binding RunInNewTabCommand}" ToolTip="{x:Static res:Strings.QueryRunInNewTabTip}" />
                <Button Style="{StaticResource Btn.Icon.Compact}" c:Ui.Icon="{x:Static c:Icons.Stop}"
                        Command="{Binding CancelCommand}" ToolTip="{x:Static res:Strings.QueryCancelShortTip}" />
                <Button Style="{StaticResource Btn.Icon.Compact}" c:Ui.Icon="{x:Static c:Icons.Save}"
                        Command="{Binding DataContext.SaveCommand, RelativeSource={RelativeSource AncestorType=v:DocumentsView}}"
                        ToolTip="{x:Static res:Strings.FileSaveShortTip}" />
                <Border Style="{StaticResource Separator.Vertical}" Margin="6,0" />
            </StackPanel>

            <!-- The window's current database (schema for Oracle), as SSMS shows it -->
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal"
                        Visibility="{Binding CanChangeDatabase, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{x:Static c:Icons.Database}" Style="{StaticResource Text.Icon}" FontSize="13" Margin="0,0,6,0"
                           Foreground="{DynamicResource Brush.Accent}" />
                <ComboBox x:Name="DatabaseBox" ItemsSource="{Binding Databases}" SelectedItem="{Binding SelectedDatabase}" MinWidth="140" MaxWidth="240" Height="28"
                          ToolTip="{x:Static res:Strings.QueryDatabase}" />
            </StackPanel>
            <!-- Auto-commit or manual commit; Commit / Rollback; a warning while a transaction is open -->
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Margin="8,0,0,0"
                        Visibility="{Binding SupportsTransactions, Converter={StaticResource BoolToVisibility}}">
                <Border Style="{StaticResource Separator.Vertical}" Margin="0,0,6,0" />
                <Button x:Name="TransactionMode" Command="{Binding ToggleAutoCommitCommand}" ToolTip="{x:Static res:Strings.TransactionModeTip}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource Btn.Toolbar.Compact}">
                            <Setter Property="c:Ui.Icon" Value="&#xE8FB;" />
                            <Setter Property="Content" Value="{Binding TransactionModeText}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding AutoCommit}" Value="False">
                                    <Setter Property="Foreground" Value="{DynamicResource Brush.Warning}" />
                                    <Setter Property="c:Ui.Icon" Value="&#xE72E;" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <StackPanel Orientation="Horizontal" Visibility="{Binding ShowTransactionButtons, Converter={StaticResource BoolToVisibility}}">
                    <!-- Named, not only coloured: commit and rollback must never be mistaken for each other -->
                    <!-- Neutral text; only the icons carry green and red, so the bar does not shout -->
                    <Button x:Name="CommitButton" Style="{StaticResource Btn.Toolbar.Compact}"
                            Command="{Binding CommitCommand}" ToolTip="{x:Static res:Strings.TransactionCommitTip}"
                            AutomationProperties.Name="{x:Static res:Strings.TransactionCommit}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{x:Static c:Icons.Check}" Style="{StaticResource Text.Icon}" Foreground="{DynamicResource Brush.Success}" Margin="0,0,8,0" />
                            <TextBlock Text="{x:Static res:Strings.TransactionCommit}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="RollbackButton" Style="{StaticResource Btn.Toolbar.Compact}"
                            Command="{Binding RollbackCommand}" ToolTip="{x:Static res:Strings.TransactionRollbackTip}"
                            AutomationProperties.Name="{x:Static res:Strings.TransactionRollback}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE7A7;" Style="{StaticResource Text.Icon}" Foreground="{DynamicResource Brush.Danger}" Margin="0,0,8,0" />
                            <TextBlock Text="{x:Static res:Strings.TransactionRollback}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                <Border Style="{StaticResource Badge}" Margin="6,0,0,0" Background="{DynamicResource Brush.Chip}" ToolTip="{x:Static res:Strings.TransactionOpenTip}"
                        Visibility="{Binding HasOpenTransaction, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{x:Static c:Icons.Warning}" Style="{StaticResource Text.Icon}" FontSize="11" Foreground="{DynamicResource Brush.Warning}" />
                        <TextBlock Text="{x:Static res:Strings.TransactionOpen}" FontSize="{DynamicResource FontSize.Small}" Margin="5,0,0,0"
                                   Foreground="{DynamicResource Brush.Warning}" />
                    </StackPanel>
                </Border>
            </StackPanel>
            <TextBlock DockPanel.Dock="Left" Text="{x:Static res:Strings.QueryNoConnection}" Style="{StaticResource Text.Caption}" VerticalAlignment="Center"
                       Visibility="{Binding SelectedSession, Converter={x:Static v:NullToVisibleConverter.Instance}}" />
            <ProgressBar DockPanel.Dock="Left" IsIndeterminate="{Binding IsRunning}" Width="80" Margin="12,0,0,0" VerticalAlignment="Center"
                         Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}" />
            <!-- The run's status is in the window's status bar -->
            <Grid />
        </DockPanel>

        <!-- Editor -->
        <Border Grid.Row="1" Style="{StaticResource Card.Surface}">
            <Grid>
                <e:SqlEditor x:Name="Editor" Margin="0,6,0,2" Text="{Binding Text}" LanguageService="{Binding LanguageService}"
                             BusyText="{Binding NavigationText}" IsBusy="{Binding IsNavigating}">
                    <e:SqlEditor.ContextMenu>
                        <ContextMenu x:Name="EditorMenu" Opened="OnEditorMenuOpened">
                            <MenuItem Header="{x:Static res:Strings.EditorRunStatement}" c:Ui.Icon="{x:Static c:Icons.Play}" InputGestureText="Ctrl+Enter" Click="OnMenuRun" Tag="Statement" />
                            <MenuItem Header="{x:Static res:Strings.EditorRun}" InputGestureText="F5" Click="OnMenuRun" Tag="Run" />
                            <MenuItem Header="{x:Static res:Strings.EditorRunInNewTab}" c:Ui.Icon="&#xE8A7;" InputGestureText="Ctrl+Shift+Enter" Click="OnMenuRun" Tag="NewTab" />
                            <Separator />
                            <MenuItem x:Name="CutItem" Header="{x:Static res:Strings.EditorCut}" c:Ui.Icon="&#xE8C6;" InputGestureText="Ctrl+X" Click="OnMenuEdit" Tag="Cut" />
                            <MenuItem x:Name="CopyItem" Header="{x:Static res:Strings.EditorCopy}" c:Ui.Icon="&#xE8C8;" InputGestureText="Ctrl+C" Click="OnMenuEdit" Tag="Copy" />
                            <MenuItem Header="{x:Static res:Strings.EditorPaste}" c:Ui.Icon="&#xE77F;" InputGestureText="Ctrl+V" Click="OnMenuEdit" Tag="Paste" />
                            <MenuItem Header="{x:Static res:Strings.EditorSelectAll}" InputGestureText="Ctrl+A" Click="OnMenuEdit" Tag="SelectAll" />
                            <Separator />
                            <MenuItem x:Name="SnippetItem" Header="{x:Static res:Strings.EditorInsertSnippet}" c:Ui.Icon="{x:Static c:Icons.Code}" />
                            <MenuItem Header="{x:Static res:Strings.EditorFormat}" c:Ui.Icon="&#xE8E4;" InputGestureText="Ctrl+Shift+F" Click="OnMenuEdit" Tag="Format" />
                            <MenuItem Header="{x:Static res:Strings.EditorToggleComment}" InputGestureText="Ctrl+/" Click="OnMenuEdit" Tag="Comment" />
                            <MenuItem Header="{x:Static res:Strings.EditorUpperCase}" InputGestureText="Ctrl+Shift+U" Click="OnMenuEdit" Tag="Upper" />
                            <MenuItem Header="{x:Static res:Strings.EditorLowerCase}" InputGestureText="Ctrl+U" Click="OnMenuEdit" Tag="Lower" />
                            <Separator />
                            <MenuItem Header="{x:Static res:Strings.EditorShowDetails}" c:Ui.Icon="{x:Static c:Icons.Info}" InputGestureText="Ctrl+Click, F12" Click="OnMenuEdit" Tag="Details" />
                            <MenuItem Header="{x:Static res:Strings.EditorGoToDefinition}" Click="OnMenuEdit" Tag="Definition" />
                            <MenuItem Header="{x:Static res:Strings.EditorCompletion}" InputGestureText="Ctrl+Space" Click="OnMenuEdit" Tag="Completion" />
                            <MenuItem Header="{x:Static res:Strings.EditorSignatureHelp}" InputGestureText="Ctrl+Shift+Space" Click="OnMenuEdit" Tag="Signature" />
                            <Separator />
                            <MenuItem x:Name="UndoItem" Header="{x:Static res:Strings.EditorUndo}" c:Ui.Icon="&#xE7A7;" InputGestureText="Ctrl+Z" Click="OnMenuEdit" Tag="Undo" />
                            <MenuItem x:Name="RedoItem" Header="{x:Static res:Strings.EditorRedo}" c:Ui.Icon="&#xE7A6;" InputGestureText="Ctrl+Y" Click="OnMenuEdit" Tag="Redo" />
                        </ContextMenu>
                    </e:SqlEditor.ContextMenu>
                </e:SqlEditor>
                <!-- Zoom of the text, shown only away from 100 %; a click goes back -->
                <Button x:Name="ZoomBadge" Style="{StaticResource Btn.Link}" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                        Visibility="{Binding Zoom, ElementName=Editor, Converter={x:Static v:ZoomBadgeVisibilityConverter.Instance}}"
                        Margin="0,0,18,6" Padding="6,2" FontSize="{DynamicResource FontSize.Caption}" ToolTip="{x:Static res:Strings.ZoomReset}"
                        Content="{Binding Zoom, ElementName=Editor, Converter={x:Static v:ZoomTextConverter.Instance}}" Click="OnZoomReset" />
            </Grid>
        </Border>

        <GridSplitter Grid.Row="2" Height="8" HorizontalAlignment="Stretch" ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" />

        <!-- Results -->
        <Border Grid.Row="3" Style="{StaticResource Card.Surface}">
            <Grid>
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                            Visibility="{Binding Tabs.Count, Converter={x:Static v:ZeroToVisibleConverter.Instance}}">
                    <Border Width="56" Height="56" CornerRadius="16" Background="{DynamicResource Brush.AccentSoft}" HorizontalAlignment="Center">
                        <TextBlock Text="{x:Static c:Icons.Table}" Style="{StaticResource Text.Icon}" FontSize="24" Foreground="{DynamicResource Brush.Accent}" />
                    </Border>
                    <TextBlock Text="{x:Static res:Strings.ResultsEmptyTitle}" Style="{StaticResource Text.Subtitle}" HorizontalAlignment="Center" Margin="0,14,0,6" />
                    <TextBlock Text="{x:Static res:Strings.ResultsEmptyMessage}" Foreground="{DynamicResource Brush.TextSecondary}" HorizontalAlignment="Center" />
                    <!-- The run shortcuts, where they matter -->
                    <ItemsControl x:Name="RunHints" HorizontalAlignment="Center" Margin="0,14,0,0" Focusable="False"
                                  ItemsSource="{x:Static v:RunHint.All}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="10,0">
                                    <Border Background="{DynamicResource Brush.Chip}" BorderBrush="{DynamicResource Brush.BorderStrong}" BorderThickness="1,1,1,2"
                                            CornerRadius="5" Padding="6,1" Margin="0,0,7,0">
                                        <TextBlock Text="{Binding Keys}" FontFamily="{DynamicResource Font.Code}" FontSize="{DynamicResource FontSize.Caption}" />
                                    </Border>
                                    <TextBlock Text="{Binding Text}" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- The shown result's view (grid / text / record) and its SQL filter, at the right of the tab row -->
                <StackPanel x:Name="ResultTools" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,5,10,0"
                            Panel.ZIndex="1" Visibility="{Binding SelectedTab, Converter={x:Static v:IsResultSetToVisibilityConverter.Instance}}">
                    <ToggleButton x:Name="SqlFilterToggle" Style="{StaticResource Btn.Footer}" c:Ui.Icon="{x:Static c:Icons.Filter}"
                                  Content="{x:Static res:Strings.SqlFilterToggle}" ToolTip="{x:Static res:Strings.SqlFilterToggleTip}"
                                  IsChecked="{Binding SelectedTab.IsSqlFilterOpen}" Margin="0,0,8,0" />
                    <Border Style="{StaticResource Segmented.Frame}">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="GridMode" Style="{StaticResource SegmentRadio}" ToolTip="{x:Static res:Strings.ViewGrid}"
                                         AutomationProperties.Name="{x:Static res:Strings.ViewGridShort}"
                                         IsChecked="{Binding SelectedTab.ViewMode, Converter={x:Static v:EnumEqualsConverter.Instance}, ConverterParameter={x:Static vm:ResultViewMode.Grid}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{x:Static c:Icons.Table}" Style="{StaticResource Text.Icon}" FontSize="12" Margin="0,0,6,0" />
                                    <TextBlock Text="{x:Static res:Strings.ViewGridShort}" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="TextMode" Style="{StaticResource SegmentRadio}" ToolTip="{x:Static res:Strings.ViewText}"
                                         AutomationProperties.Name="{x:Static res:Strings.ViewTextShort}"
                                         IsChecked="{Binding SelectedTab.ViewMode, Converter={x:Static v:EnumEqualsConverter.Instance}, ConverterParameter={x:Static vm:ResultViewMode.Text}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8D2;" Style="{StaticResource Text.Icon}" FontSize="12" Margin="0,0,6,0" />
                                    <TextBlock Text="{x:Static res:Strings.ViewTextShort}" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="RecordMode" Style="{StaticResource SegmentRadio}" ToolTip="{x:Static res:Strings.ViewRecord}"
                                         AutomationProperties.Name="{x:Static res:Strings.ViewRecordShort}"
                                         IsChecked="{Binding SelectedTab.ViewMode, Converter={x:Static v:EnumEqualsConverter.Instance}, ConverterParameter={x:Static vm:ResultViewMode.Record}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8A1;" Style="{StaticResource Text.Icon}" FontSize="12" Margin="0,0,6,0" />
                                    <TextBlock Text="{x:Static res:Strings.ViewRecordShort}" />
                                </StackPanel>
                            </RadioButton>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <TabControl ItemsSource="{Binding Tabs}" SelectedItem="{Binding SelectedTab}" Padding="0" Margin="6,0,6,0"
                            Visibility="{Binding Tabs.Count, Converter={x:Static v:ZeroToCollapsedConverter.Instance}}">
                    <TabControl.ItemContainerStyle>
                        <Style TargetType="TabItem" BasedOn="{StaticResource {x:Type TabItem}}">
                            <!-- Middle click closes a result, as for query tabs. -->
                            <EventSetter Event="PreviewMouseUp" Handler="OnResultTabMouseUp" />
                        </Style>
                    </TabControl.ItemContainerStyle>
                    <TabControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Title}" VerticalAlignment="Center" />
                                <Button x:Name="Close" Style="{StaticResource Btn.TabClose}" ToolTip="{x:Static res:Strings.ResultClose}"
                                        Command="{Binding DataContext.CloseResultCommand, RelativeSource={RelativeSource AncestorType=TabControl}}"
                                        CommandParameter="{Binding}" />
                            </StackPanel>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Converter={x:Static v:IsResultSetConverter.Instance}}" Value="False">
                                    <Setter TargetName="Close" Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </TabControl.ItemTemplate>
                    <TabControl.Resources>
                        <DataTemplate DataType="{x:Type vm:QueryResultSet}">
                            <v:ResultGridView Margin="-6,4,-6,0" />
                        </DataTemplate>
                        <DataTemplate DataType="{x:Type vm:QueryMessagesTab}">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,8,0,4">
                                <ItemsControl ItemsSource="{Binding Lines}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBox x:Name="Line" Style="{StaticResource TextBox.ReadOnly}" Text="{Binding Text, Mode=OneWay}"
                                                     FontFamily="{DynamicResource Font.Code}" FontSize="{DynamicResource FontSize.Small}" Foreground="{DynamicResource Brush.Text}" />
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsError}" Value="True">
                                                    <Setter TargetName="Line" Property="Foreground" Value="{DynamicResource Brush.Danger}" />
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </DataTemplate>
                    </TabControl.Resources>
                </TabControl>
            </Grid>
        </Border>
    </Grid>
    </Border>
</UserControl>
