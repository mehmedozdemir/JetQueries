<UserControl x:Class="JetQueries.Wpf.Views.QueryDocumentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:UiKit.Controls;assembly=UiKit.Wpf"
             xmlns:res="clr-namespace:JetQueries.Presentation.Resources;assembly=JetQueries.Presentation"
             xmlns:vm="clr-namespace:JetQueries.Presentation.ViewModels;assembly=JetQueries.Presentation"
             xmlns:e="clr-namespace:JetQueries.Wpf.Editor"
             xmlns:v="clr-namespace:JetQueries.Wpf.Views">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="80" />
            <RowDefinition Height="8" />
            <RowDefinition Height="*" MinHeight="80" />
        </Grid.RowDefinitions>

        <!-- Connection of this query and what the last run did -->
        <DockPanel Margin="0,0,0,6">
            <!-- The window's connection, then its current database (schema for Oracle), as SSMS shows it -->
            <ComboBox DockPanel.Dock="Left" ItemsSource="{Binding Sessions}" SelectedItem="{Binding SelectedSession}"
                      DisplayMemberPath="Name" MinWidth="170" MaxWidth="260" ToolTip="{x:Static res:Strings.QueryConnection}"
                      c:Ui.Placeholder="{x:Static res:Strings.QueryNoConnection}" />
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Margin="10,0,0,0"
                        Visibility="{Binding CanChangeDatabase, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{x:Static c:Icons.Database}" Style="{StaticResource Text.Icon}" FontSize="13" Margin="0,0,6,0"
                           Foreground="{DynamicResource Brush.Accent}" />
                <ComboBox x:Name="DatabaseBox" ItemsSource="{Binding Databases}" SelectedItem="{Binding SelectedDatabase}" MinWidth="200" MaxWidth="320"
                          ToolTip="{x:Static res:Strings.QueryDatabase}" />
            </StackPanel>
            <ProgressBar DockPanel.Dock="Left" IsIndeterminate="{Binding IsRunning}" Width="80" Margin="12,0,0,0" VerticalAlignment="Center"
                         Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}" />
            <TextBlock Text="{Binding Status}" Style="{StaticResource Text.Status}" HorizontalAlignment="Right" />
        </DockPanel>

        <!-- Editor -->
        <Border Grid.Row="1" Style="{StaticResource Card.Surface}">
            <Grid>
                <e:SqlEditor x:Name="Editor" Margin="0,6,0,2" Text="{Binding Text}" LanguageService="{Binding LanguageService}" />
                <!-- Zoom of the text; a click goes back to 100 % -->
                <Button x:Name="ZoomBadge" Style="{StaticResource Btn.Link}" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                        Margin="0,0,18,6" Padding="6,2" FontSize="{DynamicResource FontSize.Caption}" ToolTip="{x:Static res:Strings.ZoomReset}"
                        Content="{Binding Zoom, ElementName=Editor, Converter={x:Static v:ZoomTextConverter.Instance}}" Click="OnZoomReset" />
            </Grid>
        </Border>

        <GridSplitter Grid.Row="2" Height="8" HorizontalAlignment="Stretch" ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" />

        <!-- Results -->
        <Border Grid.Row="3" Style="{StaticResource Card.Surface}">
            <Grid>
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                            Visibility="{Binding Tabs.Count, Converter={x:Static v:ZeroToVisibleConverter.Instance}}">
                    <Border Width="56" Height="56" CornerRadius="16" Background="{DynamicResource Brush.AccentSoft}" HorizontalAlignment="Center">
                        <TextBlock Text="{x:Static c:Icons.Table}" Style="{StaticResource Text.Icon}" FontSize="24" Foreground="{DynamicResource Brush.Accent}" />
                    </Border>
                    <TextBlock Text="{x:Static res:Strings.ResultsEmptyTitle}" Style="{StaticResource Text.Subtitle}" HorizontalAlignment="Center" Margin="0,14,0,6" />
                    <TextBlock Text="{x:Static res:Strings.ResultsEmptyMessage}" Foreground="{DynamicResource Brush.TextSecondary}" HorizontalAlignment="Center" />
                </StackPanel>

                <TabControl ItemsSource="{Binding Tabs}" SelectedItem="{Binding SelectedTab}" Padding="0" Margin="6,0,6,0"
                            Visibility="{Binding Tabs.Count, Converter={x:Static v:ZeroToCollapsedConverter.Instance}}">
                    <TabControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Title}" />
                        </DataTemplate>
                    </TabControl.ItemTemplate>
                    <TabControl.Resources>
                        <DataTemplate DataType="{x:Type vm:QueryResultSet}">
                            <v:ResultGridView Margin="-6,4,-6,0" />
                        </DataTemplate>
                        <DataTemplate DataType="{x:Type vm:QueryMessagesTab}">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,8,0,4">
                                <ItemsControl ItemsSource="{Binding Lines}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBox x:Name="Line" Style="{StaticResource TextBox.ReadOnly}" Text="{Binding Text, Mode=OneWay}"
                                                     FontFamily="{DynamicResource Font.Code}" FontSize="{DynamicResource FontSize.Small}" Foreground="{DynamicResource Brush.Text}" />
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsError}" Value="True">
                                                    <Setter TargetName="Line" Property="Foreground" Value="{DynamicResource Brush.Danger}" />
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </DataTemplate>
                    </TabControl.Resources>
                </TabControl>
            </Grid>
        </Border>
    </Grid>
</UserControl>
