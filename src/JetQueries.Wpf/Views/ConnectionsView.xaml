<UserControl x:Class="JetQueries.Wpf.Views.ConnectionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:UiKit.Controls;assembly=UiKit.Wpf"
             xmlns:res="clr-namespace:JetQueries.Presentation.Resources;assembly=JetQueries.Presentation"
             xmlns:vm="clr-namespace:JetQueries.Presentation.ViewModels;assembly=JetQueries.Presentation"
             xmlns:v="clr-namespace:JetQueries.Wpf.Views">
    <DockPanel>
        <!-- Actions on the selected node -->
        <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1" Padding="6,4">
          <StackPanel>
            <!-- Icons only, wrapping when the panel is narrow: every action fits at any width -->
            <WrapPanel x:Name="Actions" Orientation="Horizontal">
                <Button Style="{StaticResource Btn.Icon}" Width="26" Height="26" c:Ui.Icon="{x:Static c:Icons.Add}"
                        Command="{Binding NewCommand}" ToolTip="{x:Static res:Strings.ConnectionNew}" />
                <Button Style="{StaticResource Btn.Icon}" Width="26" Height="26" c:Ui.Icon="{x:Static c:Icons.Edit}"
                        Command="{Binding EditCommand}" ToolTip="{x:Static res:Strings.ConnectionEdit}" />
                <Button Style="{StaticResource Btn.Icon}" Width="26" Height="26" c:Ui.Icon="{x:Static c:Icons.Delete}"
                        Command="{Binding DeleteCommand}" ToolTip="{x:Static res:Strings.ConnectionDelete}" />
                <Border Style="{StaticResource Separator.Vertical}" Height="16" Margin="4,0" />
                <Button x:Name="ToggleConnectionButton" Style="{StaticResource Btn.Icon}" Width="26" Height="26" c:Ui.Icon="{x:Static c:Icons.Plug}"
                        Command="{Binding ToggleConnectionCommand}" ToolTip="{Binding ToggleConnectionText}"
                        AutomationProperties.Name="{Binding ToggleConnectionText}" />
                <Button Style="{StaticResource Btn.Icon}" Width="26" Height="26" c:Ui.Icon="{x:Static c:Icons.Refresh}"
                        Command="{Binding ReloadSelectedCommand}" ToolTip="{x:Static res:Strings.ExplorerRefresh}" />
                <Button Style="{StaticResource Btn.Icon}" Width="26" Height="26" c:Ui.Icon="&#xE8B5;"
                        Command="{Binding ImportCommand}" ToolTip="{x:Static res:Strings.ImportTip}" />
                <Button Style="{StaticResource Btn.Icon}" Width="26" Height="26" c:Ui.Icon="{x:Static c:Icons.Search}"
                        Command="{Binding DataContext.GoToObjectCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        ToolTip="{x:Static res:Strings.GoToObjectTip}" />
            </WrapPanel>
            <!-- Filter by name over what is loaded (Esc clears) -->
            <c:SearchBox x:Name="Filter" Margin="0,4,0,2" Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged, Delay=200}"
                         c:Ui.Placeholder="{x:Static res:Strings.ExplorerFilter}"
                         Visibility="{Binding IsEmpty, Converter={x:Static v:InverseBoolToVisibilityConverter.Instance}}" />
          </StackPanel>
        </Border>

        <!-- Why a script could not be written -->
        <TextBlock DockPanel.Dock="Bottom" Text="{Binding ScriptError}" Foreground="{DynamicResource Brush.Danger}" TextWrapping="Wrap"
                   Margin="8,4" Visibility="{Binding ScriptError, Converter={x:Static v:NotNullToVisibilityConverter.Instance}}" />

        <Grid>
            <!-- Empty state -->
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="20"
                        Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
                <Border Width="56" Height="56" CornerRadius="16" Background="{DynamicResource Brush.AccentSoft}" HorizontalAlignment="Center">
                    <TextBlock Text="{x:Static c:Icons.Plug}" Style="{StaticResource Text.Icon}" FontSize="24" Foreground="{DynamicResource Brush.Accent}" />
                </Border>
                <TextBlock Text="{x:Static res:Strings.ConnectionsEmpty}" Foreground="{DynamicResource Brush.TextSecondary}"
                           TextWrapping="Wrap" TextAlignment="Center" Margin="0,14,0,14" MaxWidth="240" />
                <Button Style="{StaticResource Btn.Primary}" c:Ui.Icon="{x:Static c:Icons.Add}" Content="{x:Static res:Strings.ConnectionNew}"
                        Command="{Binding NewCommand}" HorizontalAlignment="Center" />
            </StackPanel>

            <TreeView x:Name="Tree" ItemsSource="{Binding Roots}" BorderThickness="0" Background="Transparent" Padding="4,6"
                      Visibility="{Binding IsEmpty, Converter={x:Static v:InverseBoolToVisibilityConverter.Instance}}"
                      SelectedItemChanged="OnSelectedItemChanged" MouseDoubleClick="OnTreeDoubleClick">
                <TreeView.InputBindings>
                    <KeyBinding Key="F4" Command="{Binding OpenDetailsCommand}" />
                </TreeView.InputBindings>
                <TreeView.ItemContainerStyle>
                    <Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
                        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                        <Setter Property="c:Ui.Icon" Value="{Binding Converter={x:Static v:ExplorerIconConverter.Instance}}" />
                        <Setter Property="Visibility" Value="{Binding IsVisible, Converter={StaticResource BoolToVisibility}}" />
                        <!-- The tree's view model, for the context menu (which is not in the visual tree). -->
                        <Setter Property="Tag" Value="{Binding DataContext, RelativeSource={RelativeSource AncestorType=TreeView}}" />
                        <EventSetter Event="PreviewMouseRightButtonDown" Handler="OnItemRightButtonDown" />
                        <!-- The menu's data context is the explorer (Tag); the node is its Selected (a right-click selects first).
                             Submenus inherit it, which RelativeSource bindings across popups would not reliably do. -->
                        <Setter Property="ContextMenu">
                            <Setter.Value>
                                <ContextMenu DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}">
                                    <MenuItem Header="{x:Static res:Strings.QueryNew}" c:Ui.Icon="{x:Static c:Icons.Add}"
                                              Command="{Binding NewQueryCommand}" CommandParameter="{Binding Selected}" />
                                    <MenuItem Header="{Binding ToggleConnectionText}" c:Ui.Icon="{x:Static c:Icons.Plug}" Command="{Binding ToggleConnectionCommand}" />
                                    <MenuItem Header="{x:Static res:Strings.ExplorerRefresh}" c:Ui.Icon="{x:Static c:Icons.Refresh}" Command="{Binding ReloadSelectedCommand}" />
                                    <!-- Tables and views: their data; anything with a definition: details and scripts -->
                                    <Separator Visibility="{Binding Selected.HasDefinition, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}" />
                                    <MenuItem Header="{x:Static res:Strings.ExplorerSelectRows}" c:Ui.Icon="{x:Static c:Icons.Table}"
                                              Command="{Binding SelectRowsCommand}" CommandParameter="{Binding Selected}"
                                              Visibility="{Binding Selected.HasData, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}" />
                                    <MenuItem Header="{x:Static res:Strings.ExplorerDetails}" c:Ui.Icon="{x:Static c:Icons.Info}" InputGestureText="F4"
                                              Command="{Binding OpenDetailsCommand}" CommandParameter="{Binding Selected}"
                                              Visibility="{Binding Selected.HasDefinition, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}" />
                                    <MenuItem Header="{x:Static res:Strings.ExplorerScript}" c:Ui.Icon="{x:Static c:Icons.Code}"
                                              Visibility="{Binding Selected.HasDefinition, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}">
                                        <MenuItem Header="{x:Static res:Strings.ExplorerScriptCreate}" Command="{Binding ScriptCreateCommand}" CommandParameter="{Binding Selected}" />
                                        <MenuItem Header="{x:Static res:Strings.ExplorerScriptAlter}" Command="{Binding ScriptAlterCommand}" CommandParameter="{Binding Selected}"
                                                  Visibility="{Binding Selected.CanAlter, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}" />
                                        <MenuItem Header="{x:Static res:Strings.ExplorerScriptDrop}" Command="{Binding ScriptDropCommand}" CommandParameter="{Binding Selected}" />
                                        <Separator Visibility="{Binding Selected.HasData, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}" />
                                        <MenuItem Header="{x:Static res:Strings.ExplorerScriptSelect}" Command="{Binding ScriptSelectCommand}" CommandParameter="{Binding Selected}"
                                                  Visibility="{Binding Selected.HasData, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}" />
                                        <MenuItem Header="{x:Static res:Strings.ExplorerScriptInsert}" Command="{Binding ScriptInsertCommand}" CommandParameter="{Binding Selected}"
                                                  Visibility="{Binding Selected.HasData, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}" />
                                        <MenuItem Header="{x:Static res:Strings.ExplorerScriptUpdate}" Command="{Binding ScriptUpdateCommand}" CommandParameter="{Binding Selected}"
                                                  Visibility="{Binding Selected.HasData, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}" />
                                        <MenuItem Header="{x:Static res:Strings.ExplorerScriptDelete}" Command="{Binding ScriptDeleteCommand}" CommandParameter="{Binding Selected}"
                                                  Visibility="{Binding Selected.HasData, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}" />
                                    </MenuItem>
                                </ContextMenu>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </TreeView.ItemContainerStyle>
                <TreeView.Resources>
                    <HierarchicalDataTemplate DataType="{x:Type vm:FolderNodeViewModel}" ItemsSource="{Binding Children}">
                        <TextBlock Text="{Binding Name}" Foreground="{DynamicResource Brush.TextSecondary}" FontWeight="SemiBold" />
                    </HierarchicalDataTemplate>
                    <HierarchicalDataTemplate DataType="{x:Type vm:ConnectionNodeViewModel}" ItemsSource="{Binding Children}">
                        <StackPanel Orientation="Horizontal" ToolTip="{Binding Error}" ToolTipService.IsEnabled="{Binding HasError}">
                            <v:ProviderMarkView Mark="{Binding Mark}" Size="16" Margin="0,0,7,0" VerticalAlignment="Center" />
                            <Ellipse Width="7" Height="7" Margin="0,0,7,0" VerticalAlignment="Center"
                                     Fill="{Binding Definition.Environment, Converter={x:Static v:EnvironmentBrushConverter.Instance}}" />
                            <TextBlock x:Name="Name" Text="{Binding Name}" VerticalAlignment="Center" />
                            <Border Style="{StaticResource Badge}" Background="{DynamicResource Brush.AccentSoft}" Margin="8,0,0,0" Padding="6,0"
                                    Visibility="{Binding IsConnected, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="{x:Static res:Strings.ConnectionConnectedBadge}" FontSize="10.5" Foreground="{DynamicResource Brush.Accent}" />
                            </Border>
                            <Border Style="{StaticResource Badge}" Margin="6,0,0,0" Padding="6,0"
                                    Visibility="{Binding IsReadOnly, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="{x:Static res:Strings.ConnectionReadOnlyBadge}" FontSize="10.5" Foreground="{DynamicResource Brush.TextSecondary}" />
                            </Border>
                            <ProgressBar IsIndeterminate="{Binding IsBusy}" Width="36" Margin="8,0,0,0" VerticalAlignment="Center"
                                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>
                        <HierarchicalDataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                <Setter TargetName="Name" Property="FontWeight" Value="SemiBold" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding HasError}" Value="True">
                                <Setter TargetName="Name" Property="Foreground" Value="{DynamicResource Brush.Danger}" />
                            </DataTrigger>
                        </HierarchicalDataTemplate.Triggers>
                    </HierarchicalDataTemplate>
                    <HierarchicalDataTemplate DataType="{x:Type vm:DatabaseObjectNodeViewModel}" ItemsSource="{Binding Children}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                            <ProgressBar IsIndeterminate="{Binding IsLoading}" Width="36" Margin="8,0,0,0" VerticalAlignment="Center"
                                         Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>
                    </HierarchicalDataTemplate>
                    <HierarchicalDataTemplate DataType="{x:Type vm:CategoryNodeViewModel}" ItemsSource="{Binding Children}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Name}" Foreground="{DynamicResource Brush.TextSecondary}" VerticalAlignment="Center" />
                            <ProgressBar IsIndeterminate="{Binding IsLoading}" Width="36" Margin="8,0,0,0" VerticalAlignment="Center"
                                         Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>
                    </HierarchicalDataTemplate>
                    <DataTemplate DataType="{x:Type vm:ColumnNodeViewModel}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding DataType}" Style="{StaticResource Text.Badge}" />
                            <TextBlock Text="{x:Static res:Strings.ColumnNullable}" Style="{StaticResource Text.Badge}"
                                       Visibility="{Binding IsNullable, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type vm:MessageNodeViewModel}">
                        <TextBlock x:Name="Text" Text="{Binding Name}" TextWrapping="Wrap" MaxWidth="420" Foreground="{DynamicResource Brush.TextMuted}" />
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsError}" Value="True">
                                <Setter TargetName="Text" Property="Foreground" Value="{DynamicResource Brush.Danger}" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </TreeView.Resources>
            </TreeView>
        </Grid>
    </DockPanel>
</UserControl>
