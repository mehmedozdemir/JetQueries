<UserControl x:Class="JetQueries.Wpf.Views.ConnectionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:UiKit.Controls;assembly=UiKit.Wpf"
             xmlns:res="clr-namespace:JetQueries.Presentation.Resources;assembly=JetQueries.Presentation"
             xmlns:vm="clr-namespace:JetQueries.Presentation.ViewModels;assembly=JetQueries.Presentation"
             xmlns:v="clr-namespace:JetQueries.Wpf.Views">
    <DockPanel>
        <!-- Actions on the selected node -->
        <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1" Padding="6,4">
          <StackPanel>
            <!-- The everyday actions as icons; the rest (folder, edit, delete, import) under "More" -->
            <WrapPanel x:Name="Actions" Orientation="Horizontal">
                <Button Style="{StaticResource Btn.Icon}" Width="26" Height="26" c:Ui.Icon="{x:Static c:Icons.Add}"
                        Command="{Binding NewCommand}" ToolTip="{x:Static res:Strings.ConnectionNew}" />
                <Button x:Name="ToggleConnectionButton" Style="{StaticResource Btn.Icon}" Width="26" Height="26" c:Ui.Icon="{x:Static c:Icons.Plug}"
                        Command="{Binding ToggleConnectionCommand}" ToolTip="{Binding ToggleConnectionText}"
                        AutomationProperties.Name="{Binding ToggleConnectionText}" />
                <Button Style="{StaticResource Btn.Icon}" Width="26" Height="26" c:Ui.Icon="{x:Static c:Icons.Refresh}"
                        Command="{Binding ReloadSelectedCommand}" ToolTip="{x:Static res:Strings.ExplorerRefresh}" />
                <Button Style="{StaticResource Btn.Icon}" Width="26" Height="26" c:Ui.Icon="{x:Static c:Icons.Search}"
                        Command="{Binding DataContext.GoToObjectCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        ToolTip="{x:Static res:Strings.GoToObjectTip}" />
                <Button x:Name="MoreActionsButton" Style="{StaticResource Btn.Icon}" Width="26" Height="26" c:Ui.Icon="&#xE712;"
                        ToolTip="{x:Static res:Strings.ExplorerMoreActions}" Click="OnMoreActionsClick">
                    <Button.ContextMenu>
                        <ContextMenu x:Name="MoreActionsMenu" DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                            <MenuItem x:Name="NewFolderButton" Header="{x:Static res:Strings.FolderNew}" c:Ui.Icon="&#xE8F4;"
                                      Command="{Binding NewFolderCommand}" CommandParameter="{Binding Selected}" />
                            <MenuItem Header="{x:Static res:Strings.ConnectionEditLong}" c:Ui.Icon="{x:Static c:Icons.Edit}" InputGestureText="F2"
                                      Command="{Binding EditCommand}" />
                            <MenuItem Header="{x:Static res:Strings.ConnectionDeleteLong}" c:Ui.Icon="{x:Static c:Icons.Delete}" InputGestureText="Del"
                                      Command="{Binding DeleteCommand}" />
                            <Separator />
                            <MenuItem Header="{x:Static res:Strings.ImportTip}" c:Ui.Icon="&#xE8B5;" Command="{Binding ImportCommand}" />
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
            </WrapPanel>
            <!-- Filter by name over what is loaded (Esc clears); expand, collapse, pin the panel -->
            <DockPanel Margin="0,4,0,2">
                <ToggleButton x:Name="PinButton" DockPanel.Dock="Right" Style="{StaticResource Btn.Icon}" Width="24" Height="24" Margin="2,0,0,0"
                              c:Ui.Icon="&#xE718;" IsChecked="True" ToolTip="{x:Static res:Strings.ExplorerUnpinTip}" />
                <Button x:Name="CollapseAllButton" DockPanel.Dock="Right" Style="{StaticResource Btn.Icon}" Width="24" Height="24" Margin="2,0,0,0"
                        c:Ui.Icon="&#xE70E;" Command="{Binding CollapseAllCommand}" ToolTip="{x:Static res:Strings.ExplorerCollapseAll}"
                        Visibility="{Binding IsEmpty, Converter={x:Static v:InverseBoolToVisibilityConverter.Instance}}" />
                <Button x:Name="ExpandAllButton" DockPanel.Dock="Right" Style="{StaticResource Btn.Icon}" Width="24" Height="24" Margin="4,0,0,0"
                        c:Ui.Icon="&#xE70D;" Command="{Binding ExpandAllCommand}" ToolTip="{x:Static res:Strings.ExplorerExpandAll}"
                        Visibility="{Binding IsEmpty, Converter={x:Static v:InverseBoolToVisibilityConverter.Instance}}" />
                <c:SearchBox x:Name="Filter" Height="26" FontSize="{DynamicResource FontSize.Small}"
                             Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged, Delay=200}"
                             c:Ui.Placeholder="{x:Static res:Strings.ExplorerFilter}"
                             Visibility="{Binding IsEmpty, Converter={x:Static v:InverseBoolToVisibilityConverter.Instance}}" />
            </DockPanel>
          </StackPanel>
        </Border>

        <!-- Why a script or details could not be read: at the top, where the eye is, until dismissed -->
        <Border x:Name="ScriptErrorBanner" DockPanel.Dock="Top" Margin="6,6,6,0" Padding="10,6,4,6" CornerRadius="{StaticResource Radius.Control}"
                Background="{DynamicResource Brush.SurfaceAlt}" BorderBrush="{DynamicResource Brush.Danger}" BorderThickness="3,0,0,0"
                Visibility="{Binding ScriptError, Converter={x:Static v:NotNullToVisibilityConverter.Instance}}">
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource Btn.Icon}" Width="22" Height="22" c:Ui.Icon="{x:Static c:Icons.Clear}"
                        VerticalAlignment="Top" Command="{Binding DismissScriptErrorCommand}" ToolTip="{x:Static res:Strings.Dismiss}" />
                <TextBlock Text="{x:Static c:Icons.Error}" Style="{StaticResource Text.Icon}" FontSize="13" Foreground="{DynamicResource Brush.Danger}"
                           VerticalAlignment="Top" Margin="0,2,8,0" />
                <TextBlock Text="{Binding ScriptError}" TextWrapping="Wrap" />
            </DockPanel>
        </Border>

        <Grid>
            <!-- While dragging: where the drop will land, beside the cursor -->
            <Popup x:Name="DragCaption" PlacementTarget="{Binding ElementName=Tree}" Placement="Relative" AllowsTransparency="True"
                   IsHitTestVisible="False" StaysOpen="True">
                <Border Background="{DynamicResource Brush.Card}" BorderBrush="{DynamicResource Brush.Accent}" BorderThickness="1" CornerRadius="6"
                        Padding="8,4" IsHitTestVisible="False">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8DE;" Style="{StaticResource Text.Icon}" FontSize="12" Foreground="{DynamicResource Brush.Accent}" Margin="0,0,6,0" />
                        <TextBlock x:Name="DragCaptionText" FontSize="{DynamicResource FontSize.Small}" />
                    </StackPanel>
                </Border>
            </Popup>

            <!-- Empty state -->
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="20"
                        Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
                <Border Width="56" Height="56" CornerRadius="16" Background="{DynamicResource Brush.AccentSoft}" HorizontalAlignment="Center">
                    <TextBlock Text="{x:Static c:Icons.Plug}" Style="{StaticResource Text.Icon}" FontSize="24" Foreground="{DynamicResource Brush.Accent}" />
                </Border>
                <TextBlock Text="{x:Static res:Strings.ConnectionsEmpty}" Foreground="{DynamicResource Brush.TextSecondary}"
                           TextWrapping="Wrap" TextAlignment="Center" Margin="0,14,0,14" MaxWidth="240" />
                <Button Style="{StaticResource Btn.Primary}" c:Ui.Icon="{x:Static c:Icons.Add}" Content="{x:Static res:Strings.ConnectionNew}"
                        Command="{Binding NewCommand}" HorizontalAlignment="Center" />
            </StackPanel>

            <TreeView x:Name="Tree" ItemsSource="{Binding Roots}" BorderThickness="0" Background="Transparent" Padding="4,6"
                      Visibility="{Binding IsEmpty, Converter={x:Static v:InverseBoolToVisibilityConverter.Instance}}"
                      SelectedItemChanged="OnSelectedItemChanged" MouseDoubleClick="OnTreeDoubleClick"
                      AllowDrop="True" DragOver="OnTreeDragOver" Drop="OnTreeDrop" DragLeave="OnTreeDragLeave"
                      PreviewMouseLeftButtonDown="OnTreeMouseDown" PreviewMouseMove="OnTreeMouseMove">
                <TreeView.InputBindings>
                    <KeyBinding Key="F4" Command="{Binding OpenDetailsCommand}" />
                    <KeyBinding Key="Delete" Command="{Binding DeleteSelectedCommand}" />
                    <KeyBinding Key="F2" Command="{Binding EditSelectedCommand}" />
                </TreeView.InputBindings>
                <TreeView.ItemContainerStyle>
                    <Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
                        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                        <Setter Property="c:Ui.Icon" Value="{Binding Converter={x:Static v:ExplorerIconConverter.Instance}}" />
                        <Setter Property="Visibility" Value="{Binding IsVisible, Converter={StaticResource BoolToVisibility}}" />
                        <!-- The tree's view model, for the context menu (which is not in the visual tree). -->
                        <Setter Property="Tag" Value="{Binding DataContext, RelativeSource={RelativeSource AncestorType=TreeView}}" />
                        <EventSetter Event="PreviewMouseRightButtonDown" Handler="OnItemRightButtonDown" />
                        <!-- The menu's data context is the explorer (Tag); the node is its Selected (a right-click selects first).
                             Submenus inherit it, which RelativeSource bindings across popups would not reliably do. -->
                        <Setter Property="ContextMenu">
                            <Setter.Value>
                                <ContextMenu DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}">
                                    <!-- Folders: a subfolder, rename, delete (what is inside moves up) -->
                                    <MenuItem Header="{x:Static res:Strings.FolderNew}" c:Ui.Icon="&#xE8F4;" Command="{Binding NewFolderCommand}" CommandParameter="{Binding Selected}"
                                              Visibility="{Binding Selected, Converter={x:Static v:IsFolderOrConnectionToVisibilityConverter.Instance}}" />
                                    <MenuItem Header="{x:Static res:Strings.FolderRename}" c:Ui.Icon="{x:Static c:Icons.Edit}" Command="{Binding RenameFolderCommand}" CommandParameter="{Binding Selected}" InputGestureText="F2"
                                              Visibility="{Binding Selected, Converter={x:Static v:IsFolderToVisibilityConverter.Instance}}" />
                                    <MenuItem Header="{x:Static res:Strings.FolderDelete}" c:Ui.Icon="{x:Static c:Icons.Delete}" Command="{Binding DeleteFolderCommand}" CommandParameter="{Binding Selected}" InputGestureText="Del"
                                              Visibility="{Binding Selected, Converter={x:Static v:IsFolderToVisibilityConverter.Instance}}" />
                                    <!-- Connections: edit and delete (F2, Del) -->
                                    <MenuItem Header="{x:Static res:Strings.ConnectionEditLong}" c:Ui.Icon="{x:Static c:Icons.Edit}" InputGestureText="F2"
                                              Command="{Binding EditCommand}" Visibility="{Binding Selected, Converter={x:Static v:IsConnectionToVisibilityConverter.Instance}}" />
                                    <MenuItem Header="{x:Static res:Strings.ConnectionDeleteLong}" c:Ui.Icon="{x:Static c:Icons.Delete}" InputGestureText="Del"
                                              Command="{Binding DeleteCommand}" Visibility="{Binding Selected, Converter={x:Static v:IsConnectionToVisibilityConverter.Instance}}" />
                                    <Separator Visibility="{Binding Selected, Converter={x:Static v:IsFolderOrConnectionToVisibilityConverter.Instance}}" />
                                    <!-- Key-value databases: open a key, filter a database's keys -->
                                    <MenuItem Header="{x:Static res:Strings.KeyOpen}" c:Ui.Icon="&#xE8A7;" InputGestureText="Enter" Command="{Binding OpenKeyCommand}" CommandParameter="{Binding Selected}"
                                              Visibility="{Binding Selected, Converter={x:Static v:NodeTypeToVisibilityConverter.Instance}, ConverterParameter=Key}" />
                                    <MenuItem Header="{x:Static res:Strings.KeyFilter}" c:Ui.Icon="&#xE71C;" Command="{Binding FilterKeysCommand}" CommandParameter="{Binding Selected}"
                                              Visibility="{Binding Selected, Converter={x:Static v:NodeTypeToVisibilityConverter.Instance}, ConverterParameter=KeySpace}" />
                                    <MenuItem Header="{x:Static res:Strings.QueryNew}" c:Ui.Icon="{x:Static c:Icons.Add}"
                                              Command="{Binding NewQueryCommand}" CommandParameter="{Binding Selected}" />
                                    <!-- DBA: the server at a glance, its sessions and blocking, its queries and indexes -->
                                    <MenuItem x:Name="DbaMenuItem" Header="{x:Static res:Strings.MenuDba}" c:Ui.Icon="&#xE9D9;"
                                              Visibility="{Binding Selected.HasDbaTools, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}">
                                        <MenuItem x:Name="DashboardMenuItem" Header="{x:Static res:Strings.DashOpen}" c:Ui.Icon="&#xE9D2;"
                                                  Command="{Binding OpenDashboardCommand}" CommandParameter="{Binding Selected}"
                                                  Visibility="{Binding Selected.CanDashboard, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}" />
                                        <MenuItem x:Name="ActivityMenuItem" Header="{x:Static res:Strings.ActivityOpen}" c:Ui.Icon="&#xE9D9;"
                                                  Command="{Binding OpenActivityCommand}" CommandParameter="{Binding Selected}"
                                                  Visibility="{Binding Selected.CanMonitor, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}" />
                                        <MenuItem x:Name="PerformanceMenuItem" Header="{x:Static res:Strings.PerfOpen}" c:Ui.Icon="&#xE9F9;"
                                                  Command="{Binding OpenPerformanceCommand}" CommandParameter="{Binding Selected}"
                                                  Visibility="{Binding Selected.CanAnalyze, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}" />
                                        <MenuItem x:Name="DatabaseDetailMenuItem" Header="{x:Static res:Strings.DbDetailOpen}" c:Ui.Icon="{x:Static c:Icons.Database}"
                                                  Command="{Binding OpenDatabaseDetailCommand}" CommandParameter="{Binding Selected}"
                                                  Visibility="{Binding Selected.CanDetail, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}" />
                                        <MenuItem x:Name="HealthMenuItem" Header="{x:Static res:Strings.HealthOpen}" c:Ui.Icon="&#xE95E;"
                                                  Command="{Binding OpenHealthCommand}" CommandParameter="{Binding Selected}"
                                                  Visibility="{Binding Selected.CanHealthCheck, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}" />
                                    </MenuItem>
                                    <MenuItem Header="{Binding ToggleConnectionText}" c:Ui.Icon="{x:Static c:Icons.Plug}" Command="{Binding ToggleConnectionCommand}" />
                                    <MenuItem Header="{x:Static res:Strings.ExplorerRefresh}" c:Ui.Icon="{x:Static c:Icons.Refresh}" Command="{Binding ReloadSelectedCommand}" />
                                    <!-- Tables and views: their data; anything with a definition: details and scripts -->
                                    <Separator Visibility="{Binding Selected.HasDefinition, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}" />
                                    <MenuItem Header="{x:Static res:Strings.ExplorerSelectRows}" c:Ui.Icon="{x:Static c:Icons.Table}"
                                              Command="{Binding SelectRowsCommand}" CommandParameter="{Binding Selected}"
                                              Visibility="{Binding Selected.HasData, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}" />
                                    <MenuItem Header="{x:Static res:Strings.ExplorerAddFavorite}" c:Ui.Icon="&#xE734;"
                                              Command="{Binding ToggleFavoriteCommand}" CommandParameter="{Binding Selected}">
                                        <MenuItem.Visibility>
                                            <MultiBinding Converter="{x:Static v:AllTrueToVisibilityConverter.Instance}">
                                                <Binding Path="Selected.CanBeFavorite" FallbackValue="False" />
                                                <Binding Path="Selected.IsFavorite" Converter="{x:Static v:NotConverter.Instance}" FallbackValue="False" />
                                            </MultiBinding>
                                        </MenuItem.Visibility>
                                    </MenuItem>
                                    <MenuItem Header="{x:Static res:Strings.ExplorerRemoveFavorite}" c:Ui.Icon="&#xE735;"
                                              Command="{Binding ToggleFavoriteCommand}" CommandParameter="{Binding Selected}"
                                              Visibility="{Binding Selected.IsFavorite, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}" />
                                    <MenuItem Header="{x:Static res:Strings.ExplorerImportData}" c:Ui.Icon="&#xE8B5;"
                                              Command="{Binding ImportDataCommand}" CommandParameter="{Binding Selected}"
                                              Visibility="{Binding Selected.CanImportData, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}" />
                                    <MenuItem Header="{x:Static res:Strings.ExplorerExecute}" c:Ui.Icon="{x:Static c:Icons.Play}"
                                              Command="{Binding ExecuteRoutineCommand}" CommandParameter="{Binding Selected}"
                                              Visibility="{Binding Selected.CanExecuteRoutine, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}" />
                                    <MenuItem Header="{x:Static res:Strings.ExplorerDetails}" c:Ui.Icon="{x:Static c:Icons.Info}" InputGestureText="F4"
                                              Command="{Binding OpenDetailsCommand}" CommandParameter="{Binding Selected}"
                                              Visibility="{Binding Selected.HasDefinition, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}" />
                                    <MenuItem Header="{x:Static res:Strings.ExplorerScript}" c:Ui.Icon="{x:Static c:Icons.Code}"
                                              Visibility="{Binding Selected.HasDefinition, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}">
                                        <MenuItem Header="{x:Static res:Strings.ExplorerScriptCreate}" Command="{Binding ScriptCreateCommand}" CommandParameter="{Binding Selected}" />
                                        <MenuItem Header="{x:Static res:Strings.ExplorerScriptAlter}" Command="{Binding ScriptAlterCommand}" CommandParameter="{Binding Selected}"
                                                  Visibility="{Binding Selected.CanAlter, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}" />
                                        <MenuItem Header="{x:Static res:Strings.ExplorerScriptDrop}" Command="{Binding ScriptDropCommand}" CommandParameter="{Binding Selected}" />
                                        <Separator Visibility="{Binding Selected.HasData, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}" />
                                        <MenuItem Header="{x:Static res:Strings.ExplorerScriptSelect}" Command="{Binding ScriptSelectCommand}" CommandParameter="{Binding Selected}"
                                                  Visibility="{Binding Selected.HasData, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}" />
                                        <MenuItem Header="{x:Static res:Strings.ExplorerScriptInsert}" Command="{Binding ScriptInsertCommand}" CommandParameter="{Binding Selected}"
                                                  Visibility="{Binding Selected.HasData, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}" />
                                        <MenuItem Header="{x:Static res:Strings.ExplorerScriptUpdate}" Command="{Binding ScriptUpdateCommand}" CommandParameter="{Binding Selected}"
                                                  Visibility="{Binding Selected.HasData, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}" />
                                        <MenuItem Header="{x:Static res:Strings.ExplorerScriptDelete}" Command="{Binding ScriptDeleteCommand}" CommandParameter="{Binding Selected}"
                                                  Visibility="{Binding Selected.HasData, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}" />
                                    </MenuItem>
                                </ContextMenu>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <!-- Picked with Ctrl+click -->
                            <DataTrigger Binding="{Binding IsMarked}" Value="True">
                                <Setter Property="Background" Value="{DynamicResource Brush.Selection}" />
                            </DataTrigger>
                            <!-- Where a dragged connection or folder would land -->
                            <DataTrigger Binding="{Binding IsDropTarget}" Value="True">
                                <Setter Property="Background" Value="{DynamicResource Brush.AccentSoft}" />
                                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TreeView.ItemContainerStyle>
                <TreeView.Resources>
                    <HierarchicalDataTemplate DataType="{x:Type vm:FolderNodeViewModel}" ItemsSource="{Binding Children}">
                        <TextBlock Text="{Binding Name}" Foreground="{DynamicResource Brush.TextSecondary}" FontWeight="SemiBold" />
                    </HierarchicalDataTemplate>
                    <HierarchicalDataTemplate DataType="{x:Type vm:ConnectionNodeViewModel}" ItemsSource="{Binding Children}">
                        <StackPanel Orientation="Horizontal" ToolTip="{Binding Error}" ToolTipService.IsEnabled="{Binding HasError}">
                            <v:ProviderMarkView Mark="{Binding Mark}" Size="16" Margin="0,0,7,0" VerticalAlignment="Center" />
                            <Ellipse Width="7" Height="7" Margin="0,0,7,0" VerticalAlignment="Center"
                                     Fill="{Binding Definition.Environment, Converter={x:Static v:EnvironmentBrushConverter.Instance}}" />
                            <TextBlock x:Name="Name" Text="{Binding Name}" VerticalAlignment="Center" />
                            <Border Style="{StaticResource Badge}" Margin="6,0,0,0" Padding="6,0"
                                    Visibility="{Binding IsReadOnly, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="{x:Static res:Strings.ConnectionReadOnlyBadge}" FontSize="10.5" Foreground="{DynamicResource Brush.TextSecondary}" />
                            </Border>
                            <v:Spinner Style="{StaticResource Spinner}" Margin="8,0,0,0"
                                       Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>
                        <HierarchicalDataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                <Setter TargetName="Name" Property="FontWeight" Value="SemiBold" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding HasError}" Value="True">
                                <Setter TargetName="Name" Property="Foreground" Value="{DynamicResource Brush.Danger}" />
                            </DataTrigger>
                        </HierarchicalDataTemplate.Triggers>
                    </HierarchicalDataTemplate>
                    <HierarchicalDataTemplate DataType="{x:Type vm:DatabaseObjectNodeViewModel}" ItemsSource="{Binding Children}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                            <TextBlock Text="&#xE735;" Style="{StaticResource Text.Icon}" FontSize="10" Margin="6,0,0,0" Foreground="{DynamicResource Brush.Warning}"
                                       Visibility="{Binding IsFavorite, Converter={StaticResource BoolToVisibility}}" />
                            <v:Spinner Style="{StaticResource Spinner}" Margin="8,0,0,0"
                                       Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>
                    </HierarchicalDataTemplate>
                    <HierarchicalDataTemplate DataType="{x:Type vm:FavoritesNodeViewModel}" ItemsSource="{Binding Children}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Name}" Foreground="{DynamicResource Brush.TextSecondary}" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding LoadedCount, StringFormat=' ({0})'}" Foreground="{DynamicResource Brush.TextMuted}" VerticalAlignment="Center" />
                        </StackPanel>
                    </HierarchicalDataTemplate>
                    <HierarchicalDataTemplate DataType="{x:Type vm:CategoryNodeViewModel}" ItemsSource="{Binding Children}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Name}" Foreground="{DynamicResource Brush.TextSecondary}" VerticalAlignment="Center" />
                            <!-- How many, once loaded: "Tables (128)" -->
                            <TextBlock Text="{Binding LoadedCount, StringFormat=' ({0})'}" Foreground="{DynamicResource Brush.TextMuted}" VerticalAlignment="Center" />
                            <v:Spinner Style="{StaticResource Spinner}" Margin="8,0,0,0"
                                       Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>
                    </HierarchicalDataTemplate>
                    <HierarchicalDataTemplate DataType="{x:Type vm:KeySpaceNodeViewModel}" ItemsSource="{Binding Children}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                            <v:Spinner Style="{StaticResource Spinner}" Margin="8,0,0,0"
                                       Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>
                    </HierarchicalDataTemplate>
                    <HierarchicalDataTemplate DataType="{x:Type vm:KeyFolderNodeViewModel}" ItemsSource="{Binding Children}">
                        <TextBlock Text="{Binding Name}" Foreground="{DynamicResource Brush.TextSecondary}" VerticalAlignment="Center" />
                    </HierarchicalDataTemplate>
                    <DataTemplate DataType="{x:Type vm:KeyNodeViewModel}">
                        <TextBlock Text="{Binding Name}" ToolTip="{Binding Key}" FontFamily="{DynamicResource Font.Code}" FontSize="{DynamicResource FontSize.Small}"
                                   VerticalAlignment="Center" />
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type vm:ColumnNodeViewModel}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding DataType}" Style="{StaticResource Text.Badge}" />
                            <TextBlock Text="{x:Static res:Strings.ColumnNullable}" Style="{StaticResource Text.Badge}"
                                       Visibility="{Binding IsNullable, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type vm:MessageNodeViewModel}">
                        <TextBlock x:Name="Text" Text="{Binding Name}" TextWrapping="Wrap" MaxWidth="420" Foreground="{DynamicResource Brush.TextMuted}" />
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsError}" Value="True">
                                <Setter TargetName="Text" Property="Foreground" Value="{DynamicResource Brush.Danger}" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </TreeView.Resources>
            </TreeView>
        </Grid>
    </DockPanel>
</UserControl>
