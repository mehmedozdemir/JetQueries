<UserControl x:Class="JetQueries.Wpf.Views.DocumentsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:UiKit.Controls;assembly=UiKit.Wpf"
             xmlns:res="clr-namespace:JetQueries.Presentation.Resources;assembly=JetQueries.Presentation"
             xmlns:v="clr-namespace:JetQueries.Wpf.Views"
             x:Name="Root">
    <UserControl.CommandBindings>
        <CommandBinding Command="{x:Static v:DocumentsView.CopyPathCommand}" Executed="OnCopyPath" CanExecute="OnCanCopyPath" />
    </UserControl.CommandBindings>
    <Grid>
        <!-- Empty state: every tab closed -->
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="{Binding Tabs.Count, Converter={x:Static v:ZeroToVisibleConverter.Instance}}">
            <Border Width="64" Height="64" CornerRadius="18" Background="{DynamicResource Brush.AccentSoft}" HorizontalAlignment="Center">
                <TextBlock Text="{x:Static c:Icons.Code}" Style="{StaticResource Text.Icon}" FontSize="26" Foreground="{DynamicResource Brush.Accent}" />
            </Border>
            <TextBlock Text="{x:Static res:Strings.DocumentsEmptyTitle}" Style="{StaticResource Text.Subtitle}" HorizontalAlignment="Center" Margin="0,14,0,6" />
            <TextBlock Text="{x:Static res:Strings.DocumentsEmptyMessage}" Foreground="{DynamicResource Brush.TextSecondary}" HorizontalAlignment="Center" />
            <Button Style="{StaticResource Btn.Primary}" c:Ui.Icon="{x:Static c:Icons.Add}" Content="{x:Static res:Strings.QueryNew}"
                    Command="{Binding NewQueryCommand}" HorizontalAlignment="Center" Margin="0,16,0,0" />
            <TextBlock Text="Ctrl+N" Style="{StaticResource Text.Caption}" HorizontalAlignment="Center" Margin="0,8,0,0" />
        </StackPanel>

        <!-- Query tabs and object details tabs, side by side -->
        <TabControl x:Name="Tabs" ItemsSource="{Binding Tabs}" SelectedItem="{Binding SelectedTab}"
                    Visibility="{Binding Tabs.Count, Converter={x:Static v:ZeroToCollapsedConverter.Instance}}">
            <TabControl.ContentTemplateSelector>
                <v:DocumentTemplateSelector>
                    <v:DocumentTemplateSelector.Query>
                        <DataTemplate>
                            <v:QueryDocumentView Margin="0,6,0,0" />
                        </DataTemplate>
                    </v:DocumentTemplateSelector.Query>
                    <v:DocumentTemplateSelector.Details>
                        <DataTemplate>
                            <v:ObjectDetailsView Margin="0,6,0,0" />
                        </DataTemplate>
                    </v:DocumentTemplateSelector.Details>
                    <v:DocumentTemplateSelector.Key>
                        <DataTemplate>
                            <v:KeyValueView Margin="0,6,0,0" />
                        </DataTemplate>
                    </v:DocumentTemplateSelector.Key>
                    <v:DocumentTemplateSelector.Activity>
                        <DataTemplate>
                            <v:ActivityMonitorView Margin="0,6,0,0" />
                        </DataTemplate>
                    </v:DocumentTemplateSelector.Activity>
                    <v:DocumentTemplateSelector.Performance>
                        <DataTemplate>
                            <v:PerformanceView Margin="0,6,0,0" />
                        </DataTemplate>
                    </v:DocumentTemplateSelector.Performance>
                </v:DocumentTemplateSelector>
            </TabControl.ContentTemplateSelector>
            <TabControl.ItemContainerStyle>
                <Style TargetType="TabItem" BasedOn="{StaticResource {x:Type TabItem}}">
                    <Setter Property="c:Ui.Icon" Value="{Binding Converter={x:Static v:DocumentIconConverter.Instance}}" />
                    <!-- Middle click closes a tab, as in browsers and Visual Studio. -->
                    <EventSetter Event="PreviewMouseUp" Handler="OnTabMouseUp" />
                    <Setter Property="Tag" Value="{Binding DataContext, RelativeSource={RelativeSource AncestorType=TabControl}}" />
                    <Setter Property="ContextMenu">
                        <Setter.Value>
                            <ContextMenu>
                                <MenuItem Header="{x:Static res:Strings.TabClose}" c:Ui.Icon="&#xE711;"
                                          Command="{Binding PlacementTarget.Tag.CloseTabCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}" />
                                <MenuItem Header="{x:Static res:Strings.TabCloseOthers}"
                                          Command="{Binding PlacementTarget.Tag.CloseOtherTabsCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}" />
                                <MenuItem Header="{x:Static res:Strings.TabCloseAll}"
                                          Command="{Binding PlacementTarget.Tag.CloseAllTabsCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                <Separator />
                                <MenuItem Header="{x:Static res:Strings.TabCopyPath}" c:Ui.Icon="&#xE8C8;" Command="{x:Static v:DocumentsView.CopyPathCommand}" CommandParameter="{Binding}" />
                            </ContextMenu>
                        </Setter.Value>
                    </Setter>
                </Style>
            </TabControl.ItemContainerStyle>
            <TabControl.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal" ToolTip="{Binding ToolTip}">
                        <!-- The connection's environment colour: which server this tab runs on -->
                        <Ellipse x:Name="EnvironmentDot" Width="7" Height="7" Margin="0,0,7,0" VerticalAlignment="Center"
                                 Fill="{Binding Environment, Converter={x:Static v:EnvironmentBrushConverter.Instance}}"
                                 Visibility="{Binding Environment, Converter={x:Static v:NotNullToVisibilityConverter.Instance}}" />
                        <TextBlock Text="{Binding HeaderText}" VerticalAlignment="Center" />
                        <Button Style="{StaticResource Btn.TabClose}" ToolTip="{x:Static res:Strings.QueryClose}"
                                Command="{Binding DataContext.CloseTabCommand, RelativeSource={RelativeSource AncestorType=TabControl}}" CommandParameter="{Binding}" />
                    </StackPanel>
                </DataTemplate>
            </TabControl.ItemTemplate>
        </TabControl>

        <!-- New query at the end of the tab row (the main toolbar no longer repeats the menu's commands) -->
        <Button Style="{StaticResource Btn.Icon.Compact}" c:Ui.Icon="{x:Static c:Icons.Add}" Command="{Binding NewQueryCommand}"
                ToolTip="{x:Static res:Strings.QueryNewTip}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,2,2,0"
                Visibility="{Binding Tabs.Count, Converter={x:Static v:ZeroToCollapsedConverter.Instance}}" />
    </Grid>
</UserControl>
