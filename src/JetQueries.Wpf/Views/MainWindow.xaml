<Window x:Class="JetQueries.Wpf.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:UiKit.Controls;assembly=UiKit.Wpf"
        xmlns:res="clr-namespace:JetQueries.Presentation.Resources;assembly=JetQueries.Presentation"
        xmlns:v="clr-namespace:JetQueries.Wpf.Views"
        Title="JetQueries" Icon="pack://application:,,,/JetQueries;component/Assets/JetQueries.ico" Width="1360" Height="840" MinWidth="820" MinHeight="480"
        WindowStartupLocation="CenterScreen" AllowDrop="True" Drop="OnDrop" DragOver="OnDragOver"
        Style="{StaticResource Window.App}">
    <Window.InputBindings>
        <KeyBinding Gesture="Ctrl+N" Command="{Binding Documents.NewQueryCommand}" />
        <KeyBinding Gesture="Ctrl+O" Command="{Binding Documents.OpenFileCommand}" />
        <KeyBinding Gesture="Ctrl+S" Command="{Binding Documents.SaveCommand}" />
        <KeyBinding Gesture="Ctrl+Shift+S" Command="{Binding Documents.SaveAsCommand}" />
        <KeyBinding Gesture="Ctrl+Shift+N" Command="{Binding GoToObjectCommand}" />
        <KeyBinding Gesture="Ctrl+Shift+H" Command="{Binding ShowHistoryCommand}" />
        <KeyBinding Gesture="Ctrl+Shift+Q" Command="{Binding ShowSavedQueriesCommand}" />
        <KeyBinding Gesture="Ctrl+Shift+K" Command="{Binding SavedQueries.SaveCurrentCommand}" />
        <KeyBinding Key="F1" Command="{Binding ShowShortcutsCommand}" />
        <KeyBinding Gesture="Ctrl+Shift+P" Command="{x:Static ApplicationCommands.Find}" />
    </Window.InputBindings>

    <Window.CommandBindings>
        <CommandBinding Command="{x:Static ApplicationCommands.Find}" Executed="OnCommandPalette" />
    </Window.CommandBindings>

    <!-- One title bar: the menu and toolbar row is the window's caption (no second, Windows-drawn bar above it) -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="0,0,0,1" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ================= Toolbar ================= -->
        <Border Style="{StaticResource Toolbar.Compact}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- The mark (Assets/Logo.xaml), the same drawing as the exe's icon -->
                    <Image x:Name="Logo" Source="{StaticResource Brand.Logo}" Width="28" Height="28" Margin="0,0,7,0"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Text="JetQueries" FontSize="{DynamicResource FontSize.Subtitle}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0" />

                    <!-- Main menu -->
                    <Menu x:Name="MainMenu" VerticalAlignment="Center" Margin="0,0,6,0" WindowChrome.IsHitTestVisibleInChrome="True">
                        <MenuItem Header="{x:Static res:Strings.MenuFile}">
                            <MenuItem Header="{x:Static res:Strings.QueryNew}" c:Ui.Icon="{x:Static c:Icons.Add}" InputGestureText="Ctrl+N" Command="{Binding Documents.NewQueryCommand}" />
                            <MenuItem Header="{x:Static res:Strings.FileOpen}" c:Ui.Icon="{x:Static c:Icons.OpenFile}" InputGestureText="Ctrl+O" Command="{Binding Documents.OpenFileCommand}" />
                            <MenuItem Header="{x:Static res:Strings.FileSave}" c:Ui.Icon="{x:Static c:Icons.Save}" InputGestureText="Ctrl+S" Command="{Binding Documents.SaveCommand}" />
                            <MenuItem Header="{x:Static res:Strings.MenuSaveAs}" InputGestureText="Ctrl+Shift+S" Command="{Binding Documents.SaveAsCommand}" />
                            <Separator />
                            <MenuItem Header="{x:Static res:Strings.MenuExit}" InputGestureText="Alt+F4" Click="OnExit" />
                        </MenuItem>
                        <MenuItem Header="{x:Static res:Strings.MenuConnection}">
                            <MenuItem Header="{x:Static res:Strings.ConnectionNewLong}" c:Ui.Icon="{x:Static c:Icons.Plug}" Command="{Binding Connections.NewCommand}" />
                            <MenuItem Header="{x:Static res:Strings.ConnectionEditLong}" c:Ui.Icon="{x:Static c:Icons.Edit}" InputGestureText="F2" Command="{Binding Connections.EditCommand}" />
                            <MenuItem Header="{x:Static res:Strings.ConnectionDeleteLong}" c:Ui.Icon="{x:Static c:Icons.Delete}" InputGestureText="Del" Command="{Binding Connections.DeleteCommand}" />
                            <MenuItem Header="{x:Static res:Strings.FolderNew}" c:Ui.Icon="&#xE8F4;" Command="{Binding Connections.NewFolderCommand}" CommandParameter="{Binding Connections.Selected}" />
                            <Separator />
                            <MenuItem Header="{x:Static res:Strings.MenuImportConnections}" c:Ui.Icon="&#xE8B5;" Command="{Binding Connections.ImportCommand}" />
                            <Separator />
                            <MenuItem Header="{Binding Connections.ToggleConnectionText}" Command="{Binding Connections.ToggleConnectionCommand}" />
                            <MenuItem Header="{x:Static res:Strings.ExplorerRefresh}" c:Ui.Icon="{x:Static c:Icons.Refresh}" Command="{Binding Connections.ReloadSelectedCommand}" />
                            <Separator />
                            <MenuItem Header="{x:Static res:Strings.MenuGoToObject}" c:Ui.Icon="{x:Static c:Icons.Search}" InputGestureText="Ctrl+Shift+N" Command="{Binding GoToObjectCommand}" />
                        </MenuItem>
                        <MenuItem Header="{x:Static res:Strings.MenuQuery}">
                            <MenuItem Header="{x:Static res:Strings.QueryRun}" c:Ui.Icon="{x:Static c:Icons.Play}" InputGestureText="F5" Command="{Binding Documents.Selected.RunCommand}" />
                            <MenuItem Header="{x:Static res:Strings.QueryRunInNewTab}" c:Ui.Icon="&#xE8A7;" InputGestureText="Ctrl+Shift+Enter" Command="{Binding Documents.Selected.RunInNewTabCommand}" />
                            <MenuItem Header="{x:Static res:Strings.QueryCancel}" c:Ui.Icon="{x:Static c:Icons.Stop}" InputGestureText="Esc" Command="{Binding Documents.Selected.CancelCommand}" />
                            <Separator />
                            <MenuItem Header="{x:Static res:Strings.ExportMenu}" c:Ui.Icon="&#xEDE1;" Command="{Binding Documents.Selected.ExportCommand}" />
                            <Separator />
                            <MenuItem Header="{x:Static res:Strings.MenuSaveToLibrary}" c:Ui.Icon="&#xE734;" InputGestureText="Ctrl+Shift+K" Command="{Binding SavedQueries.SaveCurrentCommand}" />
                            <MenuItem Header="{x:Static res:Strings.MenuSaveToLibraryAsNew}" Command="{Binding SavedQueries.SaveCurrentAsNewCommand}" />
                            <MenuItem Header="{x:Static res:Strings.MenuSavedQueries}" c:Ui.Icon="&#xE8F1;" InputGestureText="Ctrl+Shift+Q" Command="{Binding ShowSavedQueriesCommand}" />
                        </MenuItem>
                        <MenuItem Header="{x:Static res:Strings.MenuView}">
                            <MenuItem x:Name="ExplorerMenuItem" Header="{x:Static res:Strings.MenuExplorer}" IsCheckable="True" IsChecked="True" Click="OnToggleExplorer" />
                            <MenuItem Header="{x:Static res:Strings.MenuTheme}" IsCheckable="True" IsChecked="{Binding IsDark, Mode=OneWay}" Command="{Binding ToggleThemeCommand}" />
                            <MenuItem Header="{x:Static res:Strings.MenuCompactMode}" IsCheckable="True" IsChecked="{Binding IsCompact, Mode=OneWay}" Command="{Binding ToggleCompactCommand}" />
                        </MenuItem>
                        <MenuItem Header="{x:Static res:Strings.MenuTools}">
                            <MenuItem Header="{x:Static res:Strings.MenuHistory}" c:Ui.Icon="{x:Static c:Icons.History}" InputGestureText="Ctrl+Shift+H" Command="{Binding ShowHistoryCommand}" />
                            <MenuItem Header="{x:Static res:Strings.MenuSavedQueries}" c:Ui.Icon="&#xE734;" InputGestureText="Ctrl+Shift+Q" Command="{Binding ShowSavedQueriesCommand}" />
                            <MenuItem Header="{x:Static res:Strings.MenuCommandPalette}" c:Ui.Icon="&#xE721;" InputGestureText="Ctrl+Shift+P" Click="OnCommandPaletteClick" />
                            <MenuItem Header="{x:Static res:Strings.MenuShortcuts}" c:Ui.Icon="&#xE765;" InputGestureText="F1" Command="{Binding ShowShortcutsCommand}" />
                            <MenuItem Header="{x:Static res:Strings.MenuCheckUpdates}" c:Ui.Icon="&#xE896;" Command="{Binding Updates.CheckCommand}" />
                            <Separator />
                            <MenuItem Header="{x:Static res:Strings.MenuSettings}" c:Ui.Icon="{x:Static c:Icons.Settings}" Command="{Binding OpenSettingsCommand}" />
                        </MenuItem>
                    </Menu>

                    <!-- Icons only: the menu has the same commands with their names. Run buttons are here when the settings say so;
                         otherwise each query tab has them -->
                    <StackPanel Orientation="Horizontal" Visibility="{DynamicResource QueryButtons.Toolbar}" WindowChrome.IsHitTestVisibleInChrome="True">
                        <Border Style="{StaticResource Separator.Vertical}" />
                        <Button Style="{StaticResource Btn.Icon.Compact}" c:Ui.Icon="{x:Static c:Icons.Save}"
                                Command="{Binding Documents.SaveCommand}" ToolTip="{x:Static res:Strings.FileSaveTip}" />
                        <Border Style="{StaticResource Separator.Vertical}" />
                        <Button Style="{StaticResource Btn.Icon.Compact}" c:Ui.Icon="{x:Static c:Icons.Play}"
                                Command="{Binding Documents.Selected.RunCommand}" ToolTip="{x:Static res:Strings.QueryRunTip}" />
                        <Button Style="{StaticResource Btn.Icon.Compact}" c:Ui.Icon="&#xE8A7;"
                                Command="{Binding Documents.Selected.RunInNewTabCommand}" ToolTip="{x:Static res:Strings.QueryRunInNewTabTip}" />
                        <Button Style="{StaticResource Btn.Icon.Compact}" c:Ui.Icon="{x:Static c:Icons.Stop}"
                                Command="{Binding Documents.Selected.CancelCommand}" ToolTip="{x:Static res:Strings.QueryCancelTip}" />
                    </StackPanel>
                </StackPanel>

                <!-- The window's own caption buttons (the menu row is the title bar) -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="10,0,0,0" WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button x:Name="MinimizeButton" Style="{StaticResource Btn.Caption}" c:Ui.Icon="&#xE921;" Click="OnMinimize"
                            ToolTip="{x:Static res:Strings.WindowMinimize}" />
                    <Button x:Name="MaximizeButton" Style="{StaticResource Btn.Caption}" c:Ui.Icon="&#xE922;" Click="OnMaximize"
                            ToolTip="{x:Static res:Strings.WindowMaximize}" />
                    <Button x:Name="CloseButton" Style="{StaticResource Btn.Caption.Close}" c:Ui.Icon="&#xE8BB;" Click="OnCloseWindow"
                            ToolTip="{x:Static res:Strings.WindowClose}" />
                </StackPanel>
                <Button x:Name="ThemeButton" DockPanel.Dock="Right" Style="{StaticResource Btn.Icon.Compact}" WindowChrome.IsHitTestVisibleInChrome="True"
                        Command="{Binding ToggleThemeCommand}" ToolTip="{x:Static res:Strings.ToggleTheme}" Margin="4,0,0,0" />
                <Button DockPanel.Dock="Right" Style="{StaticResource Btn.Icon.Compact}" c:Ui.Icon="{x:Static c:Icons.Settings}" Command="{Binding OpenSettingsCommand}"
                        ToolTip="{x:Static res:Strings.SettingsTip}" WindowChrome.IsHitTestVisibleInChrome="True" />
                <!-- Empty caption: drag to move, double-click to maximize -->
                <Grid />
            </DockPanel>
        </Border>

        <!-- ================= Body ================= -->
        <Grid Grid.Row="1" Margin="{DynamicResource Space.Page.Compact}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="ExplorerColumn" Width="280" MinWidth="200" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" MinWidth="320" />
            </Grid.ColumnDefinitions>

            <!-- Explorer (the history has its own window: Tools, Query history) -->
            <Border x:Name="ExplorerPanel" Style="{StaticResource Card.Surface}">
                <v:ConnectionsView DataContext="{Binding Connections}" />
            </Border>

            <GridSplitter x:Name="ExplorerSplitter" Grid.Column="1" Width="8" DragCompleted="OnExplorerResized" HorizontalAlignment="Stretch" ResizeBehavior="PreviousAndNext" />

            <!-- Query tabs -->
            <v:DocumentsView Grid.Column="2" DataContext="{Binding Documents}" />
        </Grid>

        <!-- ================= Status bar ================= -->
        <DockPanel Grid.Row="2" Height="26" Margin="10,0">
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                <TextBlock Text="{Binding Documents.Selected.Status}" Style="{StaticResource Text.Status}" Foreground="{DynamicResource Brush.Text}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <!-- An update found, downloading or ready: what to do next -->
                <Border Style="{StaticResource Chip}" Margin="0,0,16,0" Padding="8,0,4,0" Height="22"
                        Visibility="{Binding Updates.ShowsInStatusBar, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE896;" Style="{StaticResource Text.Icon}" FontSize="12" Foreground="{DynamicResource Brush.Accent}" Margin="0,0,6,0" />
                        <TextBlock Text="{Binding Updates.Status}" Style="{StaticResource Text.Status}" Foreground="{DynamicResource Brush.Text}" />
                        <Button Style="{StaticResource Btn.Link}" Content="{x:Static res:Strings.UpdateDownload}" Command="{Binding Updates.DownloadCommand}"
                                Visibility="{Binding Updates.CanDownload, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}" />
                        <Button Style="{StaticResource Btn.Link}" Content="{x:Static res:Strings.UpdateRestart}" Command="{Binding Updates.RestartCommand}"
                                Visibility="{Binding Updates.CanRestart, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}" />
                    </StackPanel>
                </Border>
                <TextBlock Text="{Binding Documents.Selected.SelectedSession.Name}" Style="{StaticResource Text.Status}" Margin="0,0,16,0" />
                <TextBlock Text="{Binding ExtensionStatus}" Style="{StaticResource Text.Status}" Foreground="{DynamicResource Brush.TextMuted}" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
