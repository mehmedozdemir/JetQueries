<UserControl x:Class="JetQueries.Wpf.Views.ObjectDetailsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:UiKit.Controls;assembly=UiKit.Wpf"
             xmlns:res="clr-namespace:JetQueries.Presentation.Resources;assembly=JetQueries.Presentation"
             xmlns:e="clr-namespace:JetQueries.Wpf.Editor"
             xmlns:v="clr-namespace:JetQueries.Wpf.Views">
    <UserControl.InputBindings>
        <KeyBinding Key="F5" Command="{Binding LoadCommand}" />
    </UserControl.InputBindings>

    <DockPanel>
        <!-- Header: mark, name, kind · connection · database, actions -->
        <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1" Padding="10,8,4,10">
            <DockPanel>
                <v:ProviderMarkView Mark="{Binding Mark}" Size="30" Margin="0,0,12,0" VerticalAlignment="Center" />
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource Btn.Toolbar.Compact}" c:Ui.Icon="{x:Static c:Icons.Table}" Content="{x:Static res:Strings.DetailsOpenData}"
                            Command="{Binding SelectRowsCommand}" Visibility="{Binding HasData, Converter={StaticResource BoolToVisibility}}" />
                    <Button Style="{StaticResource Btn.Toolbar.Compact}" c:Ui.Icon="{x:Static c:Icons.Play}" Content="{x:Static res:Strings.DetailsExecute}"
                            Command="{Binding ExecuteRoutineCommand}" Visibility="{Binding CanExecuteRoutine, Converter={StaticResource BoolToVisibility}}" />
                    <Button Style="{StaticResource Btn.Toolbar.Compact}" c:Ui.Icon="{x:Static c:Icons.Code}" Content="{x:Static res:Strings.DetailsOpenDdl}"
                            Command="{Binding OpenDdlInEditorCommand}" />
                    <Button Style="{StaticResource Btn.Icon.Compact}" c:Ui.Icon="{x:Static c:Icons.Refresh}" Command="{Binding LoadCommand}"
                            ToolTip="{x:Static res:Strings.DetailsRefresh}" Margin="4,0,0,0" />
                </StackPanel>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Subtitle}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Text.Caption}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Loading / error -->
        <ProgressBar DockPanel.Dock="Top" IsIndeterminate="True" Height="2"
                     Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}" />
        <Border DockPanel.Dock="Top" Background="{DynamicResource Brush.SurfaceAlt}" Padding="16,8"
                Visibility="{Binding Error, Converter={x:Static v:NotNullToVisibilityConverter.Instance}}">
            <TextBlock Text="{Binding Error}" Foreground="{DynamicResource Brush.Danger}" TextWrapping="Wrap" />
        </Border>

        <TabControl x:Name="Tabs" Margin="0,6,0,0">
            <TabItem x:Name="PropertiesTab" Header="{x:Static res:Strings.DetailsProperties}" c:Ui.Icon="{x:Static c:Icons.Info}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,8,0,0">
                    <ItemsControl ItemsSource="{Binding Properties}" Grid.IsSharedSizeScope="True" Margin="4,0" MaxWidth="760" HorizontalAlignment="Left">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1" Padding="4,7">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="Label" MinWidth="160" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Label}" Foreground="{DynamicResource Brush.TextSecondary}" Margin="0,0,24,0" />
                                        <TextBox Grid.Column="1" Text="{Binding Value, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent"
                                                 Padding="0" TextWrapping="Wrap" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </TabItem>
            <TabItem x:Name="DdlTab" Header="{x:Static res:Strings.DetailsDdl}" c:Ui.Icon="{x:Static c:Icons.Code}">
                <Grid Margin="0,8,0,0">
                    <Border Style="{StaticResource Card.Surface}">
                        <e:SqlEditor x:Name="DdlEditor" Margin="4,6,4,4" IsReadOnly="True" LanguageService="{Binding LanguageService}" />
                    </Border>
                    <TextBlock Text="{Binding DdlMessage}" Foreground="{DynamicResource Brush.TextSecondary}" Margin="16" TextWrapping="Wrap"
                               Visibility="{Binding DdlMessage, Converter={x:Static v:NotNullToVisibilityConverter.Instance}}" />
                </Grid>
            </TabItem>
        </TabControl>
    </DockPanel>
</UserControl>
