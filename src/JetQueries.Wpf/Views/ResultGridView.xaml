<UserControl x:Class="JetQueries.Wpf.Views.ResultGridView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:UiKit.Controls;assembly=UiKit.Wpf"
             xmlns:res="clr-namespace:JetQueries.Presentation.Resources;assembly=JetQueries.Presentation"
             xmlns:v="clr-namespace:JetQueries.Wpf.Views"
             xmlns:ae="http://icsharpcode.net/sharpdevelop/avalonedit"
             xmlns:e="clr-namespace:JetQueries.Wpf.Editor"
             Focusable="False">
    <UserControl.Resources>
        <!-- The SQL filter box looks like an input; an applied filter or the focus draws its border in the accent -->
        <Style x:Key="SqlFilterFrame" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Brush.Input}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderStrong}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="1,1" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsFiltered}" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                </DataTrigger>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <UserControl.InputBindings>
        <KeyBinding Gesture="Ctrl+Shift+L" Command="{x:Static ApplicationCommands.Stop}" />
    </UserControl.InputBindings>
    <UserControl.CommandBindings>
        <CommandBinding Command="{x:Static ApplicationCommands.Stop}" Executed="OnClearFiltersShortcut" />
    </UserControl.CommandBindings>

    <DockPanel>
        <!-- DBeaver-style footer: refresh, page size, next page, fetch all, count; what was fetched, how long, when -->
        <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0" Padding="6,3">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                    <Button x:Name="RefreshButton" Style="{StaticResource Btn.Icon}" Width="26" Height="26" c:Ui.Icon="{x:Static c:Icons.Refresh}"
                            Command="{Binding DataContext.RefreshCommand, RelativeSource={RelativeSource AncestorType=v:QueryDocumentView}}" CommandParameter="{Binding}"
                            ToolTip="{x:Static res:Strings.RefreshResultTip}" />
                    <Border Style="{StaticResource Separator.Vertical}" Height="16" Margin="4,0" />
                    <TextBlock Text="{x:Static res:Strings.ResultPageSize}" Style="{StaticResource Text.Status}" Margin="2,0,6,0" />
                    <TextBox x:Name="FetchSizeBox" Width="64" Padding="6,2" VerticalAlignment="Center" HorizontalContentAlignment="Right"
                             Text="{Binding DataContext.FetchSize, RelativeSource={RelativeSource AncestorType=v:QueryDocumentView}, UpdateSourceTrigger=LostFocus}"
                             ToolTip="{x:Static res:Strings.FetchSizeTip}" KeyDown="OnFetchSizeKeyDown" />
                    <Button Style="{StaticResource Btn.Footer}" c:Ui.Icon="&#xE74B;" Content="{x:Static res:Strings.FetchNextShort}" Margin="4,0,0,0"
                            Command="{Binding DataContext.FetchNextPageCommand, RelativeSource={RelativeSource AncestorType=v:QueryDocumentView}}"
                            CommandParameter="{Binding}" ToolTip="{x:Static res:Strings.FetchNextPageTip}" />
                    <Button Style="{StaticResource Btn.Footer}" c:Ui.Icon="&#xE896;" Content="{x:Static res:Strings.FetchAllShort}"
                            Command="{Binding DataContext.FetchAllCommand, RelativeSource={RelativeSource AncestorType=v:QueryDocumentView}}"
                            CommandParameter="{Binding}" ToolTip="{x:Static res:Strings.FetchAllTip}" />
                    <Border Style="{StaticResource Separator.Vertical}" Height="16" Margin="4,0" />
                    <Button Style="{StaticResource Btn.Footer}" c:Ui.Icon="&#xE8EF;" Content="{x:Static res:Strings.CountShort}"
                            Command="{Binding DataContext.CountRowsCommand, RelativeSource={RelativeSource AncestorType=v:QueryDocumentView}}"
                            CommandParameter="{Binding}" ToolTip="{x:Static res:Strings.CountRowsTip}" />
                    <Border Style="{StaticResource Badge}" Margin="4,0,8,0" ToolTip="{x:Static res:Strings.CountRowsTip}">
                        <TextBlock Text="{Binding RowsText}" FontSize="{DynamicResource FontSize.Small}" Foreground="{DynamicResource Brush.TextSecondary}" />
                    </Border>
                    <Button x:Name="ExportButton" Style="{StaticResource Btn.Footer}" c:Ui.Icon="&#xEDE1;" Content="{x:Static res:Strings.ExportMenu}"
                            Command="{Binding DataContext.ExportCommand, RelativeSource={RelativeSource AncestorType=v:QueryDocumentView}}"
                            CommandParameter="{Binding}" Margin="0,0,6,0" />
                    <ToggleButton x:Name="ValuePanelToggle" Style="{StaticResource Btn.Footer}" c:Ui.Icon="&#xE7B3;" Content="{x:Static res:Strings.ValueShort}"
                                  ToolTip="{x:Static res:Strings.ValuePanelTip}" Click="OnValuePanelToggle" Margin="0,0,6,0" />
                    <ProgressBar IsIndeterminate="{Binding IsCounting}" Width="40" VerticalAlignment="Center" Margin="0,0,8,0"
                                 Visibility="{Binding IsCounting, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
                <!-- Count, sum, average, min, max of the selected cells -->
                <TextBlock x:Name="SelectionStatsText" DockPanel.Dock="Right" Style="{StaticResource Text.Status}" Margin="12,0,4,0"
                           Foreground="{DynamicResource Brush.TextSecondary}" />
                <TextBlock Text="{Binding FetchStatus}" Style="{StaticResource Text.Status}" Foreground="{DynamicResource Brush.TextMuted}"
                           TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>

        <!-- DBeaver's "Enter a SQL expression to filter results": the query runs again on the server with a WHERE -->
        <Border x:Name="SqlFilterBar" DockPanel.Dock="Top" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1" Padding="6,4"
                IsEnabled="{Binding CanFilter}" ToolTipService.ShowOnDisabled="True" Visibility="Collapsed">
            <Border.Style>
                <Style TargetType="Border">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding CanFilter}" Value="False">
                            <Setter Property="ToolTip" Value="{x:Static res:Strings.FilterUnavailable}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource Btn.Icon}" Width="26" Height="26" c:Ui.Icon="&#xE711;" Margin="2,0,0,0"
                        Command="{Binding DataContext.ClearFilterCommand, RelativeSource={RelativeSource AncestorType=v:QueryDocumentView}}"
                        CommandParameter="{Binding}" ToolTip="{x:Static res:Strings.SqlFilterClear}" />
                <Button x:Name="ApplySqlFilterButton" DockPanel.Dock="Right" Style="{StaticResource Btn.Icon}" Width="26" Height="26"
                        c:Ui.Icon="{x:Static c:Icons.Filter}" Margin="4,0,0,0"
                        Command="{Binding DataContext.ApplyFilterCommand, RelativeSource={RelativeSource AncestorType=v:QueryDocumentView}}"
                        CommandParameter="{Binding}" ToolTip="{x:Static res:Strings.SqlFilterApply}" />
                <!-- A one-line SQL editor: colouring and completion of the result's columns -->
                <Border x:Name="SqlFilterFrame" Style="{StaticResource SqlFilterFrame}" Height="28" VerticalAlignment="Center">
                    <e:SqlEditor x:Name="SqlFilterBox" IsSingleLine="True" Placeholder="{x:Static res:Strings.FilterPlaceholder}"
                                 Text="{Binding SqlFilter, UpdateSourceTrigger=PropertyChanged}"
                                 LanguageService="{Binding DataContext.LanguageService, RelativeSource={RelativeSource AncestorType=v:QueryDocumentView}}" />
                </Border>
            </DockPanel>
        </Border>

        <!-- Active filters, hidden columns and how many rows are shown (DESIGN.md: filter chips) -->
        <DockPanel x:Name="ChipBar" DockPanel.Dock="Top" Margin="10,8,10,4" Visibility="Collapsed">
            <TextBlock DockPanel.Dock="Left" Text="{x:Static c:Icons.Filter}" Style="{StaticResource Text.Icon}" FontSize="13"
                       Foreground="{DynamicResource Brush.Accent}" Margin="2,0,10,0" />
            <TextBlock x:Name="RowsText" DockPanel.Dock="Right" Style="{StaticResource Text.Status}" Margin="12,0,0,0" />
            <Button x:Name="ClearAll" DockPanel.Dock="Right" Style="{StaticResource Btn.Link}" Content="{x:Static res:Strings.FilterClearAll}"
                    Click="OnClearAll" />
            <WrapPanel>
                <!-- With two filters or more: are they combined with AND or OR -->
                <Button x:Name="MatchMode" Style="{StaticResource Btn.Link}" VerticalAlignment="Center" Margin="0,0,8,0"
                        Visibility="Collapsed" Click="OnMatchMode" ToolTip="{x:Static res:Strings.FilterMatchTip}" />
                <ItemsControl x:Name="Chips" Focusable="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Chip}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock VerticalAlignment="Center" FontSize="12">
                                        <Run Text="{Binding Column, Mode=OneWay}" FontWeight="SemiBold" />
                                        <Run Text="{Binding Condition, Mode=OneWay}" Foreground="{DynamicResource Brush.TextSecondary}" />
                                    </TextBlock>
                                    <Button Style="{StaticResource Btn.Icon}" Width="20" Height="20" Margin="6,0,0,0" c:Ui.Icon="&#xE711;"
                                            c:Ui.CornerRadius="10" FontSize="9" ToolTip="{x:Static res:Strings.FilterRemove}"
                                            Click="OnRemoveChip" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button x:Name="ShowColumns" Style="{StaticResource Btn.Link}" VerticalAlignment="Center" Margin="4,0,0,0"
                        Visibility="Collapsed" Click="OnShowColumns" />
            </WrapPanel>
        </DockPanel>

        <!-- The current cell in full, beside the grid (toggled under the grid) -->
        <Grid x:Name="ValuePanelHost" DockPanel.Dock="Right" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="320" MinWidth="160" />
            </Grid.ColumnDefinitions>
            <GridSplitter Grid.Column="0" Width="6" HorizontalAlignment="Stretch" ResizeDirection="Columns" ResizeBehavior="CurrentAndNext" />
            <Border Grid.Column="1" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1,0,0,0">
                <DockPanel>
                    <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1" Padding="10,6,4,6">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource Btn.Icon}" Width="24" Height="24" c:Ui.Icon="&#xE711;" Click="OnCloseValuePanel" />
                            <StackPanel>
                                <TextBlock x:Name="ValueColumn" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="ValueInfo" Style="{StaticResource Text.Caption}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <Grid>
                        <TextBox x:Name="ValueText" Style="{StaticResource TextBox.ReadOnly}" FontFamily="{DynamicResource Font.Code}"
                                 FontSize="{DynamicResource FontSize.Small}" TextWrapping="Wrap" VerticalContentAlignment="Top" Padding="10,8"
                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" AcceptsReturn="True" />
                        <ScrollViewer x:Name="ValueImageHost" Visibility="Collapsed" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                            <Image x:Name="ValueImage" Stretch="None" Margin="10" HorizontalAlignment="Left" VerticalAlignment="Top" />
                        </ScrollViewer>
                    </Grid>
                </DockPanel>
            </Border>
        </Grid>

        <Grid>
            <c:VirtualGrid x:Name="Grid" NullText="NULL" ShowFilterButtons="True" />

            <!-- Text view: the rows as an aligned plain-text table, to read or copy -->
            <ae:TextEditor x:Name="TextView" Visibility="Collapsed" IsReadOnly="True" ShowLineNumbers="False" WordWrap="False"
                           FontFamily="{DynamicResource Font.Code}" FontSize="{DynamicResource FontSize.Code}"
                           Foreground="{DynamicResource Brush.Text}" Background="Transparent" Padding="10,8,0,0"
                           HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" />

            <!-- Record view: one row, its columns listed downwards -->
            <DockPanel x:Name="RecordView" Visibility="Collapsed">
                <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1" Padding="6,4">
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource Btn.Icon}" Width="26" Height="26" c:Ui.Icon="&#xE892;" Command="{Binding FirstRecordCommand}"
                                ToolTip="{x:Static res:Strings.RecordFirst}" />
                        <Button Style="{StaticResource Btn.Icon}" Width="26" Height="26" c:Ui.Icon="&#xE76B;" Command="{Binding PreviousRecordCommand}"
                                ToolTip="{x:Static res:Strings.RecordPrevious}" />
                        <Button Style="{StaticResource Btn.Icon}" Width="26" Height="26" c:Ui.Icon="&#xE76C;" Command="{Binding NextRecordCommand}"
                                ToolTip="{x:Static res:Strings.RecordNext}" />
                        <Button Style="{StaticResource Btn.Icon}" Width="26" Height="26" c:Ui.Icon="&#xE893;" Command="{Binding LastRecordCommand}"
                                ToolTip="{x:Static res:Strings.RecordLast}" />
                        <TextBlock Text="{Binding RecordPosition}" Style="{StaticResource Text.Status}" Margin="10,0,0,0" />
                    </StackPanel>
                </Border>
                <Grid DockPanel.Dock="Top" Margin="12,6,12,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="160" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{x:Static res:Strings.RecordColumn}" Style="{StaticResource Text.Section}" />
                    <TextBlock Grid.Column="1" Text="{x:Static res:Strings.RecordValue}" Style="{StaticResource Text.Section}" Margin="3,0,0,0" />
                    <TextBlock Grid.Column="2" Text="{x:Static res:Strings.RecordType}" Style="{StaticResource Text.Section}" Margin="12,0,0,0" />
                </Grid>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding RecordFields}" Margin="12,0,12,8" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{DynamicResource Brush.GridLine}" BorderThickness="0,0,0,1" Padding="0,4">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="220" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="160" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Name}" Foreground="{DynamicResource Brush.TextSecondary}" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Top" Margin="0,1,12,0" />
                                        <TextBox x:Name="Value" Grid.Column="1" Style="{StaticResource TextBox.ReadOnly}" Text="{Binding Value, Mode=OneWay}" />
                                        <TextBlock x:Name="Null" Grid.Column="1" Text="NULL" Foreground="{DynamicResource Brush.TextMuted}" Visibility="Collapsed" />
                                        <TextBlock Grid.Column="2" Text="{Binding DataType}" Style="{StaticResource Text.Caption}" Margin="12,2,0,0"
                                                   TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsNull}" Value="True">
                                        <Setter TargetName="Value" Property="Visibility" Value="Collapsed" />
                                        <Setter TargetName="Null" Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>

            <!-- Shown while the grid is zoomed; a click goes back to 100 % -->
            <Button x:Name="ZoomBadge" Style="{StaticResource Btn.Link}" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                    Margin="0,0,20,18" Padding="6,2" Visibility="Collapsed" Background="{DynamicResource Brush.Card}"
                    FontSize="{DynamicResource FontSize.Caption}" ToolTip="{x:Static res:Strings.ZoomReset}" Click="OnZoomReset" />

            <!-- Filter panel of a column (DESIGN.md: filter popup) -->
            <Popup x:Name="FilterPopup" PlacementTarget="{Binding ElementName=Grid}" Placement="Relative" StaysOpen="False"
                   AllowsTransparency="True" PopupAnimation="Fade">
                <Border Style="{StaticResource Card.Popup}" Width="330" Padding="16,14">
                    <StackPanel KeyDown="OnFilterKeyDown">
                        <DockPanel Margin="0,0,0,12">
                            <Border DockPanel.Dock="Right" Style="{StaticResource Badge}">
                                <TextBlock x:Name="FilterType" FontSize="11" Foreground="{DynamicResource Brush.TextSecondary}" />
                            </Border>
                            <TextBlock x:Name="FilterTitle" FontSize="13.5" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        </DockPanel>
                        <TextBlock Text="{x:Static res:Strings.FilterCondition}" Style="{StaticResource Text.Section}" />
                        <ComboBox x:Name="FilterOperator" DisplayMemberPath="Text" SelectionChanged="OnOperatorChanged" />
                        <TextBox x:Name="FilterValue" Margin="0,8,0,0" c:Ui.Placeholder="{x:Static res:Strings.FilterValue}" />
                        <TextBlock x:Name="FilterError" Foreground="{DynamicResource Brush.Danger}" Margin="0,6,0,0" Visibility="Collapsed"
                                   Text="{x:Static res:Strings.FilterValueRequired}" />
                        <DockPanel Margin="0,16,0,0">
                            <Button DockPanel.Dock="Left" Style="{StaticResource Btn.Link}" Content="{x:Static res:Strings.FilterClear}" Click="OnFilterClear" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="{x:Static res:Strings.ButtonCancel}" Margin="0,0,8,0" Click="OnFilterCancel" />
                                <Button Style="{StaticResource Btn.Primary}" Content="{x:Static res:Strings.FilterApply}" Click="OnFilterApply" />
                            </StackPanel>
                        </DockPanel>
                    </StackPanel>
                </Border>
            </Popup>
        </Grid>
    </DockPanel>
</UserControl>
