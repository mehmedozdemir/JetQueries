<UserControl x:Class="JetQueries.Wpf.Views.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:UiKit.Controls;assembly=UiKit.Wpf"
             xmlns:res="clr-namespace:JetQueries.Presentation.Resources;assembly=JetQueries.Presentation"
             xmlns:v="clr-namespace:JetQueries.Wpf.Views">
    <DockPanel>
        <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1" Padding="6,6,6,4">
            <StackPanel>
                <c:SearchBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=250}"
                             c:Ui.Placeholder="{x:Static res:Strings.HistorySearch}" />
                <DockPanel Margin="0,6,0,0">
                    <Button DockPanel.Dock="Right" Style="{StaticResource Btn.Link}" Content="{x:Static res:Strings.HistoryClear}"
                            Command="{Binding ClearCommand}" />
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource Btn.Toolbar}" Height="26" Padding="8,0" c:Ui.Icon="{x:Static c:Icons.OpenFile}"
                                Content="{x:Static res:Strings.HistoryOpen}" Command="{Binding OpenSelectedCommand}" />
                        <Button Style="{StaticResource Btn.Icon}" Width="26" Height="26" c:Ui.Icon="{x:Static c:Icons.Delete}"
                                Command="{Binding DeleteSelectedCommand}" ToolTip="{x:Static res:Strings.ConnectionDelete}" />
                    </StackPanel>
                </DockPanel>
            </StackPanel>
        </Border>

        <Grid>
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="20"
                        Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
                <Border Width="56" Height="56" CornerRadius="16" Background="{DynamicResource Brush.AccentSoft}" HorizontalAlignment="Center">
                    <TextBlock Text="{x:Static c:Icons.History}" Style="{StaticResource Text.Icon}" FontSize="24" Foreground="{DynamicResource Brush.Accent}" />
                </Border>
                <TextBlock Text="{x:Static res:Strings.HistoryEmpty}" Foreground="{DynamicResource Brush.TextSecondary}"
                           TextWrapping="Wrap" TextAlignment="Center" Margin="0,14,0,0" MaxWidth="240" />
            </StackPanel>

            <ListBox x:Name="List" ItemsSource="{Binding Entries}" SelectedItem="{Binding Selected}"
                     BorderThickness="0" Background="Transparent" Padding="4"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     Visibility="{Binding IsEmpty, Converter={x:Static v:InverseBoolToVisibilityConverter.Instance}}"
                     MouseDoubleClick="OnListDoubleClick">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="2,1" ToolTip="{Binding ToolTip}">
                            <TextBlock x:Name="Sql" Text="{Binding Summary}" FontFamily="{DynamicResource Font.Code}" FontSize="{DynamicResource FontSize.Small}"
                                       TextTrimming="CharacterEllipsis" />
                            <DockPanel Margin="0,2,0,0">
                                <TextBlock DockPanel.Dock="Right" Text="{Binding When}" Style="{StaticResource Text.Caption}" Margin="8,0,0,0" />
                                <TextBlock Text="{Binding Detail}" Style="{StaticResource Text.Caption}" TextTrimming="CharacterEllipsis" />
                            </DockPanel>
                        </StackPanel>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsFailed}" Value="True">
                                <Setter TargetName="Sql" Property="Foreground" Value="{DynamicResource Brush.Danger}" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>
    </DockPanel>
</UserControl>
