<Window x:Class="JetQueries.Wpf.Views.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:UiKit.Controls;assembly=UiKit.Wpf"
        xmlns:res="clr-namespace:JetQueries.Presentation.Resources;assembly=JetQueries.Presentation"
        xmlns:e="clr-namespace:JetQueries.Wpf.Editor"
        xmlns:v="clr-namespace:JetQueries.Wpf.Views"
        Title="{x:Static res:Strings.HistoryWindowTitle}" Width="1080" Height="640" MinWidth="700" MinHeight="420"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Style="{StaticResource Window.App}">
    <Window.InputBindings>
        <KeyBinding Key="Escape" Command="{x:Static ApplicationCommands.Close}" />
    </Window.InputBindings>
    <Window.CommandBindings>
        <CommandBinding Command="{x:Static ApplicationCommands.Close}" Executed="OnClose" />
    </Window.CommandBindings>

    <DockPanel>
        <!-- Header: title and search -->
        <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1" Padding="16,12">
            <DockPanel>
                <Border Width="30" Height="30" CornerRadius="8" Background="{DynamicResource Brush.AccentSoft}" Margin="0,0,12,0">
                    <TextBlock Text="{x:Static c:Icons.History}" Style="{StaticResource Text.Icon}" Foreground="{DynamicResource Brush.Accent}" />
                </Border>
                <Button DockPanel.Dock="Right" Style="{StaticResource Btn.Link}" Content="{x:Static res:Strings.HistoryClear}" Command="{Binding ClearCommand}"
                        VerticalAlignment="Center" Margin="12,0,0,0" />
                <c:SearchBox x:Name="Search" DockPanel.Dock="Right" Width="320" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=250}"
                             c:Ui.Placeholder="{x:Static res:Strings.HistorySearch}" VerticalAlignment="Center" />
                <TextBlock Text="{x:Static res:Strings.HistoryWindowTitle}" Style="{StaticResource Text.Subtitle}" VerticalAlignment="Center" />
            </DockPanel>
        </Border>

        <Grid Margin="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="5*" MinWidth="260" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="6*" MinWidth="260" />
            </Grid.ColumnDefinitions>

            <!-- Runs, newest first -->
            <Border Style="{StaticResource Card.Surface}">
                <Grid>
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="20"
                                Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="{x:Static c:Icons.History}" Style="{StaticResource Text.Icon}" FontSize="26" Foreground="{DynamicResource Brush.TextMuted}" />
                        <TextBlock Text="{x:Static res:Strings.HistoryEmpty}" Foreground="{DynamicResource Brush.TextSecondary}"
                                   TextWrapping="Wrap" TextAlignment="Center" Margin="0,12,0,0" MaxWidth="260" />
                    </StackPanel>
                    <ListBox x:Name="List" ItemsSource="{Binding Entries}" SelectedItem="{Binding Selected}" BorderThickness="0" Background="Transparent"
                             Padding="4" ScrollViewer.HorizontalScrollBarVisibility="Disabled" MouseDoubleClick="OnListDoubleClick" KeyDown="OnListKeyDown"
                             Visibility="{Binding IsEmpty, Converter={x:Static v:InverseBoolToVisibilityConverter.Instance}}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="2,2">
                                    <TextBlock x:Name="Sql" Text="{Binding Summary}" FontFamily="{DynamicResource Font.Code}" FontSize="{DynamicResource FontSize.Small}"
                                               TextTrimming="CharacterEllipsis" />
                                    <DockPanel Margin="0,3,0,0">
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding When}" Style="{StaticResource Text.Caption}" Margin="8,0,0,0" />
                                        <TextBlock Text="{Binding Detail}" Style="{StaticResource Text.Caption}" TextTrimming="CharacterEllipsis" />
                                    </DockPanel>
                                </StackPanel>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsFailed}" Value="True">
                                        <Setter TargetName="Sql" Property="Foreground" Value="{DynamicResource Brush.Danger}" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1" Width="10" HorizontalAlignment="Stretch" Background="Transparent" />

            <!-- The selected run: how it ended, its text, actions -->
            <DockPanel Grid.Column="2">
                <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                    <Button DockPanel.Dock="Right" Style="{StaticResource Btn.Primary}" c:Ui.Icon="{x:Static c:Icons.OpenFile}"
                            Content="{x:Static res:Strings.HistoryOpen}" Command="{Binding OpenSelectedCommand}" />
                    <Button DockPanel.Dock="Right" Style="{StaticResource Btn.Secondary}" c:Ui.Icon="{x:Static c:Icons.Copy}" Margin="0,0,8,0"
                            Content="{x:Static res:Strings.HistoryCopy}" Click="OnCopy" IsEnabled="{Binding Selected, Converter={x:Static v:NotNullConverter.Instance}}" />
                    <Button Style="{StaticResource Btn.Icon}" c:Ui.Icon="{x:Static c:Icons.Delete}" Command="{Binding DeleteSelectedCommand}"
                            ToolTip="{x:Static res:Strings.ConnectionDelete}" HorizontalAlignment="Left" />
                </DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="2,0,0,8" Visibility="{Binding Selected, Converter={x:Static v:NotNullToVisibilityConverter.Instance}}">
                    <TextBlock Text="{Binding Selected.Detail}" Foreground="{DynamicResource Brush.TextSecondary}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Selected.Entry.Error}" Foreground="{DynamicResource Brush.Danger}" TextWrapping="Wrap" Margin="0,4,0,0"
                               Visibility="{Binding Selected.Entry.Error, Converter={x:Static v:NotNullToVisibilityConverter.Instance}}" />
                </StackPanel>
                <Border Style="{StaticResource Card.Surface}">
                    <e:SqlEditor x:Name="Preview" Margin="4,6,4,4" IsReadOnly="True" />
                </Border>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
