<Window x:Class="JetQueries.Wpf.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:JetQueries.Presentation.Resources;assembly=JetQueries.Presentation"
        Title="{x:Static res:Strings.Settings}" Width="560" SizeToContent="Height" ResizeMode="NoResize"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        Style="{StaticResource Window.App}">
    <Window.Resources>
        <Style x:Key="Field" TargetType="Grid">
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <!-- Each font shown in itself. -->
        <DataTemplate x:Key="FontItem">
            <TextBlock Text="{Binding}" FontFamily="{Binding}" />
        </DataTemplate>
    </Window.Resources>

    <DockPanel Margin="18,16,18,16">
        <DockPanel DockPanel.Dock="Bottom" Margin="0,14,0,0">
            <Button DockPanel.Dock="Left" Style="{StaticResource Btn.Link}" Content="{x:Static res:Strings.ButtonResetDefaults}"
                    Command="{Binding ResetDefaultsCommand}" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="{x:Static res:Strings.ButtonCancel}" Command="{Binding CancelCommand}" IsCancel="True" MinWidth="88" Margin="0,0,8,0" />
                <Button Style="{StaticResource Btn.Primary}" Content="{x:Static res:Strings.ButtonSave}" Command="{Binding SaveCommand}" IsDefault="True" MinWidth="88" />
            </StackPanel>
        </DockPanel>

        <StackPanel>
            <TextBlock Text="{x:Static res:Strings.SectionAppearance}" Style="{StaticResource Text.Section}" />
            <Grid Style="{StaticResource Field}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{x:Static res:Strings.FieldTheme}" Style="{StaticResource Text.FieldLabel}" />
                <ComboBox Grid.Column="1" ItemsSource="{Binding Themes}" SelectedItem="{Binding SelectedTheme}" DisplayMemberPath="Text" />
            </Grid>
            <Grid Style="{StaticResource Field}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="90" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{x:Static res:Strings.FieldFontFamily}" Style="{StaticResource Text.FieldLabel}" />
                <ComboBox Grid.Column="1" ItemsSource="{Binding Fonts}" SelectedItem="{Binding UiFontFamily}" ItemTemplate="{StaticResource FontItem}"
                          VirtualizingPanel.IsVirtualizing="True" IsTextSearchEnabled="True" />
                <ComboBox Grid.Column="2" Margin="8,0,0,0" ItemsSource="{Binding UiSizes}" SelectedItem="{Binding UiFontSize}"
                          ToolTip="{x:Static res:Strings.FieldFontSize}" />
            </Grid>

            <TextBlock Text="{x:Static res:Strings.SectionEditor}" Style="{StaticResource Text.Section}" Margin="0,10,0,6" />
            <Grid Style="{StaticResource Field}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="90" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{x:Static res:Strings.FieldFontFamily}" Style="{StaticResource Text.FieldLabel}" />
                <ComboBox Grid.Column="1" ItemsSource="{Binding Fonts}" SelectedItem="{Binding EditorFontFamily}" ItemTemplate="{StaticResource FontItem}"
                          VirtualizingPanel.IsVirtualizing="True" IsTextSearchEnabled="True" />
                <ComboBox Grid.Column="2" Margin="8,0,0,0" ItemsSource="{Binding EditorSizes}" SelectedItem="{Binding EditorFontSize}"
                          ToolTip="{x:Static res:Strings.FieldFontSize}" />
            </Grid>
            <Border Background="{DynamicResource Brush.Input}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="6"
                    Padding="10,6" Margin="150,0,0,8">
                <TextBlock FontFamily="{DynamicResource Font.Code}" FontSize="{DynamicResource FontSize.Code}">
                    <Run Text="SELECT" Foreground="{DynamicResource Brush.Syntax.Keyword}" />
                    <Run Text="id, ad" Foreground="{DynamicResource Brush.Syntax.Identifier}" />
                    <Run Text="FROM" Foreground="{DynamicResource Brush.Syntax.Keyword}" />
                    <Run Text="müşteri" Foreground="{DynamicResource Brush.Syntax.Identifier}" />
                    <Run Text="-- İıŞşĞğ 0Oo1lI" Foreground="{DynamicResource Brush.Syntax.Comment}" FontStyle="Italic" />
                </TextBlock>
            </Border>

            <TextBlock Text="{x:Static res:Strings.SectionGrid}" Style="{StaticResource Text.Section}" Margin="0,10,0,6" />
            <Grid Style="{StaticResource Field}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="90" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{x:Static res:Strings.FieldFontSize}" Style="{StaticResource Text.FieldLabel}" />
                <ComboBox Grid.Column="1" ItemsSource="{Binding GridSizes}" SelectedItem="{Binding GridFontSize}" />
            </Grid>
            <TextBlock Text="{x:Static res:Strings.SettingsZoomHint}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,6,0,0" />

            <TextBlock Text="{x:Static res:Strings.SectionQuery}" Style="{StaticResource Text.Section}" Margin="0,14,0,6" />
            <Grid Style="{StaticResource Field}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{x:Static res:Strings.FieldQueryButtons}" Style="{StaticResource Text.FieldLabel}" />
                <ComboBox Grid.Column="1" ItemsSource="{Binding QueryButtonPlaces}" SelectedItem="{Binding QueryButtonPlace}" DisplayMemberPath="Text" />
            </Grid>
            <Grid Style="{StaticResource Field}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="90" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{x:Static res:Strings.FieldFetchSize}" Style="{StaticResource Text.FieldLabel}" />
                <ComboBox Grid.Column="1" ItemsSource="{Binding FetchSizes}" SelectedItem="{Binding FetchSize}" />
            </Grid>
        </StackPanel>
    </DockPanel>
</Window>
