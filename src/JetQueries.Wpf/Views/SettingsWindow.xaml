<Window x:Class="JetQueries.Wpf.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:UiKit.Controls;assembly=UiKit.Wpf"
        xmlns:res="clr-namespace:JetQueries.Presentation.Resources;assembly=JetQueries.Presentation"
        xmlns:e="clr-namespace:JetQueries.Wpf.Editor"
        xmlns:v="clr-namespace:JetQueries.Wpf.Views"
        xmlns:vm="clr-namespace:JetQueries.Presentation.ViewModels;assembly=JetQueries.Presentation"
        Title="{x:Static res:Strings.Settings}" Width="920" Height="660" MinWidth="780" MinHeight="520"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        Style="{StaticResource Window.App}">
    <Window.Resources>
        <!-- Each font shown in itself. -->
        <DataTemplate x:Key="FontItem">
            <TextBlock Text="{Binding}" FontFamily="{Binding}" />
        </DataTemplate>
        <Style x:Key="Page" TargetType="StackPanel">
            <Setter Property="Visibility" Value="Collapsed" />
        </Style>
        <Style x:Key="Card" TargetType="Border" BasedOn="{StaticResource Card.Surface}">
            <Setter Property="Margin" Value="0,0,0,22" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="236" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Pages -->
        <DockPanel>
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="22,22,20,18">
                <Border Width="34" Height="34" CornerRadius="10" Background="{DynamicResource Brush.AccentSoft}">
                    <TextBlock Text="{x:Static c:Icons.Settings}" Style="{StaticResource Text.Icon}" FontSize="16" HorizontalAlignment="Center"
                               Foreground="{DynamicResource Brush.Accent}" />
                </Border>
                <TextBlock Text="{x:Static res:Strings.Settings}" Style="{StaticResource Text.Subtitle}" Margin="12,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock DockPanel.Dock="Bottom" Text="{x:Static res:Strings.SettingsSavedHint}" Style="{StaticResource Text.Caption}"
                       TextWrapping="Wrap" Margin="22,0,22,20" />
            <ListBox x:Name="Nav" ItemsSource="{Binding Sections}" SelectedItem="{Binding SelectedSection}" Margin="12,0"
                     ItemContainerStyle="{StaticResource Settings.NavItem}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="Icon" Text="&#xE790;" Style="{StaticResource Text.Icon}" FontSize="15" Width="20" />
                            <TextBlock Text="{Binding Title}" Margin="10,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding Key}" Value="editor">
                                <Setter TargetName="Icon" Property="Text" Value="{x:Static c:Icons.Code}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Key}" Value="results">
                                <Setter TargetName="Icon" Property="Text" Value="{x:Static c:Icons.Table}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Key}" Value="query">
                                <Setter TargetName="Icon" Property="Text" Value="{x:Static c:Icons.Play}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Key}" Value="format">
                                <Setter TargetName="Icon" Property="Text" Value="&#xE8E4;" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Key}" Value="snippets">
                                <Setter TargetName="Icon" Property="Text" Value="&#xE8EC;" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <DockPanel Grid.Column="1">
            <!-- Reset on the left; Cancel and Save on the right -->
            <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0" Padding="28,12">
                <DockPanel>
                    <Button DockPanel.Dock="Left" Style="{StaticResource Btn.Link}" c:Ui.Icon="{x:Static c:Icons.Refresh}"
                            Content="{x:Static res:Strings.ButtonResetDefaults}" Command="{Binding ResetDefaultsCommand}" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="{x:Static res:Strings.ButtonCancel}" Command="{Binding CancelCommand}" IsCancel="True" MinWidth="92" Margin="0,0,8,0" />
                        <Button Style="{StaticResource Btn.Primary}" Content="{x:Static res:Strings.ButtonSave}" Command="{Binding SaveCommand}"
                                IsDefault="True" MinWidth="92" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- The page's title and what it is about -->
            <StackPanel DockPanel.Dock="Top" Margin="30,24,30,18">
                <TextBlock Text="{Binding SelectedSection.Title}" FontSize="{DynamicResource FontSize.Title}" FontWeight="SemiBold" />
                <TextBlock Text="{Binding SelectedSection.Description}" Foreground="{DynamicResource Brush.TextSecondary}" Margin="0,4,0,0" />
            </StackPanel>

            <ScrollViewer x:Name="Pages" VerticalScrollBarVisibility="Auto" Padding="30,0,30,8">
                <Grid>
                    <!-- Appearance -->
                    <StackPanel x:Name="AppearancePage" Style="{StaticResource Page}">
                        <TextBlock Text="{x:Static res:Strings.SettingsGroupTheme}" Style="{StaticResource Settings.Group}" />
                        <Border Style="{StaticResource Card}" Padding="18,16">
                            <StackPanel>
                                <TextBlock Text="{x:Static res:Strings.SettingThemeInfo}" Style="{StaticResource Settings.RowInfo}" Margin="0,0,0,14" />
                                <ListBox ItemsSource="{Binding Themes}" SelectedItem="{Binding SelectedTheme}" ItemContainerStyle="{StaticResource ChoiceCard}">
                                    <ListBox.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ListBox.ItemsPanel>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel>
                                                <TextBlock x:Name="Icon" Text="{x:Static c:Icons.Moon}" Style="{StaticResource Text.Icon}" FontSize="24"
                                                           HorizontalAlignment="Center" />
                                                <TextBlock Text="{Binding Text}" HorizontalAlignment="Center" Margin="0,10,0,0" FontWeight="SemiBold" />
                                            </StackPanel>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding Value}" Value="False">
                                                    <Setter TargetName="Icon" Property="Text" Value="{x:Static c:Icons.Sun}" />
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="{x:Static res:Strings.SettingsGroupFont}" Style="{StaticResource Settings.Group}" />
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <Border Style="{StaticResource Settings.Row}" BorderThickness="0">
                                    <DockPanel>
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="24,0,0,0" VerticalAlignment="Center">
                                            <ComboBox Width="240" ItemsSource="{Binding Fonts}" SelectedItem="{Binding UiFontFamily}" ItemTemplate="{StaticResource FontItem}"
                                                      VirtualizingPanel.IsVirtualizing="True" IsTextSearchEnabled="True" />
                                            <ComboBox Width="76" Margin="8,0,0,0" ItemsSource="{Binding UiSizes}" SelectedItem="{Binding UiFontSize}"
                                                      ToolTip="{x:Static res:Strings.FieldFontSize}" />
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock Text="{x:Static res:Strings.FieldFontFamily}" Style="{StaticResource Settings.RowTitle}" />
                                            <TextBlock Text="{x:Static res:Strings.SettingUiFontInfo}" Style="{StaticResource Settings.RowInfo}" />
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                                <Border Style="{StaticResource Settings.Row}" Background="{DynamicResource Brush.SurfaceAlt}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{x:Static c:Icons.Database}" Style="{StaticResource Text.Icon}" Foreground="{DynamicResource Brush.Accent}" />
                                        <TextBlock Text="{x:Static res:Strings.SettingUiSample}" Margin="8,0,0,0" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- SQL editor -->
                    <StackPanel x:Name="EditorPage" Style="{StaticResource Page}">
                        <TextBlock Text="{x:Static res:Strings.SettingsGroupFont}" Style="{StaticResource Settings.Group}" />
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <Border Style="{StaticResource Settings.Row}" BorderThickness="0">
                                    <DockPanel>
                                        <ComboBox DockPanel.Dock="Right" Width="240" Margin="24,0,0,0" VerticalAlignment="Center" ItemsSource="{Binding Fonts}"
                                                  SelectedItem="{Binding EditorFontFamily}" ItemTemplate="{StaticResource FontItem}"
                                                  VirtualizingPanel.IsVirtualizing="True" IsTextSearchEnabled="True" />
                                        <StackPanel>
                                            <TextBlock Text="{x:Static res:Strings.FieldFontFamily}" Style="{StaticResource Settings.RowTitle}" />
                                            <TextBlock Text="{x:Static res:Strings.SettingEditorFontInfo}" Style="{StaticResource Settings.RowInfo}" />
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                                <Border Style="{StaticResource Settings.Row}">
                                    <DockPanel>
                                        <ComboBox DockPanel.Dock="Right" Width="76" Margin="24,0,0,0" VerticalAlignment="Center" ItemsSource="{Binding EditorSizes}"
                                                  SelectedItem="{Binding EditorFontSize}" />
                                        <StackPanel>
                                            <TextBlock Text="{x:Static res:Strings.FieldFontSize}" Style="{StaticResource Settings.RowTitle}" />
                                            <TextBlock Text="{x:Static res:Strings.SettingEditorSizeInfo}" Style="{StaticResource Settings.RowInfo}" />
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                        <TextBlock Text="{x:Static res:Strings.SettingPreview}" Style="{StaticResource Settings.Group}" />
                        <Border Style="{StaticResource Card}" Height="150">
                            <e:SqlEditor x:Name="EditorPreview" Margin="4,8,4,4" IsReadOnly="True" LanguageService="{Binding PreviewLanguage}"
                                         Text="{x:Static vm:SettingsViewModel.EditorSample}" />
                        </Border>
                    </StackPanel>

                    <!-- Results -->
                    <StackPanel x:Name="ResultsPage" Style="{StaticResource Page}">
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <Border Style="{StaticResource Settings.Row}" BorderThickness="0">
                                    <DockPanel>
                                        <ComboBox DockPanel.Dock="Right" Width="76" Margin="24,0,0,0" VerticalAlignment="Center" ItemsSource="{Binding GridSizes}"
                                                  SelectedItem="{Binding GridFontSize}" />
                                        <StackPanel>
                                            <TextBlock Text="{x:Static res:Strings.FieldFontSize}" Style="{StaticResource Settings.RowTitle}" />
                                            <TextBlock Text="{x:Static res:Strings.SettingGridSizeInfo}" Style="{StaticResource Settings.RowInfo}" />
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                                <Border Style="{StaticResource Settings.Row}">
                                    <DockPanel>
                                        <ComboBox DockPanel.Dock="Right" Width="96" Margin="24,0,0,0" VerticalAlignment="Center" ItemsSource="{Binding FetchSizes}"
                                                  SelectedItem="{Binding FetchSize}" />
                                        <StackPanel>
                                            <TextBlock Text="{x:Static res:Strings.FieldFetchSize}" Style="{StaticResource Settings.RowTitle}" />
                                            <TextBlock Text="{x:Static res:Strings.SettingFetchSizeInfo}" Style="{StaticResource Settings.RowInfo}" />
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                        <StackPanel Orientation="Horizontal" Margin="2,0,0,0">
                            <TextBlock Text="{x:Static c:Icons.Info}" Style="{StaticResource Text.Icon}" FontSize="13" Foreground="{DynamicResource Brush.TextMuted}" />
                            <TextBlock Text="{x:Static res:Strings.SettingsZoomHint}" Style="{StaticResource Text.Caption}" Margin="8,0,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Query tabs -->
                    <StackPanel x:Name="QueryPage" Style="{StaticResource Page}">
                        <Border Style="{StaticResource Card}">
                            <Border Style="{StaticResource Settings.Row}" BorderThickness="0">
                                <StackPanel>
                                    <TextBlock Text="{x:Static res:Strings.FieldQueryButtons}" Style="{StaticResource Settings.RowTitle}" />
                                    <TextBlock Text="{x:Static res:Strings.SettingQueryButtonsInfo}" Style="{StaticResource Settings.RowInfo}" />
                                    <ListBox Style="{StaticResource Segmented}" HorizontalAlignment="Left" Margin="0,12,0,0"
                                             ItemsSource="{Binding QueryButtonPlaces}" SelectedItem="{Binding QueryButtonPlace}" />
                                </StackPanel>
                            </Border>
                        </Border>
                    </StackPanel>

                    <!-- SQL formatting -->
                    <StackPanel x:Name="FormatPage" Style="{StaticResource Page}">
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <Border Style="{StaticResource Settings.Row}" BorderThickness="0">
                                    <DockPanel>
                                        <ListBox DockPanel.Dock="Right" Style="{StaticResource Segmented}" Margin="24,0,0,0" VerticalAlignment="Center"
                                                 ItemsSource="{Binding KeywordCases}" SelectedItem="{Binding FormatKeywordCase}" />
                                        <StackPanel>
                                            <TextBlock Text="{x:Static res:Strings.FieldKeywordCase}" Style="{StaticResource Settings.RowTitle}" />
                                            <TextBlock Text="{x:Static res:Strings.SettingKeywordCaseInfo}" Style="{StaticResource Settings.RowInfo}" />
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                                <Border Style="{StaticResource Settings.Row}">
                                    <DockPanel>
                                        <ListBox DockPanel.Dock="Right" Style="{StaticResource Segmented}" Margin="24,0,0,0" VerticalAlignment="Center"
                                                 ItemsSource="{Binding Indents}" SelectedItem="{Binding FormatIndent}" />
                                        <StackPanel>
                                            <TextBlock Text="{x:Static res:Strings.FieldIndent}" Style="{StaticResource Settings.RowTitle}" />
                                            <TextBlock Text="{x:Static res:Strings.SettingIndentInfo}" Style="{StaticResource Settings.RowInfo}" />
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                                <Border Style="{StaticResource Settings.Row}">
                                    <DockPanel>
                                        <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" Margin="24,0,0,0" VerticalAlignment="Center"
                                                  IsChecked="{Binding FormatContentOnNewLine}" />
                                        <StackPanel>
                                            <TextBlock Text="{x:Static res:Strings.FieldContentOnNewLine}" Style="{StaticResource Settings.RowTitle}" />
                                            <TextBlock Text="{x:Static res:Strings.SettingContentOnNewLineInfo}" Style="{StaticResource Settings.RowInfo}" />
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                                <Border Style="{StaticResource Settings.Row}">
                                    <DockPanel>
                                        <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" Margin="24,0,0,0" VerticalAlignment="Center"
                                                  IsChecked="{Binding FormatConditionsOnNewLine}" />
                                        <StackPanel>
                                            <TextBlock Text="{x:Static res:Strings.FieldConditionsOnNewLine}" Style="{StaticResource Settings.RowTitle}" />
                                            <TextBlock Text="{x:Static res:Strings.SettingConditionsOnNewLineInfo}" Style="{StaticResource Settings.RowInfo}" />
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                        <TextBlock Text="{x:Static res:Strings.SettingPreview}" Style="{StaticResource Settings.Group}" />
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <e:SqlEditor x:Name="FormatPreview" Height="300" Margin="4,8,4,4" IsReadOnly="True" LanguageService="{Binding PreviewLanguage}"
                                             Text="{Binding FormatPreview, Mode=OneWay}" />
                                <Border Style="{StaticResource Settings.Row}" Visibility="{Binding CanPreviewFormat, Converter={x:Static v:FalseToVisibleConverter.Instance}}">
                                    <TextBlock Text="{x:Static res:Strings.SettingFormatPreviewMissing}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" />
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Snippets: the list on the left, the one chosen on the right -->
                    <Grid x:Name="SnippetsPage" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="230" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.ColumnSpan="3" Text="{Binding SnippetError}" Foreground="{DynamicResource Brush.Danger}" TextWrapping="Wrap" Margin="2,0,0,10"
                                   Visibility="{Binding SnippetError, Converter={x:Static v:NotNullToVisibilityConverter.Instance}}" />
                        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,8">
                            <DockPanel>
                                <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1" Padding="6,4">
                                    <StackPanel Orientation="Horizontal">
                                        <Button Style="{StaticResource Btn.Icon}" Width="28" Height="28" c:Ui.Icon="{x:Static c:Icons.Add}"
                                                Command="{Binding AddSnippetCommand}" ToolTip="{x:Static res:Strings.SnippetAdd}" />
                                        <Button Style="{StaticResource Btn.Icon}" Width="28" Height="28" c:Ui.Icon="{x:Static c:Icons.Delete}"
                                                Command="{Binding RemoveSnippetCommand}" ToolTip="{x:Static res:Strings.SnippetRemove}" />
                                    </StackPanel>
                                </Border>
                                <ListBox x:Name="SnippetList" ItemsSource="{Binding SnippetItems}" SelectedItem="{Binding SelectedSnippet}" Padding="4"
                                         MinHeight="300" ItemContainerStyle="{StaticResource Settings.NavItem}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Shortcut}" FontFamily="{DynamicResource Font.Code}" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding Description}" Style="{StaticResource Text.Caption}" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </DockPanel>
                        </Border>
                        <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource Card}" Margin="0,0,0,8" Grid.IsSharedSizeScope="True"
                                Visibility="{Binding SelectedSnippet, Converter={x:Static v:NotNullToVisibilityConverter.Instance}}">
                            <DockPanel>
                                <Border DockPanel.Dock="Top" Style="{StaticResource Settings.Row}" BorderThickness="0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="SnippetLabel" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{x:Static res:Strings.FieldShortcut}" Foreground="{DynamicResource Brush.Text}" VerticalAlignment="Center" Margin="0,0,16,0" />
                                        <TextBox Grid.Column="1" FontFamily="{DynamicResource Font.Code}"
                                                 Text="{Binding SelectedSnippet.Shortcut, UpdateSourceTrigger=PropertyChanged}" />
                                    </Grid>
                                </Border>
                                <Border DockPanel.Dock="Top" Style="{StaticResource Settings.Row}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="SnippetLabel" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{x:Static res:Strings.FieldDescription}" Foreground="{DynamicResource Brush.Text}" VerticalAlignment="Center" Margin="0,0,16,0" />
                                        <TextBox Grid.Column="1" Text="{Binding SelectedSnippet.Description, UpdateSourceTrigger=PropertyChanged}" />
                                    </Grid>
                                </Border>
                                <Border Style="{StaticResource Settings.Row}" Padding="4,8,4,4">
                                    <e:SqlEditor x:Name="SnippetEditor" MinHeight="200" LanguageService="{Binding PreviewLanguage}"
                                                 Text="{Binding SelectedSnippet.Text, UpdateSourceTrigger=PropertyChanged}" />
                                </Border>
                            </DockPanel>
                        </Border>
                    </Grid>
                </Grid>
            </ScrollViewer>
        </DockPanel>
    </Grid>
</Window>
