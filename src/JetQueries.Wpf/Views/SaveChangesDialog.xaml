<Window x:Class="JetQueries.Wpf.Views.SaveChangesDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:JetQueries.Presentation.Resources;assembly=JetQueries.Presentation"
        Title="{x:Static res:Strings.SaveChangesTitle}" Width="440" SizeToContent="Height" ResizeMode="NoResize"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        Style="{StaticResource Window.App}">
    <StackPanel Margin="20,18,20,18">
        <TextBlock x:Name="Message" TextWrapping="Wrap" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Style="{StaticResource Btn.Primary}" Content="{x:Static res:Strings.ButtonSave}" IsDefault="True" MinWidth="88" Margin="0,0,8,0" Click="OnSave" />
            <Button Content="{x:Static res:Strings.ButtonDontSave}" MinWidth="88" Margin="0,0,8,0" Click="OnDiscard" />
            <Button Content="{x:Static res:Strings.ButtonCancel}" IsCancel="True" MinWidth="88" />
        </StackPanel>
    </StackPanel>
</Window>
