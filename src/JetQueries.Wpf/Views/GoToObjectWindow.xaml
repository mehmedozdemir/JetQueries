<Window x:Class="JetQueries.Wpf.Views.GoToObjectWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:UiKit.Controls;assembly=UiKit.Wpf"
        xmlns:res="clr-namespace:JetQueries.Presentation.Resources;assembly=JetQueries.Presentation"
        xmlns:v="clr-namespace:JetQueries.Wpf.Views"
        Title="{x:Static res:Strings.GoToObject}" Width="600" Height="460" MinWidth="420" MinHeight="300"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        Style="{StaticResource Window.App}">
    <DockPanel Margin="16,14,16,12">
        <c:SearchBox x:Name="Search" DockPanel.Dock="Top" c:Ui.Placeholder="{x:Static res:Strings.GoToObjectPlaceholder}"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=150}" />

        <!-- How many objects are known, or that lists are still loading -->
        <DockPanel DockPanel.Dock="Bottom" Margin="2,10,0,0">
            <ProgressBar DockPanel.Dock="Left" IsIndeterminate="True" Width="60" Margin="0,0,10,0" VerticalAlignment="Center"
                         Visibility="{Binding IsIndexing, Converter={StaticResource BoolToVisibility}}" />
            <TextBlock DockPanel.Dock="Right" Text="↑↓ · Enter · Esc" Style="{StaticResource Text.Caption}" />
            <TextBlock Text="{Binding StatusText}" Style="{StaticResource Text.Caption}" TextTrimming="CharacterEllipsis" />
        </DockPanel>

        <Border Style="{StaticResource Card.Surface}" Margin="0,10,0,0">
            <ListBox x:Name="List" ItemsSource="{Binding Results}" SelectedItem="{Binding Selected}" Padding="4"
                     MouseDoubleClick="OnListDoubleClick">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <DockPanel Margin="2,1">
                            <TextBlock DockPanel.Dock="Left" Text="{Binding Node, Converter={x:Static v:ExplorerIconConverter.Instance}}"
                                       Style="{StaticResource Text.Icon}" Foreground="{DynamicResource Brush.Accent}" Width="22" />
                            <TextBlock DockPanel.Dock="Right" Text="{Binding Location}" Style="{StaticResource Text.Caption}" Margin="16,0,0,0"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="260" />
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        </DockPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>
    </DockPanel>
</Window>
