<Window x:Class="JetQueries.Wpf.Views.ShortcutsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:UiKit.Controls;assembly=UiKit.Wpf"
        xmlns:res="clr-namespace:JetQueries.Presentation.Resources;assembly=JetQueries.Presentation"
        Title="{x:Static res:Strings.MenuShortcuts}" Width="620" Height="620" MinWidth="460" MinHeight="360"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Style="{StaticResource Window.App}">
    <Window.InputBindings>
        <KeyBinding Key="Escape" Command="{x:Static ApplicationCommands.Close}" />
    </Window.InputBindings>
    <Window.CommandBindings>
        <CommandBinding Command="{x:Static ApplicationCommands.Close}" Executed="OnClose" />
    </Window.CommandBindings>
    <Window.Resources>
        <!-- Shortcuts grouped under their area -->
        <CollectionViewSource x:Key="Grouped" Source="{Binding Shown}">
            <CollectionViewSource.GroupDescriptions>
                <PropertyGroupDescription PropertyName="Group" />
            </CollectionViewSource.GroupDescriptions>
        </CollectionViewSource>
    </Window.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1" Padding="16,12">
            <DockPanel>
                <Border Width="30" Height="30" CornerRadius="8" Background="{DynamicResource Brush.AccentSoft}" Margin="0,0,12,0">
                    <TextBlock Text="&#xE765;" Style="{StaticResource Text.Icon}" Foreground="{DynamicResource Brush.Accent}" />
                </Border>
                <c:SearchBox x:Name="Search" DockPanel.Dock="Right" Width="240" VerticalAlignment="Center"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" c:Ui.Placeholder="{x:Static res:Strings.ShortcutsSearch}" />
                <TextBlock Text="{x:Static res:Strings.MenuShortcuts}" Style="{StaticResource Text.Subtitle}" VerticalAlignment="Center" />
            </DockPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16,6,16,16">
            <ItemsControl x:Name="List" ItemsSource="{Binding Source={StaticResource Grouped}}" Focusable="False" Grid.IsSharedSizeScope="True">
                <ItemsControl.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.HeaderTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}" Style="{StaticResource Text.Section}" Margin="0,14,0,6" />
                            </DataTemplate>
                        </GroupStyle.HeaderTemplate>
                    </GroupStyle>
                </ItemsControl.GroupStyle>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1" Padding="2,6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="Keys" MinWidth="170" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <!-- Keys as key caps -->
                                <Border HorizontalAlignment="Left" Background="{DynamicResource Brush.Chip}" BorderBrush="{DynamicResource Brush.BorderStrong}"
                                        BorderThickness="1,1,1,2" CornerRadius="5" Padding="7,1" Margin="0,0,16,0">
                                    <TextBlock Text="{Binding Keys}" FontFamily="{DynamicResource Font.Code}" FontSize="{DynamicResource FontSize.Small}" />
                                </Border>
                                <TextBlock Grid.Column="1" Text="{Binding Description}" VerticalAlignment="Center" TextWrapping="Wrap" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</Window>
