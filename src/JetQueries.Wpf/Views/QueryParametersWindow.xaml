<Window x:Class="JetQueries.Wpf.Views.QueryParametersWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:UiKit.Controls;assembly=UiKit.Wpf"
        xmlns:res="clr-namespace:JetQueries.Presentation.Resources;assembly=JetQueries.Presentation"
        xmlns:v="clr-namespace:JetQueries.Wpf.Views"
        Title="{x:Static res:Strings.ParametersTitle}" Width="600" SizeToContent="Height" MaxHeight="640" MinWidth="460"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip"
        Style="{StaticResource Window.App}">
    <Window.Resources>
        <Style x:Key="Head" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
            <Setter Property="FontSize" Value="{DynamicResource FontSize.Small}" />
            <Setter Property="Margin" Value="0,0,10,6" />
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- Footer: cancel or run -->
        <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0" Padding="20,10"
                Background="{DynamicResource Brush.SurfaceAlt}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="{x:Static res:Strings.ButtonCancel}" IsCancel="True" MinWidth="84" Margin="0,0,8,0" />
                    <Button x:Name="RunButton" Style="{StaticResource Btn.Primary}" c:Ui.Icon="{x:Static c:Icons.Play}" Content="{x:Static res:Strings.ParametersRun}"
                            IsDefault="True" MinWidth="96" Click="OnRun" />
                </StackPanel>
                <TextBlock Text="{Binding Error}" Foreground="{DynamicResource Brush.Danger}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0" />
            </DockPanel>
        </Border>

        <StackPanel Margin="20,16,20,14">
            <TextBlock Text="{x:Static res:Strings.ParametersIntro}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,0,0,14" />
            <Grid Grid.IsSharedSizeScope="True">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="Name" MinWidth="130" />
                        <ColumnDefinition Width="140" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{x:Static res:Strings.ParameterHeaderName}" Style="{StaticResource Head}" />
                    <TextBlock Grid.Column="1" Text="{x:Static res:Strings.ParameterHeaderKind}" Style="{StaticResource Head}" />
                    <TextBlock Grid.Column="2" Text="{x:Static res:Strings.ParameterHeaderValue}" Style="{StaticResource Head}" />
                </Grid>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" MaxHeight="420">
                    <ItemsControl x:Name="Rows" ItemsSource="{Binding Items}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="Name" MinWidth="130" />
                                        <ColumnDefinition Width="140" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Label}" FontFamily="{DynamicResource Font.Code}" VerticalAlignment="Center" Margin="0,0,12,0" />
                                    <ComboBox Grid.Column="1" Height="30" Margin="0,0,10,0" SelectedValuePath="Value" DisplayMemberPath="Text"
                                              ItemsSource="{Binding DataContext.Kinds, RelativeSource={RelativeSource AncestorType=Window}}"
                                              SelectedValue="{Binding Kind}"
                                              Visibility="{Binding IsText, Converter={x:Static v:InverseBoolToVisibilityConverter.Instance}}" />
                                    <TextBlock Grid.Column="1" Text="{x:Static res:Strings.ParameterSqlText}" Style="{StaticResource Text.Caption}" VerticalAlignment="Center"
                                               Visibility="{Binding IsText, Converter={StaticResource BoolToVisibility}}" />
                                    <TextBox Grid.Column="2" Height="30" Padding="8,0" VerticalContentAlignment="Center" Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                             IsEnabled="{Binding IsValueEnabled}" FontFamily="{DynamicResource Font.Code}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </StackPanel>
    </DockPanel>
</Window>
