<Window x:Class="JetQueries.Wpf.Views.TransactionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:UiKit.Controls;assembly=UiKit.Wpf"
        xmlns:res="clr-namespace:JetQueries.Presentation.Resources;assembly=JetQueries.Presentation"
        Title="{x:Static res:Strings.TransactionAskTitle}" Width="460" SizeToContent="Height" ResizeMode="NoResize"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        Style="{StaticResource Window.App}">
    <StackPanel Margin="20,18,20,18">
        <DockPanel>
            <TextBlock DockPanel.Dock="Left" Text="{x:Static c:Icons.Warning}" Style="{StaticResource Text.Icon}" FontSize="20"
                       Foreground="{DynamicResource Brush.Warning}" VerticalAlignment="Top" Margin="0,0,12,0" />
            <TextBlock x:Name="Message" TextWrapping="Wrap" />
        </DockPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Style="{StaticResource Btn.Primary}" Content="{x:Static res:Strings.TransactionCommit}" MinWidth="88" Margin="0,0,8,0" Click="OnCommit" />
            <Button Content="{x:Static res:Strings.TransactionRollback}" MinWidth="88" Margin="0,0,8,0" Click="OnRollback" />
            <Button Content="{x:Static res:Strings.ButtonCancel}" IsCancel="True" IsDefault="True" MinWidth="88" />
        </StackPanel>
    </StackPanel>
</Window>
