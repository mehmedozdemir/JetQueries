<UserControl x:Class="JetQueries.Wpf.Views.KeyValueView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:UiKit.Controls;assembly=UiKit.Wpf"
             xmlns:res="clr-namespace:JetQueries.Presentation.Resources;assembly=JetQueries.Presentation"
             xmlns:v="clr-namespace:JetQueries.Wpf.Views">
    <UserControl.Resources>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
            <Setter Property="FontSize" Value="{DynamicResource FontSize.Small}" />
            <Setter Property="Margin" Value="1,0,0,4" />
        </Style>
    </UserControl.Resources>

    <DockPanel Margin="12,4,12,10">
        <!-- Header: type, key, where, TTL and size; refresh, rename, TTL, delete -->
        <DockPanel DockPanel.Dock="Top" Margin="0,4,0,10">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{StaticResource Btn.Toolbar.Compact}" c:Ui.Icon="{x:Static c:Icons.Refresh}" Content="{x:Static res:Strings.KeyRefresh}"
                        Command="{Binding RefreshCommand}" Margin="0,0,4,0" />
                <Button Style="{StaticResource Btn.Toolbar.Compact}" c:Ui.Icon="{x:Static c:Icons.Edit}" Content="{x:Static res:Strings.KeyRenameButton}"
                        Command="{Binding RenameCommand}" Margin="0,0,4,0" />
                <Button Style="{StaticResource Btn.Toolbar.Compact}" c:Ui.Icon="&#xE916;" Content="{x:Static res:Strings.KeyTtlButton}"
                        Command="{Binding SetTimeToLiveCommand}" Margin="0,0,4,0" />
                <Button x:Name="DeleteKeyButton" Style="{StaticResource Btn.Toolbar.Compact}" c:Ui.Icon="{x:Static c:Icons.Delete}" Content="{x:Static res:Strings.KeyDeleteButton}"
                        Command="{Binding DeleteCommand}" />
            </StackPanel>
            <Border Style="{StaticResource Badge}" Margin="0,0,10,0" VerticalAlignment="Center"
                    Visibility="{Binding Exists, Converter={StaticResource BoolToVisibility}}">
                <TextBlock x:Name="TypeText" Text="{Binding TypeText}" FontFamily="{DynamicResource Font.Code}" FontSize="{DynamicResource FontSize.Small}"
                           Foreground="{DynamicResource Brush.Accent}" />
            </Border>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{Binding Key}" Style="{StaticResource Text.Subtitle}" FontFamily="{DynamicResource Font.Code}" TextTrimming="CharacterEllipsis" />
                <TextBlock Style="{StaticResource Text.Caption}" Margin="0,2,0,0">
                    <Run Text="{Binding Location, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{Binding TtlText, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{Binding SizeText, Mode=OneWay}" />
                </TextBlock>
            </StackPanel>
        </DockPanel>

        <!-- Footer: what was done, or why not -->
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
            <v:Spinner Style="{StaticResource Spinner}" Margin="0,0,8,0" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
            <TextBlock x:Name="StatusText" Text="{Binding Status}" Style="{StaticResource Text.Status}" TextWrapping="Wrap" />
            <TextBlock Text="{x:Static res:Strings.KeyReadOnly}" Style="{StaticResource Text.Status}" Margin="12,0,0,0"
                       Visibility="{Binding IsReadOnly, Converter={StaticResource BoolToVisibility}}" />
        </StackPanel>

        <Grid>
            <!-- A string: its text -->
            <DockPanel Visibility="{Binding IsText, Converter={StaticResource BoolToVisibility}}">
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                    <Button Content="{x:Static res:Strings.KeyFormatJson}" c:Ui.Icon="{x:Static c:Icons.Code}" Command="{Binding FormatJsonCommand}" Margin="0,0,8,0" />
                    <Button Style="{StaticResource Btn.Primary}" c:Ui.Icon="{x:Static c:Icons.Save}" Content="{x:Static res:Strings.KeySaveText}"
                            Command="{Binding SaveTextCommand}" MinWidth="96" />
                </StackPanel>
                <Border Style="{StaticResource Card.Surface}">
                    <TextBox x:Name="TextBox" Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" AcceptsTab="True" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" BorderThickness="0" Padding="10,8"
                             FontFamily="{DynamicResource Font.Code}" Background="Transparent" IsReadOnly="{Binding IsReadOnly}" />
                </Border>
            </DockPanel>

            <!-- A collection: its items, and the selected one in an editor -->
            <Grid Visibility="{Binding IsCollection, Converter={StaticResource BoolToVisibility}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*" MinWidth="260" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="2*" MinWidth="240" />
                </Grid.ColumnDefinitions>
                <DockPanel>
                    <TextBlock DockPanel.Dock="Bottom" Text="{Binding TruncatedText}" Style="{StaticResource Text.Caption}" Margin="2,6,0,0"
                               Visibility="{Binding TruncatedText, Converter={x:Static v:NotNullToVisibilityConverter.Instance}}" />
                    <Border Style="{StaticResource Card.Surface}">
                        <c:VirtualGrid x:Name="ItemsGrid" NullText="" ShowTypeTags="False" ShowFilterButtons="False" />
                    </Border>
                </DockPanel>
                <GridSplitter Grid.Column="1" Width="10" HorizontalAlignment="Stretch" Background="Transparent" />
                <Border Grid.Column="2" Style="{StaticResource Card.Surface}" Padding="12,10">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="{x:Static res:Strings.KeyItemEditor}" Style="{StaticResource Text.Subtitle}" Margin="0,0,0,10" />
                        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                            <Button Style="{StaticResource Btn.Icon}" c:Ui.Icon="{x:Static c:Icons.Delete}" Command="{Binding RemoveItemCommand}"
                                    ToolTip="{x:Static res:Strings.KeyRemove}" Margin="0,0,8,0" />
                            <Button c:Ui.Icon="{x:Static c:Icons.Add}" Content="{x:Static res:Strings.KeyAdd}" Command="{Binding AddItemCommand}" Margin="0,0,8,0" />
                            <Button Style="{StaticResource Btn.Primary}" c:Ui.Icon="{x:Static c:Icons.Save}" Content="{x:Static res:Strings.KeySaveItem}"
                                    Command="{Binding SaveItemCommand}" />
                        </StackPanel>
                        <StackPanel DockPanel.Dock="Top" Visibility="{Binding HasNames, Converter={StaticResource BoolToVisibility}}" Margin="0,0,0,10">
                            <TextBlock Text="{Binding NameHeader}" Style="{StaticResource Label}" />
                            <TextBox Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding CanEditNames, Converter={x:Static v:NotConverter.Instance}}"
                                     FontFamily="{DynamicResource Font.Code}" />
                        </StackPanel>
                        <StackPanel DockPanel.Dock="Top" Visibility="{Binding HasScores, Converter={StaticResource BoolToVisibility}}" Margin="0,0,0,10">
                            <TextBlock Text="{x:Static res:Strings.KeyScore}" Style="{StaticResource Label}" />
                            <TextBox Text="{Binding EditScore, UpdateSourceTrigger=PropertyChanged}" FontFamily="{DynamicResource Font.Code}" IsReadOnly="{Binding IsReadOnly}" />
                        </StackPanel>
                        <TextBlock DockPanel.Dock="Top" Text="{Binding ValueHeader}" Style="{StaticResource Label}" />
                        <TextBox x:Name="ItemValueBox" Text="{Binding EditValue, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" Padding="8,6" FontFamily="{DynamicResource Font.Code}"
                                 IsReadOnly="{Binding IsReadOnly}" />
                    </DockPanel>
                </Border>
            </Grid>

            <!-- The key is gone -->
            <TextBlock Text="{x:Static res:Strings.KeyGone}" Foreground="{DynamicResource Brush.TextSecondary}" HorizontalAlignment="Center" VerticalAlignment="Center"
                       Visibility="{Binding Exists, Converter={x:Static v:InverseBoolToVisibilityConverter.Instance}}" />
        </Grid>
    </DockPanel>
</UserControl>
