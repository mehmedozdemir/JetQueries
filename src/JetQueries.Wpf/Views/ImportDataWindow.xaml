<Window x:Class="JetQueries.Wpf.Views.ImportDataWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:UiKit.Controls;assembly=UiKit.Wpf"
        xmlns:res="clr-namespace:JetQueries.Presentation.Resources;assembly=JetQueries.Presentation"
        xmlns:v="clr-namespace:JetQueries.Wpf.Views"
        Title="{x:Static res:Strings.ImportDialogTitle}" Width="860" Height="700" MinWidth="680" MinHeight="520"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        Style="{StaticResource Window.App}">
    <Window.Resources>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
            <Setter Property="FontSize" Value="{DynamicResource FontSize.Small}" />
            <Setter Property="Margin" Value="1,0,0,4" />
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- Header: the table -->
        <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1" Padding="20,12">
            <DockPanel>
                <v:ProviderMarkView Mark="{Binding Mark}" Size="30" Margin="0,0,12,0" VerticalAlignment="Center" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Subtitle}" />
                    <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Text.Caption}" Margin="0,2,0,0" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Footer: what happened, cancel, import, close -->
        <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0" Padding="20,10"
                Background="{DynamicResource Brush.SurfaceAlt}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="{x:Static res:Strings.ButtonCancel}" Command="{Binding CancelCommand}" MinWidth="84" Margin="0,0,8,0"
                            Visibility="{Binding IsImporting, Converter={StaticResource BoolToVisibility}}" />
                    <Button Content="{x:Static res:Strings.ImportClose}" IsCancel="True" MinWidth="84" Margin="0,0,8,0" />
                    <Button x:Name="ImportButton" Style="{StaticResource Btn.Primary}" Content="{x:Static res:Strings.ImportButton}" Command="{Binding ImportCommand}"
                            MinWidth="96" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <ProgressBar IsIndeterminate="True" Width="48" Margin="0,0,10,0" VerticalAlignment="Center"
                                 Visibility="{Binding IsImporting, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock x:Name="ProgressText" Style="{StaticResource Text.Status}" Margin="0,0,10,0"
                               Visibility="{Binding IsImporting, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock x:Name="StatusText" Text="{Binding Status}" TextWrapping="Wrap" MaxWidth="520" VerticalAlignment="Center" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Margin="20,14,20,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- The file -->
            <StackPanel>
                <TextBlock Text="{x:Static res:Strings.ImportFile}" Style="{StaticResource Label}" />
                <DockPanel Margin="0,0,0,10">
                    <Button DockPanel.Dock="Right" Margin="8,0,0,0" Content="{x:Static res:Strings.Browse}" Click="OnBrowse" />
                    <TextBox x:Name="FileBox" Text="{Binding FilePath, UpdateSourceTrigger=LostFocus}" />
                </DockPanel>
            </StackPanel>

            <!-- How to read it -->
            <WrapPanel Grid.Row="1" Margin="0,0,0,8">
                <StackPanel Margin="0,0,16,6">
                    <TextBlock Text="{x:Static res:Strings.ImportEncoding}" Style="{StaticResource Label}" />
                    <ComboBox Width="190" ItemsSource="{Binding Encodings}" SelectedItem="{Binding SelectedEncoding}" DisplayMemberPath="Text" />
                </StackPanel>
                <StackPanel Margin="0,0,16,6">
                    <TextBlock Text="{x:Static res:Strings.ImportDelimiter}" Style="{StaticResource Label}" />
                    <ComboBox Width="130" ItemsSource="{Binding Delimiters}" SelectedItem="{Binding SelectedDelimiter}" DisplayMemberPath="Text" />
                </StackPanel>
                <StackPanel VerticalAlignment="Bottom" Margin="0,0,0,6">
                    <CheckBox Content="{x:Static res:Strings.ImportHeader}" IsChecked="{Binding HasHeader}" Margin="0,0,0,4" />
                    <CheckBox Content="{x:Static res:Strings.ImportEmptyIsNull}" IsChecked="{Binding EmptyIsNull}" />
                </StackPanel>
                <CheckBox Content="{x:Static res:Strings.ImportTransaction}" IsChecked="{Binding UseTransaction}" VerticalAlignment="Bottom" Margin="20,0,0,10" />
            </WrapPanel>

            <!-- The file's first rows -->
            <DockPanel Grid.Row="2">
                <TextBlock DockPanel.Dock="Top" Text="{x:Static res:Strings.ImportPreview}" Style="{StaticResource Label}" />
                <Border Style="{StaticResource Card.Surface}">
                    <c:VirtualGrid x:Name="PreviewGrid" NullText="" ShowTypeTags="False" ShowFilterButtons="False" />
                </Border>
            </DockPanel>

            <TextBlock Grid.Row="3" Text="{x:Static res:Strings.ImportMapping}" Style="{StaticResource Label}" Margin="1,12,0,6" />

            <!-- Which file column fills which table column -->
            <Border Grid.Row="4" Style="{StaticResource Card.Surface}" Padding="10,8">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="MappingRows" ItemsSource="{Binding Mappings}" Focusable="False" Grid.IsSharedSizeScope="True">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="Column" MinWidth="160" />
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="Type" MinWidth="150" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Name}" FontFamily="{DynamicResource Font.Code}" VerticalAlignment="Center" Margin="0,0,12,0" />
                                    <TextBlock Grid.Column="1" Text="{Binding DataType}" Foreground="{DynamicResource Brush.TextSecondary}" VerticalAlignment="Center" Margin="0,0,12,0" />
                                    <TextBlock Grid.Column="2" Text="←" Foreground="{DynamicResource Brush.TextMuted}" VerticalAlignment="Center" Margin="0,0,12,0" />
                                    <ComboBox Grid.Column="3" ItemsSource="{Binding DataContext.Sources, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                              SelectedItem="{Binding Source}" DisplayMemberPath="Text" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>
        </Grid>
    </DockPanel>
</Window>
