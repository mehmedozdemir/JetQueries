<Window x:Class="JetQueries.Wpf.Views.ConnectionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:UiKit.Controls;assembly=UiKit.Wpf"
        xmlns:res="clr-namespace:JetQueries.Presentation.Resources;assembly=JetQueries.Presentation"
        xmlns:v="clr-namespace:JetQueries.Wpf.Views"
        Title="{Binding Title}" Width="660" SizeToContent="Height" ResizeMode="NoResize"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        Style="{StaticResource Window.App}">
    <Window.Resources>
        <Style x:Key="Field" TargetType="Grid">
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
    </Window.Resources>

    <Grid>
        <!-- Step 1: the database type -->
        <DockPanel Margin="22,20,22,18" Visibility="{Binding IsChoosingType, Converter={StaticResource BoolToVisibility}}">
            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16">
                <TextBlock Text="{x:Static res:Strings.ConnectionChooseTypeTitle}" Style="{StaticResource Text.Subtitle}" />
                <TextBlock Text="{x:Static res:Strings.ConnectionChooseTypeInfo}" Foreground="{DynamicResource Brush.TextSecondary}"
                           TextWrapping="Wrap" Margin="0,4,0,0" />
            </StackPanel>
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                <Button Content="{x:Static res:Strings.ButtonCancel}" Command="{Binding CancelCommand}" IsCancel="True" MinWidth="88" />
            </StackPanel>
            <ItemsControl x:Name="TypeList" ItemsSource="{Binding Providers}" Focusable="False" Margin="0,0,-10,0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="2" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Style="{StaticResource TypeCard}" AutomationProperties.Name="{Binding DisplayName}"
                                Command="{Binding DataContext.ChooseTypeCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                CommandParameter="{Binding}">
                            <DockPanel>
                                <v:ProviderMarkView DockPanel.Dock="Left" Mark="{Binding Mark}" Size="40" Margin="0,0,14,0" VerticalAlignment="Center" />
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="{DynamicResource FontSize.Subtitle}" />
                                    <TextBlock Text="{Binding Description}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                </StackPanel>
                            </DockPanel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </DockPanel>

        <!-- Step 2: the details of the chosen type -->
        <DockPanel Margin="22,18,22,18" Visibility="{Binding IsEditingSettings, Converter={StaticResource BoolToVisibility}}">
            <!-- The type, a way back to the list, and form / connection string -->
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,16">
                <Border DockPanel.Dock="Right" Style="{StaticResource Segmented.Frame}" VerticalAlignment="Center"
                        Visibility="{Binding SelectedProvider.ReadsConnectionStrings, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Style="{StaticResource SegmentRadio}" GroupName="EditorMode" Content="{x:Static res:Strings.ConnectionModeForm}"
                                     IsChecked="{Binding IsFormMode}" />
                        <RadioButton x:Name="StringMode" Style="{StaticResource SegmentRadio}" GroupName="EditorMode"
                                     Content="{x:Static res:Strings.ConnectionModeString}" IsChecked="{Binding IsConnectionStringMode}" />
                    </StackPanel>
                </Border>
                <v:ProviderMarkView DockPanel.Dock="Left" Mark="{Binding SelectedProvider.Mark}" Size="34" Margin="0,0,12,0" VerticalAlignment="Center" />
                <StackPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding SelectedProvider.DisplayName}" Style="{StaticResource Text.Subtitle}" />
                        <Button Style="{StaticResource Btn.Link}" Content="{x:Static res:Strings.ConnectionChangeType}" Command="{Binding ChangeTypeCommand}"
                                Margin="10,0,0,0" VerticalAlignment="Center"
                                Visibility="{Binding CanChangeType, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                    <TextBlock Text="{Binding SelectedProvider.Description}" Style="{StaticResource Text.Caption}" />
                </StackPanel>
            </DockPanel>

            <!-- Buttons -->
            <DockPanel DockPanel.Dock="Bottom" Margin="0,16,0,0">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="{x:Static res:Strings.ButtonCancel}" Command="{Binding CancelCommand}" IsCancel="True" MinWidth="88" Margin="0,0,8,0" />
                    <Button Style="{StaticResource Btn.Primary}" Content="{x:Static res:Strings.ButtonSave}" Command="{Binding SaveCommand}" IsDefault="True" MinWidth="88"
                            Visibility="{Binding IsFormMode, Converter={StaticResource BoolToVisibility}}" />
                    <Button Style="{StaticResource Btn.Primary}" Content="{x:Static res:Strings.ConnectionStringApply}" Command="{Binding ApplyConnectionStringCommand}"
                            IsDefault="True" MinWidth="88"
                            Visibility="{Binding IsConnectionStringMode, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Visibility="{Binding IsFormMode, Converter={StaticResource BoolToVisibility}}">
                    <Button Content="{x:Static res:Strings.ButtonTest}" Command="{Binding TestCommand}" c:Ui.Icon="{x:Static c:Icons.Plug}" />
                    <Button Style="{StaticResource Btn.Link}" Content="{x:Static res:Strings.ButtonCancelTest}" Command="{Binding StopTestCommand}" Margin="8,0,0,0"
                            Visibility="{Binding IsTesting, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
            </DockPanel>

            <!-- Messages -->
            <StackPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
                <ProgressBar IsIndeterminate="{Binding IsTesting}" Margin="0,0,0,8" Visibility="{Binding IsTesting, Converter={StaticResource BoolToVisibility}}" />
                <TextBlock Text="{Binding ValidationMessage}" Foreground="{DynamicResource Brush.Danger}" TextWrapping="Wrap"
                           Visibility="{Binding ValidationMessage, Converter={x:Static v:NotNullToVisibilityConverter.Instance}}" />
                <TextBlock x:Name="TestResult" Text="{Binding TestMessage}" TextWrapping="Wrap" Foreground="{DynamicResource Brush.Success}"
                           Visibility="{Binding TestMessage, Converter={x:Static v:NotNullToVisibilityConverter.Instance}}" />
            </StackPanel>

            <Grid>
                <!-- Connection string -->
                <StackPanel Visibility="{Binding IsConnectionStringMode, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{x:Static res:Strings.ConnectionStringInfo}" Foreground="{DynamicResource Brush.TextSecondary}" TextWrapping="Wrap" Margin="0,0,0,10" />
                    <TextBox x:Name="ConnectionStringInput" Text="{Binding ConnectionString, UpdateSourceTrigger=PropertyChanged}"
                             AcceptsReturn="False" TextWrapping="Wrap" Height="110" VerticalContentAlignment="Top" Padding="8,6"
                             FontFamily="Cascadia Mono, Consolas" VerticalScrollBarVisibility="Auto"
                             c:Ui.Placeholder="Server=…;Database=…;User Id=…;Password=…" />
                    <TextBlock Text="{Binding ConnectionStringMessage}" Foreground="{DynamicResource Brush.Danger}" TextWrapping="Wrap" Margin="0,8,0,0"
                               Visibility="{Binding ConnectionStringFailed, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>

                <!-- Details -->
                <StackPanel Visibility="{Binding IsFormMode, Converter={StaticResource BoolToVisibility}}">
                    <Border Background="{DynamicResource Brush.AccentSoft}" CornerRadius="{StaticResource Radius.Control}" Padding="10,7" Margin="0,0,0,12"
                            Visibility="{Binding ConnectionStringMessage, Converter={x:Static v:NotNullToVisibilityConverter.Instance}}">
                        <TextBlock Text="{Binding ConnectionStringMessage}" TextWrapping="Wrap" />
                    </Border>

                    <Grid Style="{StaticResource Field}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{x:Static res:Strings.FieldName}" Style="{StaticResource Text.FieldLabel}" />
                        <TextBox x:Name="NameInput" Grid.Column="1" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                    </Grid>

                    <TextBlock Text="{x:Static res:Strings.SectionConnection}" Style="{StaticResource Text.Section}" Margin="0,8,0,6" />

                    <!-- Settings defined by the chosen provider -->
                    <ItemsControl ItemsSource="{Binding Fields}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Style="{StaticResource Field}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="170" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Label}" Style="{StaticResource Text.FieldLabel}" VerticalAlignment="Top" Margin="0,7,0,0" />
                                    <StackPanel Grid.Column="1">
                                        <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                                 Visibility="{Binding IsText, Converter={StaticResource BoolToVisibility}}" />
                                        <DockPanel Visibility="{Binding IsFilePath, Converter={StaticResource BoolToVisibility}}">
                                            <Button DockPanel.Dock="Right" Margin="8,0,0,0" Content="{x:Static res:Strings.Browse}" Click="OnBrowseClick" />
                                            <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" />
                                        </DockPanel>
                                        <ComboBox ItemsSource="{Binding Options}" SelectedItem="{Binding SelectedOption}" DisplayMemberPath="DisplayName"
                                                  Visibility="{Binding IsChoice, Converter={StaticResource BoolToVisibility}}" />
                                        <CheckBox IsChecked="{Binding BooleanValue}" Margin="0,6,0,0"
                                                  Visibility="{Binding IsBoolean, Converter={StaticResource BoolToVisibility}}" />
                                        <TextBlock Text="{Binding Hint}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,3,0,0"
                                                   Visibility="{Binding Hint, Converter={x:Static v:NotNullToVisibilityConverter.Instance}}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Credential -->
                    <StackPanel Visibility="{Binding NeedsCredential, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="{x:Static res:Strings.SectionCredential}" Style="{StaticResource Text.Section}" Margin="0,8,0,6" />
                        <Grid Style="{StaticResource Field}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="170" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{x:Static res:Strings.FieldUserName}" Style="{StaticResource Text.FieldLabel}" />
                            <TextBox Grid.Column="1" Text="{Binding UserName, UpdateSourceTrigger=PropertyChanged}" />
                        </Grid>
                        <Grid Style="{StaticResource Field}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="170" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{x:Static res:Strings.FieldPassword}" Style="{StaticResource Text.FieldLabel}" VerticalAlignment="Top" Margin="0,7,0,0" />
                            <StackPanel Grid.Column="1">
                                <PasswordBox x:Name="PasswordInput" PasswordChanged="OnPasswordChanged" />
                                <TextBlock Text="{Binding PasswordHint}" Style="{StaticResource Text.Caption}" Margin="0,3,0,0"
                                           Visibility="{Binding PasswordHint, Converter={x:Static v:NotNullToVisibilityConverter.Instance}}" />
                                <CheckBox Content="{x:Static res:Strings.FieldSavePassword}" IsChecked="{Binding SavePassword}" Margin="0,8,0,0" />
                                <TextBlock Text="{x:Static res:Strings.PasswordNotPersistentHint}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,3,0,0"
                                           Visibility="{Binding CanPersistPasswords, Converter={x:Static v:InverseBoolToVisibilityConverter.Instance}}" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <!-- Organisation and safety -->
                    <TextBlock Text="{x:Static res:Strings.SectionOrganisation}" Style="{StaticResource Text.Section}" Margin="0,8,0,6" />
                    <Grid Style="{StaticResource Field}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{x:Static res:Strings.FieldFolder}" Style="{StaticResource Text.FieldLabel}" />
                        <TextBox Grid.Column="1" Text="{Binding Folder, UpdateSourceTrigger=PropertyChanged}" c:Ui.Placeholder="{x:Static res:Strings.FieldFolderHint}" />
                    </Grid>
                    <Grid Style="{StaticResource Field}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{x:Static res:Strings.FieldEnvironment}" Style="{StaticResource Text.FieldLabel}" />
                        <ComboBox Grid.Column="1" ItemsSource="{Binding Environments}" SelectedItem="{Binding SelectedEnvironment}" DisplayMemberPath="DisplayName" />
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <CheckBox Grid.Column="1" Content="{x:Static res:Strings.FieldReadOnly}" IsChecked="{Binding IsReadOnly}" />
                    </Grid>
                </StackPanel>
            </Grid>
        </DockPanel>
    </Grid>
</Window>
