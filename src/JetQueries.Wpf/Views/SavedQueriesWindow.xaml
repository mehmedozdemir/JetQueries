<Window x:Class="JetQueries.Wpf.Views.SavedQueriesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:UiKit.Controls;assembly=UiKit.Wpf"
        xmlns:res="clr-namespace:JetQueries.Presentation.Resources;assembly=JetQueries.Presentation"
        xmlns:e="clr-namespace:JetQueries.Wpf.Editor"
        xmlns:v="clr-namespace:JetQueries.Wpf.Views"
        Title="{x:Static res:Strings.SavedQueriesTitle}" Width="1120" Height="660" MinWidth="820" MinHeight="420"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Style="{StaticResource Window.App}">
    <Window.InputBindings>
        <KeyBinding Key="Escape" Command="{x:Static ApplicationCommands.Close}" />
    </Window.InputBindings>
    <Window.CommandBindings>
        <CommandBinding Command="{x:Static ApplicationCommands.Close}" Executed="OnClose" />
    </Window.CommandBindings>
    <Window.Resources>
        <CollectionViewSource x:Key="Grouped" Source="{Binding Items}">
            <CollectionViewSource.GroupDescriptions>
                <PropertyGroupDescription PropertyName="Folder" />
            </CollectionViewSource.GroupDescriptions>
        </CollectionViewSource>
    </Window.Resources>

    <DockPanel>
        <!-- Header: title and search -->
        <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1" Padding="16,12">
            <DockPanel>
                <Border Width="30" Height="30" CornerRadius="8" Background="{DynamicResource Brush.AccentSoft}" Margin="0,0,12,0">
                    <TextBlock Text="&#xE734;" Style="{StaticResource Text.Icon}" Foreground="{DynamicResource Brush.Accent}" />
                </Border>
                <c:SearchBox x:Name="Search" DockPanel.Dock="Right" Width="300" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=150}"
                             c:Ui.Placeholder="{x:Static res:Strings.SavedQueriesSearch}" VerticalAlignment="Center" />
                <TextBlock Text="{x:Static res:Strings.SavedQueriesTitle}" Style="{StaticResource Text.Subtitle}" VerticalAlignment="Center" />
            </DockPanel>
        </Border>

        <Grid Margin="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="5*" MinWidth="260" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="6*" MinWidth="260" />
            </Grid.ColumnDefinitions>

            <!-- The queries, by folder -->
            <Border Style="{StaticResource Card.Surface}">
                <Grid>
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="20"
                                Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="&#xE734;" Style="{StaticResource Text.Icon}" FontSize="26" Foreground="{DynamicResource Brush.TextMuted}" />
                        <TextBlock Text="{x:Static res:Strings.SavedQueriesEmpty}" Foreground="{DynamicResource Brush.TextSecondary}"
                                   TextWrapping="Wrap" TextAlignment="Center" Margin="0,12,0,0" MaxWidth="300" />
                    </StackPanel>
                    <TextBlock Text="{x:Static res:Strings.SavedQueriesNoMatch}" Foreground="{DynamicResource Brush.TextSecondary}" Margin="20"
                               HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap"
                               Visibility="{Binding IsFilteredEmpty, Converter={StaticResource BoolToVisibility}}" />
                    <ListBox x:Name="List" ItemsSource="{Binding Source={StaticResource Grouped}}" SelectedItem="{Binding Selected}" BorderThickness="0"
                             Background="Transparent" Padding="4" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             MouseDoubleClick="OnListDoubleClick" KeyDown="OnListKeyDown"
                             Visibility="{Binding IsEmpty, Converter={x:Static v:InverseBoolToVisibilityConverter.Instance}}">
                        <ListBox.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="6,8,0,4">
                                            <TextBlock Text="&#xE8B7;" Style="{StaticResource Text.Icon}" FontSize="12" Foreground="{DynamicResource Brush.TextMuted}" Margin="0,0,6,0" />
                                            <TextBlock Text="{Binding Name}" Style="{StaticResource Text.Caption}" FontWeight="SemiBold" />
                                        </StackPanel>
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                            </GroupStyle>
                        </ListBox.GroupStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="2,2" ToolTip="{Binding ToolTip}">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Text="{x:Static c:Icons.Edit}" Style="{StaticResource Text.Icon}" FontSize="11" Margin="8,0,0,0"
                                                   Foreground="{DynamicResource Brush.Accent}" ToolTip="{x:Static res:Strings.SavedQueryHasParameters}"
                                                   Visibility="{Binding HasParameters, Converter={StaticResource BoolToVisibility}}" />
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    </DockPanel>
                                    <TextBlock Text="{Binding Summary}" FontFamily="{DynamicResource Font.Code}" FontSize="{DynamicResource FontSize.Small}"
                                               Foreground="{DynamicResource Brush.TextSecondary}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                                    <TextBlock Text="{Binding Detail}" Style="{StaticResource Text.Caption}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1" Width="10" HorizontalAlignment="Stretch" Background="Transparent" />

            <!-- The selected query: name, description, text, actions -->
            <DockPanel Grid.Column="2">
                <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                    <Button x:Name="RunButton" DockPanel.Dock="Right" Style="{StaticResource Btn.Primary}" c:Ui.Icon="{x:Static c:Icons.Play}"
                            Content="{x:Static res:Strings.SavedQueryRun}" Command="{Binding RunSelectedCommand}" />
                    <Button DockPanel.Dock="Right" Style="{StaticResource Btn.Secondary}" c:Ui.Icon="{x:Static c:Icons.OpenFile}" Margin="0,0,8,0"
                            Content="{x:Static res:Strings.SavedQueryOpen}" Command="{Binding OpenSelectedCommand}" />
                    <Button DockPanel.Dock="Right" Style="{StaticResource Btn.Secondary}" c:Ui.Icon="{x:Static c:Icons.Edit}" Margin="0,0,8,0"
                            Content="{x:Static res:Strings.SavedQueryEdit}" Command="{Binding EditSelectedCommand}" />
                    <Button Style="{StaticResource Btn.Icon}" c:Ui.Icon="{x:Static c:Icons.Delete}" Command="{Binding DeleteSelectedCommand}"
                            ToolTip="{x:Static res:Strings.SavedQueryDeleteTitle}" HorizontalAlignment="Left" />
                </DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="2,0,0,8" Visibility="{Binding Selected, Converter={x:Static v:NotNullToVisibilityConverter.Instance}}">
                    <TextBlock Text="{Binding Selected.Name}" Style="{StaticResource Text.Subtitle}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Selected.Query.Description}" Foreground="{DynamicResource Brush.TextSecondary}" TextWrapping="Wrap" Margin="0,4,0,0" />
                    <TextBlock Text="{Binding Selected.Detail}" Style="{StaticResource Text.Caption}" Margin="0,4,0,0" />
                </StackPanel>
                <Border Style="{StaticResource Card.Surface}">
                    <e:SqlEditor x:Name="Preview" Margin="4,6,4,4" IsReadOnly="True" />
                </Border>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
