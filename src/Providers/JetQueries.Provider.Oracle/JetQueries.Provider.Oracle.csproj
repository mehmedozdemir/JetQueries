<Project Sdk="Microsoft.NET.Sdk">
  <!-- Providers are extensions: they reference JetQueries.Sdk only and are loaded by the extension host. -->
  <PropertyGroup>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- CA1515: the host only instantiates public IExtension types. -->
    <NoWarn>$(NoWarn);CA1515</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Oracle.ManagedDataAccess.Core" />
  </ItemGroup>
  <ItemGroup>
    <!-- Completion engine shared between providers as source: a provider may reference nothing but the SDK. -->
    <Compile Include="..\Shared\Language\*.cs" LinkBase="Language\Shared" />
    <Compile Include="..\Shared\Connections\*.cs" LinkBase="Connections\Shared" />
    <Compile Include="..\Shared\Metadata\*.cs" LinkBase="Metadata\Shared" />
  </ItemGroup>
  <ItemGroup>
    <!-- The SDK is provided by the host at run time; an extension must not ship its own copy. -->
    <ProjectReference Include="..\..\JetQueries.Sdk\JetQueries.Sdk.csproj">
      <Private>false</Private>
      <ExcludeAssets>runtime</ExcludeAssets>
    </ProjectReference>
  </ItemGroup>
  <ItemGroup>
    <None Update="extension.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <InternalsVisibleTo Include="JetQueries.Provider.Oracle.Tests" />
    <InternalsVisibleTo Include="JetQueries.PlSql.ParseSpike" />
  </ItemGroup>
</Project>
