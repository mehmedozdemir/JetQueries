<Project Sdk="Microsoft.NET.Sdk">
  <!-- Providers are extensions: they reference JetQueries.Sdk only and are loaded by the extension host. -->
  <PropertyGroup>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- CA1515: the host only instantiates public IExtension types. -->
    <NoWarn>$(NoWarn);CA1515</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient" />
    <PackageReference Include="Microsoft.SqlServer.TransactSql.ScriptDom" />
  </ItemGroup>
  <ItemGroup>
    <!-- Completion engine shared between providers as source: a provider may reference nothing but the SDK. -->
    <Compile Include="..\Shared\Language\*.cs" LinkBase="Language\Shared" />
  </ItemGroup>
  <ItemGroup>
    <!-- The SDK is provided by the host at run time; an extension must not ship its own copy. -->
    <ProjectReference Include="..\..\JetQueries.Sdk\JetQueries.Sdk.csproj">
      <Private>false</Private>
      <ExcludeAssets>runtime</ExcludeAssets>
    </ProjectReference>
  </ItemGroup>
  <ItemGroup>
    <None Update="extension.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <InternalsVisibleTo Include="JetQueries.Provider.SqlServer.Tests" />
  </ItemGroup>
</Project>
