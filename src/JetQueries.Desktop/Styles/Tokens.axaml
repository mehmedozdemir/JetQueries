<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!--
    JetQueries design tokens. Every colour, size and font used by the UI comes from here.
    Views reference tokens with {DynamicResource Jq…}; never hard-code a colour or size in a view.
    Colour tokens are theme-dependent (Light/Dark); scale tokens are shared.
    Text/background pairs are chosen for WCAG AA contrast (>= 4.5:1).
  -->
  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Light">
      <!-- Surfaces -->
      <SolidColorBrush x:Key="JqAppBackgroundBrush" Color="#F4F5F8" />
      <SolidColorBrush x:Key="JqSurfaceBrush" Color="#FFFFFF" />
      <SolidColorBrush x:Key="JqPanelBrush" Color="#ECEEF2" />
      <SolidColorBrush x:Key="JqPanelHeaderBrush" Color="#E4E7EC" />
      <SolidColorBrush x:Key="JqHoverBrush" Color="#0F000000" />
      <SolidColorBrush x:Key="JqBorderBrush" Color="#D5D9E0" />
      <!-- Text -->
      <SolidColorBrush x:Key="JqTextPrimaryBrush" Color="#1B1F24" />
      <SolidColorBrush x:Key="JqTextSecondaryBrush" Color="#566170" />
      <!-- Accent and status -->
      <SolidColorBrush x:Key="JqAccentBrush" Color="#1F5FD6" />
      <SolidColorBrush x:Key="JqAccentSoftBrush" Color="#E1EAFC" />
      <SolidColorBrush x:Key="JqSuccessBrush" Color="#1E7F4F" />
      <SolidColorBrush x:Key="JqWarningBrush" Color="#9A5B00" />
      <SolidColorBrush x:Key="JqDangerBrush" Color="#C62828" />
    </ResourceDictionary>
    <ResourceDictionary x:Key="Dark">
      <SolidColorBrush x:Key="JqAppBackgroundBrush" Color="#14161A" />
      <SolidColorBrush x:Key="JqSurfaceBrush" Color="#1C1F24" />
      <SolidColorBrush x:Key="JqPanelBrush" Color="#181A1F" />
      <SolidColorBrush x:Key="JqPanelHeaderBrush" Color="#21242A" />
      <SolidColorBrush x:Key="JqHoverBrush" Color="#14FFFFFF" />
      <SolidColorBrush x:Key="JqBorderBrush" Color="#2E333B" />
      <SolidColorBrush x:Key="JqTextPrimaryBrush" Color="#E4E7EB" />
      <SolidColorBrush x:Key="JqTextSecondaryBrush" Color="#9AA3AF" />
      <SolidColorBrush x:Key="JqAccentBrush" Color="#6298F5" />
      <SolidColorBrush x:Key="JqAccentSoftBrush" Color="#1C2C4A" />
      <SolidColorBrush x:Key="JqSuccessBrush" Color="#6DD49C" />
      <SolidColorBrush x:Key="JqWarningBrush" Color="#F6C453" />
      <SolidColorBrush x:Key="JqDangerBrush" Color="#F28B82" />
    </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>

  <!-- Typography -->
  <FontFamily x:Key="JqFontMono">Cascadia Code, JetBrains Mono, Cascadia Mono, Consolas, Menlo, DejaVu Sans Mono, monospace</FontFamily>
  <x:Double x:Key="JqFontSizeCaption">11</x:Double>
  <x:Double x:Key="JqFontSizeBody">13</x:Double>
  <x:Double x:Key="JqFontSizeTitle">15</x:Double>

  <!-- Spacing: 4 px grid -->
  <x:Double x:Key="JqSpace1">4</x:Double>
  <x:Double x:Key="JqSpace2">8</x:Double>
  <x:Double x:Key="JqSpace3">12</x:Double>
  <x:Double x:Key="JqSpace4">16</x:Double>
  <Thickness x:Key="JqPaddingCompact">8,4</Thickness>
  <Thickness x:Key="JqPaddingPanel">12,8</Thickness>

  <!-- Shape and fixed sizes -->
  <CornerRadius x:Key="JqRadiusSmall">4</CornerRadius>
  <CornerRadius x:Key="JqRadiusMedium">6</CornerRadius>
  <x:Double x:Key="JqTopBarHeight">36</x:Double>
  <x:Double x:Key="JqPanelHeaderHeight">28</x:Double>
  <x:Double x:Key="JqStatusBarHeight">24</x:Double>
</ResourceDictionary>
