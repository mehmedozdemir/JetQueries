<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:grid="clr-namespace:JetQueries.DataGrid;assembly=JetQueries.DataGrid">
  <!-- Shell-level styles built only from tokens in Tokens.axaml. -->

  <Style Selector="Window">
    <Setter Property="Background" Value="{DynamicResource JqAppBackgroundBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource JqTextPrimaryBrush}" />
    <Setter Property="FontSize" Value="{DynamicResource JqFontSizeBody}" />
  </Style>

  <Style Selector="Border.panel">
    <Setter Property="Background" Value="{DynamicResource JqPanelBrush}" />
  </Style>
  <Style Selector="Border.surface">
    <Setter Property="Background" Value="{DynamicResource JqSurfaceBrush}" />
  </Style>

  <Style Selector="Border.panel-header">
    <Setter Property="Background" Value="{DynamicResource JqPanelHeaderBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource JqBorderBrush}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="Height" Value="{DynamicResource JqPanelHeaderHeight}" />
    <Setter Property="Padding" Value="{DynamicResource JqPaddingCompact}" />
  </Style>
  <Style Selector="Border.panel-header > TextBlock">
    <Setter Property="FontSize" Value="{DynamicResource JqFontSizeCaption}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource JqTextSecondaryBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="TextBlock.placeholder">
    <Setter Property="Foreground" Value="{DynamicResource JqTextSecondaryBrush}" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="TextAlignment" Value="Center" />
    <Setter Property="Margin" Value="{DynamicResource JqPaddingPanel}" />
  </Style>

  <Style Selector="GridSplitter">
    <Setter Property="Background" Value="{DynamicResource JqBorderBrush}" />
  </Style>
  <Style Selector="GridSplitter:pointerover">
    <Setter Property="Background" Value="{DynamicResource JqAccentBrush}" />
  </Style>

  <Style Selector="Button.toolbar">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource JqTextPrimaryBrush}" />
    <Setter Property="Padding" Value="{DynamicResource JqPaddingCompact}" />
    <Setter Property="CornerRadius" Value="{DynamicResource JqRadiusSmall}" />
    <Setter Property="FontSize" Value="{DynamicResource JqFontSizeBody}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.toolbar:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource JqHoverBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource JqTextPrimaryBrush}" />
  </Style>

  <!-- Connection tree -->
  <Style Selector="Ellipse.environment">
    <Setter Property="Width" Value="8" />
    <Setter Property="Height" Value="8" />
    <Setter Property="Fill" Value="Transparent" />
    <Setter Property="Stroke" Value="{DynamicResource JqTextSecondaryBrush}" />
    <Setter Property="StrokeThickness" Value="1" />
  </Style>
  <Style Selector="Ellipse.environment.development">
    <Setter Property="Fill" Value="{DynamicResource JqSuccessBrush}" />
    <Setter Property="Stroke" Value="{DynamicResource JqSuccessBrush}" />
  </Style>
  <Style Selector="Ellipse.environment.test">
    <Setter Property="Fill" Value="{DynamicResource JqWarningBrush}" />
    <Setter Property="Stroke" Value="{DynamicResource JqWarningBrush}" />
  </Style>
  <Style Selector="Ellipse.environment.production">
    <Setter Property="Fill" Value="{DynamicResource JqDangerBrush}" />
    <Setter Property="Stroke" Value="{DynamicResource JqDangerBrush}" />
  </Style>
  <Style Selector="TextBlock.connection-name.connected">
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.connection-name.failed">
    <Setter Property="Foreground" Value="{DynamicResource JqDangerBrush}" />
  </Style>
  <Style Selector="TextBlock.badge">
    <Setter Property="FontSize" Value="{DynamicResource JqFontSizeCaption}" />
    <Setter Property="Foreground" Value="{DynamicResource JqTextSecondaryBrush}" />
  </Style>
  <Style Selector="TextBlock.badge.key">
    <Setter Property="Foreground" Value="{DynamicResource JqWarningBrush}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.object-name.container">
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.tree-message">
    <Setter Property="FontStyle" Value="Italic" />
    <Setter Property="Foreground" Value="{DynamicResource JqTextSecondaryBrush}" />
  </Style>
  <Style Selector="TextBlock.tree-message.error">
    <Setter Property="Foreground" Value="{DynamicResource JqDangerBrush}" />
  </Style>
  <Style Selector="TextBlock.test-result">
    <Setter Property="Foreground" Value="{DynamicResource JqSuccessBrush}" />
  </Style>
  <Style Selector="TextBlock.test-result.failed">
    <Setter Property="Foreground" Value="{DynamicResource JqDangerBrush}" />
  </Style>

  <Style Selector="Button.toolbar:disabled /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource JqTextSecondaryBrush}" />
    <Setter Property="Opacity" Value="0.55" />
  </Style>

  <Style Selector="grid|VirtualGrid">
    <Setter Property="Background" Value="{DynamicResource JqSurfaceBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource JqTextPrimaryBrush}" />
    <Setter Property="MutedForeground" Value="{DynamicResource JqTextSecondaryBrush}" />
    <Setter Property="HeaderBackground" Value="{DynamicResource JqPanelHeaderBrush}" />
    <Setter Property="GridLineBrush" Value="{DynamicResource JqBorderBrush}" />
    <Setter Property="SelectionBrush" Value="{DynamicResource JqAccentSoftBrush}" />
    <Setter Property="AccentBrush" Value="{DynamicResource JqAccentBrush}" />
    <Setter Property="TextElement.FontSize" Value="12" />
  </Style>
</Styles>
