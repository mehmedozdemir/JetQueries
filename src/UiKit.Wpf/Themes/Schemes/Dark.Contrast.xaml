<!-- UiKit colour scheme Dark.Contrast: laid over Themes/Dark.xaml; only the tokens it changes. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="Color.Window">#FF000000</Color>
    <SolidColorBrush x:Key="Brush.Window" Color="#FF000000" />
    <Color x:Key="Color.Surface">#FF0A0A0A</Color>
    <SolidColorBrush x:Key="Brush.Surface" Color="#FF0A0A0A" />
    <Color x:Key="Color.SurfaceAlt">#FF111111</Color>
    <SolidColorBrush x:Key="Brush.SurfaceAlt" Color="#FF111111" />
    <Color x:Key="Color.Header">#FF161616</Color>
    <SolidColorBrush x:Key="Brush.Header" Color="#FF161616" />
    <Color x:Key="Color.Card">#FF121212</Color>
    <SolidColorBrush x:Key="Brush.Card" Color="#FF121212" />
    <Color x:Key="Color.Input">#FF050505</Color>
    <SolidColorBrush x:Key="Brush.Input" Color="#FF050505" />
    <Color x:Key="Color.Chip">#FF1E1E1E</Color>
    <SolidColorBrush x:Key="Brush.Chip" Color="#FF1E1E1E" />
    <Color x:Key="Color.Border">#FF3D3D3D</Color>
    <SolidColorBrush x:Key="Brush.Border" Color="#FF3D3D3D" />
    <Color x:Key="Color.BorderStrong">#FF5C5C5C</Color>
    <SolidColorBrush x:Key="Brush.BorderStrong" Color="#FF5C5C5C" />
    <Color x:Key="Color.GridLine">#FF2A2A2A</Color>
    <SolidColorBrush x:Key="Brush.GridLine" Color="#FF2A2A2A" />
    <Color x:Key="Color.Text">#FFFFFFFF</Color>
    <SolidColorBrush x:Key="Brush.Text" Color="#FFFFFFFF" />
    <Color x:Key="Color.TextSecondary">#FFDADADA</Color>
    <SolidColorBrush x:Key="Brush.TextSecondary" Color="#FFDADADA" />
    <Color x:Key="Color.TextMuted">#FFADADAD</Color>
    <SolidColorBrush x:Key="Brush.TextMuted" Color="#FFADADAD" />
    <Color x:Key="Color.Hover">#1FFFFFFF</Color>
    <SolidColorBrush x:Key="Brush.Hover" Color="#1FFFFFFF" />
    <Color x:Key="Color.Pressed">#33FFFFFF</Color>
    <SolidColorBrush x:Key="Brush.Pressed" Color="#33FFFFFF" />
    <Color x:Key="Color.ScrollThumb">#FF5C5C5C</Color>
    <SolidColorBrush x:Key="Brush.ScrollThumb" Color="#FF5C5C5C" />
    <Color x:Key="Color.ScrollThumbHover">#FF808080</Color>
    <SolidColorBrush x:Key="Brush.ScrollThumbHover" Color="#FF808080" />
    <Color x:Key="Color.Accent">#FF6AA8FF</Color>
    <SolidColorBrush x:Key="Brush.Accent" Color="#FF6AA8FF" />
    <Color x:Key="Color.AccentHover">#FF8DBCFF</Color>
    <SolidColorBrush x:Key="Brush.AccentHover" Color="#FF8DBCFF" />
    <Color x:Key="Color.AccentSoft">#266AA8FF</Color>
    <SolidColorBrush x:Key="Brush.AccentSoft" Color="#266AA8FF" />
    <Color x:Key="Color.Selection">#336AA8FF</Color>
    <SolidColorBrush x:Key="Brush.Selection" Color="#336AA8FF" />
    <Color x:Key="Color.SelectionBorder">#FF6AA8FF</Color>
    <SolidColorBrush x:Key="Brush.SelectionBorder" Color="#FF6AA8FF" />
    <Color x:Key="Color.Syntax.Keyword">#FF7DB4FF</Color>
    <SolidColorBrush x:Key="Brush.Syntax.Keyword" Color="#FF7DB4FF" />
    <Color x:Key="Color.Syntax.String">#FF8CF0BE</Color>
    <SolidColorBrush x:Key="Brush.Syntax.String" Color="#FF8CF0BE" />
    <Color x:Key="Color.Syntax.Number">#FFFFC27F</Color>
    <SolidColorBrush x:Key="Brush.Syntax.Number" Color="#FFFFC27F" />
    <Color x:Key="Color.Syntax.Comment">#FF9AA3B5</Color>
    <SolidColorBrush x:Key="Brush.Syntax.Comment" Color="#FF9AA3B5" />
    <Color x:Key="Color.Syntax.Function">#FFE0B5FF</Color>
    <SolidColorBrush x:Key="Brush.Syntax.Function" Color="#FFE0B5FF" />
    <Color x:Key="Color.Syntax.Type">#FF6FE8F5</Color>
    <SolidColorBrush x:Key="Brush.Syntax.Type" Color="#FF6FE8F5" />
    <Color x:Key="Color.Syntax.Identifier">#FFFFFFFF</Color>
    <SolidColorBrush x:Key="Brush.Syntax.Identifier" Color="#FFFFFFFF" />
    <Color x:Key="Color.Syntax.Operator">#FFDADADA</Color>
    <SolidColorBrush x:Key="Brush.Syntax.Operator" Color="#FFDADADA" />
</ResourceDictionary>
