<!-- UiKit colour scheme Light.Sky: laid over Themes/Light.xaml; only the tokens it changes. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="Color.Window">#FFEAF1F8</Color>
    <SolidColorBrush x:Key="Brush.Window" Color="#FFEAF1F8" />
    <Color x:Key="Color.Surface">#FFFFFFFF</Color>
    <SolidColorBrush x:Key="Brush.Surface" Color="#FFFFFFFF" />
    <Color x:Key="Color.SurfaceAlt">#FFF3F7FB</Color>
    <SolidColorBrush x:Key="Brush.SurfaceAlt" Color="#FFF3F7FB" />
    <Color x:Key="Color.Header">#FFEDF3F9</Color>
    <SolidColorBrush x:Key="Brush.Header" Color="#FFEDF3F9" />
    <Color x:Key="Color.Card">#FFFFFFFF</Color>
    <SolidColorBrush x:Key="Brush.Card" Color="#FFFFFFFF" />
    <Color x:Key="Color.Input">#FFFFFFFF</Color>
    <SolidColorBrush x:Key="Brush.Input" Color="#FFFFFFFF" />
    <Color x:Key="Color.Chip">#FFE2EBF5</Color>
    <SolidColorBrush x:Key="Brush.Chip" Color="#FFE2EBF5" />
    <Color x:Key="Color.Border">#FFD3DEEA</Color>
    <SolidColorBrush x:Key="Brush.Border" Color="#FFD3DEEA" />
    <Color x:Key="Color.BorderStrong">#FFB7C6D6</Color>
    <SolidColorBrush x:Key="Brush.BorderStrong" Color="#FFB7C6D6" />
    <Color x:Key="Color.GridLine">#FFE6EDF5</Color>
    <SolidColorBrush x:Key="Brush.GridLine" Color="#FFE6EDF5" />
    <Color x:Key="Color.Text">#FF0F1B2A</Color>
    <SolidColorBrush x:Key="Brush.Text" Color="#FF0F1B2A" />
    <Color x:Key="Color.TextSecondary">#FF3E4E63</Color>
    <SolidColorBrush x:Key="Brush.TextSecondary" Color="#FF3E4E63" />
    <Color x:Key="Color.TextMuted">#FF56667B</Color>
    <SolidColorBrush x:Key="Brush.TextMuted" Color="#FF56667B" />
    <Color x:Key="Color.Accent">#FF0A63D1</Color>
    <SolidColorBrush x:Key="Brush.Accent" Color="#FF0A63D1" />
    <Color x:Key="Color.AccentHover">#FF2F7EE0</Color>
    <SolidColorBrush x:Key="Brush.AccentHover" Color="#FF2F7EE0" />
    <Color x:Key="Color.AccentSoft">#260A63D1</Color>
    <SolidColorBrush x:Key="Brush.AccentSoft" Color="#260A63D1" />
    <Color x:Key="Color.Selection">#330A63D1</Color>
    <SolidColorBrush x:Key="Brush.Selection" Color="#330A63D1" />
    <Color x:Key="Color.SelectionBorder">#FF0A63D1</Color>
    <SolidColorBrush x:Key="Brush.SelectionBorder" Color="#FF0A63D1" />
    <Color x:Key="Color.Syntax.Keyword">#FF0A5BC4</Color>
    <SolidColorBrush x:Key="Brush.Syntax.Keyword" Color="#FF0A5BC4" />
    <Color x:Key="Color.Syntax.Identifier">#FF0F1B2A</Color>
    <SolidColorBrush x:Key="Brush.Syntax.Identifier" Color="#FF0F1B2A" />
</ResourceDictionary>
