<!-- UiKit colour scheme Light.Sand: laid over Themes/Light.xaml; only the tokens it changes. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="Color.Window">#FFF3EFE8</Color>
    <SolidColorBrush x:Key="Brush.Window" Color="#FFF3EFE8" />
    <Color x:Key="Color.Surface">#FFFFFDF8</Color>
    <SolidColorBrush x:Key="Brush.Surface" Color="#FFFFFDF8" />
    <Color x:Key="Color.SurfaceAlt">#FFF8F4EC</Color>
    <SolidColorBrush x:Key="Brush.SurfaceAlt" Color="#FFF8F4EC" />
    <Color x:Key="Color.Header">#FFF1ECE3</Color>
    <SolidColorBrush x:Key="Brush.Header" Color="#FFF1ECE3" />
    <Color x:Key="Color.Card">#FFFFFDF8</Color>
    <SolidColorBrush x:Key="Brush.Card" Color="#FFFFFDF8" />
    <Color x:Key="Color.Input">#FFFFFFFF</Color>
    <SolidColorBrush x:Key="Brush.Input" Color="#FFFFFFFF" />
    <Color x:Key="Color.Chip">#FFEAE3D7</Color>
    <SolidColorBrush x:Key="Brush.Chip" Color="#FFEAE3D7" />
    <Color x:Key="Color.Border">#FFDDD5C8</Color>
    <SolidColorBrush x:Key="Brush.Border" Color="#FFDDD5C8" />
    <Color x:Key="Color.BorderStrong">#FFC7BCAB</Color>
    <SolidColorBrush x:Key="Brush.BorderStrong" Color="#FFC7BCAB" />
    <Color x:Key="Color.GridLine">#FFEEE8DE</Color>
    <SolidColorBrush x:Key="Brush.GridLine" Color="#FFEEE8DE" />
    <Color x:Key="Color.Text">#FF1F1A14</Color>
    <SolidColorBrush x:Key="Brush.Text" Color="#FF1F1A14" />
    <Color x:Key="Color.TextSecondary">#FF4F4537</Color>
    <SolidColorBrush x:Key="Brush.TextSecondary" Color="#FF4F4537" />
    <Color x:Key="Color.TextMuted">#FF655A49</Color>
    <SolidColorBrush x:Key="Brush.TextMuted" Color="#FF655A49" />
    <Color x:Key="Color.Accent">#FFB4531B</Color>
    <SolidColorBrush x:Key="Brush.Accent" Color="#FFB4531B" />
    <Color x:Key="Color.AccentHover">#FFC96A30</Color>
    <SolidColorBrush x:Key="Brush.AccentHover" Color="#FFC96A30" />
    <Color x:Key="Color.AccentSoft">#26B4531B</Color>
    <SolidColorBrush x:Key="Brush.AccentSoft" Color="#26B4531B" />
    <Color x:Key="Color.Selection">#33B4531B</Color>
    <SolidColorBrush x:Key="Brush.Selection" Color="#33B4531B" />
    <Color x:Key="Color.SelectionBorder">#FFB4531B</Color>
    <SolidColorBrush x:Key="Brush.SelectionBorder" Color="#FFB4531B" />
    <Color x:Key="Color.Syntax.Keyword">#FFA9451A</Color>
    <SolidColorBrush x:Key="Brush.Syntax.Keyword" Color="#FFA9451A" />
    <Color x:Key="Color.Syntax.Identifier">#FF1F1A14</Color>
    <SolidColorBrush x:Key="Brush.Syntax.Identifier" Color="#FF1F1A14" />
    <Color x:Key="Color.Syntax.Comment">#FF8A7E6C</Color>
    <SolidColorBrush x:Key="Brush.Syntax.Comment" Color="#FF8A7E6C" />
</ResourceDictionary>
