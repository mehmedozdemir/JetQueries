<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Open-source repo: restore only from nuget.org so lock files are reproducible on any machine. -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
