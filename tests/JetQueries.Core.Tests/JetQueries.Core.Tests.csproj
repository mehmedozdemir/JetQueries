<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>
    <!-- CA1707: test names use underscores. CA1515: xUnit needs public test classes. -->
    <!-- xUnit1051: Enqueue's own token is under test; every await is bounded by WaitAsync(timeout, test token). -->
    <NoWarn>$(NoWarn);CA1707;CA1515;xUnit1051</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\JetQueries.Core\JetQueries.Core.csproj" />
  </ItemGroup>
</Project>
